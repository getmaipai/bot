#!/usr/sbin/nft -f
# Base Reachy egress policy. Values are substituted by configure.sh.
table inet maipai {
  set hub4 { type ipv4_addr; elements = { HUB_ADDRESS } }
  set router4 { type ipv4_addr; elements = { ROUTER_ADDRESS } }
  chain input {
    type filter hook input priority filter; policy drop;
    ct state established,related accept
    iifname "lo" accept
    ip saddr @hub4 tcp dport 22 accept
    ip saddr @hub4 accept
    ip protocol udp udp sport 67 udp dport 68 accept
    ip daddr 224.0.0.251 udp dport 5353 accept
    limit rate 5/second log prefix "maipai-input-drop "
  }
  chain output {
    type filter hook output priority filter; policy drop;
    ct state established,related accept
    oifname "lo" accept
    ip daddr @hub4 accept
    ip daddr @router4 udp dport { 53, 67 } accept comment "DNS and DHCP"
    ip daddr @router4 tcp dport 53 accept
    ip daddr 224.0.0.251 udp dport 5353 accept
    TAILNET_RULE
    udp sport 68 udp dport 67 accept
    limit rate 5/second log prefix "maipai-output-drop "
  }
}
