diff --git a/firmware/main/hal/maipai_fallback.cc b/firmware/main/hal/maipai_fallback.cc
new file mode 100644
index 0000000..4eff331
--- /dev/null
+++ b/firmware/main/hal/maipai_fallback.cc
@@ -0,0 +1,115 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+#include "maipai_fallback.h"
+
+#include <esp_log.h>
+#include <esp_timer.h>
+#include <fcntl.h>
+#include <lwip/inet.h>
+#include <lwip/netdb.h>
+#include <lwip/sockets.h>
+#include <cstdlib>
+#include <cstring>
+#include <sdkconfig.h>
+
+static const char* TAG = "MAIPAI-FALLBACK";
+
+bool maipai_url_parts(const std::string& url, std::string* host, int* port, std::string* path)
+{
+    const size_t scheme = url.find("://");
+    if (scheme == std::string::npos) {
+        return false;
+    }
+    const std::string rest = url.substr(scheme + 3);
+    const size_t slash = rest.find('/');
+    const std::string hostport = slash == std::string::npos ? rest : rest.substr(0, slash);
+    if (hostport.empty()) {
+        return false;
+    }
+    std::string h = hostport;
+    int p = url.compare(0, 3, "wss") == 0 ? 443 : 80;
+    const size_t colon = hostport.rfind(':');
+    if (colon != std::string::npos) {
+        h = hostport.substr(0, colon);
+        p = std::atoi(hostport.c_str() + colon + 1);
+    }
+    if (h.empty() || p <= 0 || p > 65535) {
+        return false;
+    }
+    if (host != nullptr) {
+        *host = h;
+    }
+    if (port != nullptr) {
+        *port = p;
+    }
+    if (path != nullptr) {
+        *path = slash == std::string::npos ? std::string() : rest.substr(slash);
+    }
+    return true;
+}
+
+bool maipai_probe_tcp(const std::string& host, int port, int timeout_ms)
+{
+    struct sockaddr_in addr;
+    memset(&addr, 0, sizeof(addr));
+    addr.sin_family = AF_INET;
+    addr.sin_port   = htons(static_cast<uint16_t>(port));
+    if (inet_pton(AF_INET, host.c_str(), &addr.sin_addr) != 1) {
+        return true;  // not an address literal (a name): do not guess, let the real connect decide
+    }
+    const int fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) {
+        return true;
+    }
+    const int flags = fcntl(fd, F_GETFL, 0);
+    fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+    bool ok = false;
+    const int rc = connect(fd, reinterpret_cast<struct sockaddr*>(&addr), sizeof(addr));
+    if (rc == 0) {
+        ok = true;
+    } else if (errno == EINPROGRESS) {
+        fd_set wset;
+        FD_ZERO(&wset);
+        FD_SET(fd, &wset);
+        struct timeval tv;
+        tv.tv_sec  = timeout_ms / 1000;
+        tv.tv_usec = (timeout_ms % 1000) * 1000;
+        if (select(fd + 1, nullptr, &wset, nullptr, &tv) > 0) {
+            int err = 0;
+            socklen_t len = sizeof(err);
+            ok = getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &len) == 0 && err == 0;
+        }
+    }
+    close(fd);
+    if (!ok) {
+        ESP_LOGI(TAG, "probe %s:%d: no answer within %d ms", host.c_str(), port, timeout_ms);
+    }
+    return ok;
+}
+
+std::string maipai_fallback_voice_url(const std::string& saved_url)
+{
+    if (CONFIG_STACKCHAN_FALLBACK_HUB_HOST[0] == '\0') {
+        return std::string();
+    }
+    std::string host, path;
+    int port = 0;
+    if (!maipai_url_parts(saved_url, &host, &port, &path)) {
+        return std::string();
+    }
+    return std::string("ws://") + CONFIG_STACKCHAN_FALLBACK_HUB_HOST + ":" + std::to_string(port) + path;
+}
+
+std::string maipai_fallback_avatar_base(const std::string& saved_base)
+{
+    if (CONFIG_STACKCHAN_FALLBACK_HUB_HOST[0] == '\0') {
+        return std::string();
+    }
+    std::string host, path;
+    int port = 0;
+    if (!maipai_url_parts(saved_base, &host, &port, &path)) {
+        return std::string();
+    }
+    return std::string("ws://") + CONFIG_STACKCHAN_FALLBACK_HUB_HOST + ":" + std::to_string(port);
+}
