+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The fallback hub endpoint (patch 144): when the saved home address cannot be reached (the unit is away from
+ * home), the voice and avatar channels try a fixed second address with the same saved pairing token, then go
+ * back to the home address on their own. The first fallback is the laptop's own Wi-Fi (macOS Internet Sharing,
+ * a fixed 192.168.2.1) running a small relay to the hub. The list is open: a third entry (a public wss
+ * endpoint) is one more row in maipai_fallback_voice_url / maipai_fallback_avatar_base.
+ */
+#pragma once
+#include <string>
+
+// "ws://192.168.1.5:8765/path?q" -> host "192.168.1.5", port 8765, path "/path?q". False if it does not parse.
+bool maipai_url_parts(const std::string& url, std::string* host, int* port, std::string* path);
+
+// True when a TCP connection to host:port is accepted within timeout_ms (a plain non-blocking connect that is
+// closed at once). The stock socket connect has no timeout, so an unreachable home address would hold the
+// reconnect loop for a minute or more: this is the "a few seconds without answer" check.
+bool maipai_probe_tcp(const std::string& host, int port, int timeout_ms);
+
+// The voice URL to try after the home address failed: ws://<fallback host>:<the port of the saved url><path of
+// the saved url>. The fallback uses the same ports as the home address (the laptop relay listens on them), so a
+// port change on the hub needs no new firmware. Empty when no fallback host is configured or the saved url does
+// not parse.
+std::string maipai_fallback_voice_url(const std::string& saved_url);
+
+// The avatar base URL to try after the home address failed: ws://<fallback host>:<the port of the saved avatar
+// base>. `saved_base` is the base the avatar channel holds (http://host:port or ws://host:port). Empty when no
+// fallback host is configured or it does not parse.
+std::string maipai_fallback_avatar_base(const std::string& saved_base);
