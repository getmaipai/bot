+// The compiled-in text font (font_puhui_basic_20_4) covers ASCII, Latin-1 and Latin Extended, but not the
+// typographic punctuation a language model writes. Map those to ASCII so they never draw as blanks
+// (patch 096). Anything else without a glyph is skipped by LVGL (no placeholder glyph).
+static std::string ascii_punctuation(const char* text)
+{
+    std::string out;
+    if (text == nullptr) {
+        return out;
+    }
+    for (const unsigned char* p = reinterpret_cast<const unsigned char*>(text); *p != 0;) {
+        if (p[0] == 0xE2 && p[1] == 0x80) {
+            const char* mapped = nullptr;
+            switch (p[2]) {
+                case 0x98: case 0x99: case 0x9A: mapped = "'"; break;      // U+2018 to U+201A
+                case 0x9C: case 0x9D: case 0x9E: mapped = "\""; break;     // U+201C to U+201E
+                case 0x90: case 0x91: case 0x92: case 0x93: case 0x94: case 0x95: mapped = "-"; break;  // hyphens, dashes
+                case 0xA2: mapped = "*"; break;                              // U+2022 bullet
+                case 0xA6: mapped = "..."; break;                            // U+2026 ellipsis
+                default: break;
+            }
+            if (mapped != nullptr) {
+                out += mapped;
+                p += 3;
+                continue;
+            }
+        } else if (p[0] == 0xC2 && p[1] == 0xA0) {  // U+00A0 no-break space
+            out += ' ';
+            p += 2;
+            continue;
+        }
+        out += static_cast<char>(*p++);
+    }
+    return out;
+}
