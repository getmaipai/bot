+void StackChanAvatarDisplay::EnsureQuietMarker()
+{
+    if (quiet_marker_ != nullptr) {
+        return;
+    }
+    auto* mint = dynamic_cast<MintAvatar*>(&GetStackChan().avatar());
+    if (mint == nullptr || mint->getPanel() == nullptr) {
