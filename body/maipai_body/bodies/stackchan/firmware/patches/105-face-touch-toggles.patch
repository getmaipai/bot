+    lv_obj_remove_style_all(quiet_marker_);
+    lv_obj_remove_flag(quiet_marker_, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(quiet_marker_, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_size(quiet_marker_, 26, 22);
+    lv_obj_align(quiet_marker_, LV_ALIGN_TOP_MID, 0, 34);
+    for (int i = 0; i < 2; i++) {
+        lv_obj_t* bar = lv_obj_create(quiet_marker_);
