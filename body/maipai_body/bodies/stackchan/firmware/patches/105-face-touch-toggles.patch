+// A toggle started from the face (patch 105): called from the LVGL task, so the lock is held. Silent: no sound,
+// a short blink and the new look (ApplyPrivacyFace, patch 108); the "privacy" event tells the host.
+void StackChanAvatarDisplay::OnFaceToggle(int action)
+{
+    int bit            = kPrivQuiet;
+    const char* name   = "quiet";
+    if (action == MTC_ACTION_MUTE) {
+        bit  = kPrivMute;
+        name = "mute";
+    } else if (action == MTC_ACTION_VISION) {
+        bit  = kPrivVision;
+        name = "vision";
+    }
+    const bool turning_on = (maipai_privacy_bits() & bit) == 0;
+    int bits              = 0;
+    const bool ok         = maipai_privacy_set(bit, turning_on ? bit : 0, "face", &bits);
+    ESP_LOGI(TAG, "face: %s %s from the face (%s)", name, turning_on ? "on" : "off", ok ? "done" : "refused");
+    if (ok) {
+        ApplyPrivacyFace(bits, true);
+    }
+}
