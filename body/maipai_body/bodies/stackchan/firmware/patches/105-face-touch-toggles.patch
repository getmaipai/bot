+void StackChanAvatarDisplay::ApplyPrivacyFace(int bits, bool animate)
+{
+    auto& stackchan = GetStackChan();
+    if (!stackchan.hasAvatar()) {
+        return;
+    }
+    auto& avatar        = stackchan.avatar();
+    const bool muted    = (bits & kPrivMute) != 0;
+    const bool vision   = (bits & kPrivVision) != 0;
+    const bool quiet    = (bits & kPrivQuiet) != 0;
+    privacy_bits_       = bits;
+    auto* left          = dynamic_cast<MintEye*>(&avatar.leftEye());
+    auto* right         = dynamic_cast<MintEye*>(&avatar.rightEye());
+    auto* mouth         = dynamic_cast<MintMouth*>(&avatar.mouth());
+    // Mute: a flat closed mouth. Vision off: half-lidded eyes (in full quiet the eyes are shut anyway).
+    if (mouth != nullptr) {
+        mouth->setSealed(muted);
+    }
+    if (left != nullptr && right != nullptr) {
+        left->setLowered(vision && !quiet);
+        right->setLowered(vision && !quiet);
+    }
+    if (quiet && !quiet_face_) {
+        quiet_face_ = true;
+        EnsureQuietMarker();
+        if (quiet_marker_ != nullptr) {
+            lv_obj_remove_flag(quiet_marker_, LV_OBJ_FLAG_HIDDEN);
+        }
+        SetEmotion("sleeping");
+    } else if (!quiet && quiet_face_) {
+        quiet_face_ = false;
+        if (quiet_marker_ != nullptr) {
+            lv_obj_add_flag(quiet_marker_, LV_OBJ_FLAG_HIDDEN);
+        }
+        SetEmotion("neutral");
+        if (hal_bridge::is_xiaozhi_idle() && idle_expression_modifier_id_ < 0) {
+            idle_expression_modifier_id_ = stackchan.addModifier(std::make_unique<IdleExpressionModifier>());
+        }
+    }
+    if (animate && !quiet && left != nullptr && right != nullptr) {
+        // The change cue: the eyes close for a moment and open again. No sound.
+        avatar.leftEye().setWeight(0);
+        avatar.rightEye().setWeight(0);
+        if (cue_timer_ != nullptr) {
+            lv_timer_delete(cue_timer_);
+        }
+        cue_timer_ = lv_timer_create(
+            [](lv_timer_t* timer) {
+                auto* display = static_cast<StackChanAvatarDisplay*>(lv_timer_get_user_data(timer));
+                auto& chan    = GetStackChan();
+                if (chan.hasAvatar() && !display->quiet_face_) {
+                    chan.avatar().leftEye().setWeight(100);
+                    chan.avatar().rightEye().setWeight(100);
+                    auto blink = static_cast<BlinkModifier*>(chan.getModifier(display->blink_modifier_id_));
+                    if (blink) {
+                        blink->resyncEyeWeights();
+                    }
+                }
+                display->cue_timer_ = nullptr;
+            },
+            260, this);
+        lv_timer_set_repeat_count(cue_timer_, 1);
+    }
+}
