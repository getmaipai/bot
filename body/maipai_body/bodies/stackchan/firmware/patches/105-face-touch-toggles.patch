@@ -0,0 +1,180 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Face touch classification for the 320x240 screen (patch 105). Plain C99, no firmware headers, so a
+ * host test compiles and runs it (body/tests/firmware/touch_core_test.c).
+ *
+ * A touch is a trace: where the finger went down, where it is now, how far it ever strayed from the
+ * down point, and how long it has been down. The face has five kinds of place:
+ *
+ *   EDGE       the margin all round the screen. Swipes from the top (quick settings), the sides (volume)
+ *              and the bottom (stop) start here, so a touch that begins in an edge zone is never a toggle.
+ *   FOREHEAD   the strip above the eyes and the gap between them:  hold 0.5 s = full quiet on or off.
+ *   EYE_L/R    the two eyes:                                          tap     = vision off or on.
+ *   MOUTH      the mouth box:                                         hold 0.5 s = mute on or off.
+ *   REST       everything else; the unit's old behaviour (a tap starts a listen) is unchanged there.
+ *
+ * Only a still finger counts: it may stray at most MTC_STILL_PX from where it went down, and it must be
+ * released (or still held) inside the region it started in. A tap is at most MTC_TAP_MAX_MS; a hold is
+ * at least MTC_HOLD_MS; between the two is a dead band that does nothing, so a slow tap is never a
+ * hold. Anything that strays further is a drag and toggles nothing.
+ */
+#ifndef MAIPAI_TOUCH_CORE_H
+#define MAIPAI_TOUCH_CORE_H
+
+#include <stdint.h>
+
+#define MTC_WIDTH 320
+#define MTC_HEIGHT 240
+
+#define MTC_EDGE_TOP 28    /* the top strip also carries the quick-settings swipe */
+#define MTC_EDGE_SIDE 20
+#define MTC_EDGE_BOTTOM 20
+
+#define MTC_STILL_PX 10    /* farthest a tap or hold may stray from where it went down */
+#define MTC_TAP_MAX_MS 400
+#define MTC_HOLD_MS 500
+
+typedef enum {
+    MTC_REGION_EDGE = 0,
+    MTC_REGION_FOREHEAD,
+    MTC_REGION_EYE_LEFT,
+    MTC_REGION_EYE_RIGHT,
+    MTC_REGION_MOUTH,
+    MTC_REGION_REST
+} mtc_region_t;
+
+typedef enum { MTC_KIND_NONE = 0, MTC_KIND_TAP, MTC_KIND_HOLD, MTC_KIND_DRAG } mtc_kind_t;
+
+typedef enum { MTC_ACTION_NONE = 0, MTC_ACTION_MUTE, MTC_ACTION_VISION, MTC_ACTION_QUIET } mtc_action_t;
+
+typedef struct {
+    int x0, y0;           /* where the finger went down */
+    int x, y;             /* the latest point */
+    int max_stray2;       /* the farthest the finger has been from (x0, y0), squared */
+    uint32_t t0, t;       /* down time and latest time, ms */
+    mtc_region_t region0; /* the region the touch began in */
+} mtc_trace_t;
+
+/* The regions tile the screen with no overlap (the first match wins, top to bottom):
+ *   edge margins                         x < 20, x >= 300, y < 28, y >= 220
+ *   forehead strip above the eyes        y 28..55, any x inside the margins
+ *   left eye 20..111   right eye 208..299   y 56..149   (the eyes are drawn at x 56..108 and 212..264)
+ *   forehead gap between the eyes        x 112..207, y 56..119
+ *   mouth box                            x 112..207, y 120..219  (the mouth is drawn at y 130..190)
+ */
+static inline mtc_region_t mtc_region_at(int x, int y)
+{
+    if (x < MTC_EDGE_SIDE || x >= MTC_WIDTH - MTC_EDGE_SIDE || y < MTC_EDGE_TOP || y >= MTC_HEIGHT - MTC_EDGE_BOTTOM) {
+        return MTC_REGION_EDGE;
+    }
+    if (y < 56) {
+        return MTC_REGION_FOREHEAD;
+    }
+    if (y < 150) {
+        if (x < 112) {
+            return MTC_REGION_EYE_LEFT;
+        }
+        if (x >= 208) {
+            return MTC_REGION_EYE_RIGHT;
+        }
+        return y < 120 ? MTC_REGION_FOREHEAD : MTC_REGION_MOUTH;
+    }
+    if (x >= 112 && x < 208) {
+        return MTC_REGION_MOUTH;
+    }
+    return MTC_REGION_REST;
+}
+
+static inline void mtc_begin(mtc_trace_t* trace, int x, int y, uint32_t now_ms)
+{
+    trace->x0 = trace->x = x;
+    trace->y0 = trace->y = y;
+    trace->max_stray2 = 0;
+    trace->t0 = trace->t = now_ms;
+    trace->region0 = mtc_region_at(x, y);
+}
+
+static inline void mtc_move(mtc_trace_t* trace, int x, int y, uint32_t now_ms)
+{
+    const int dx = x - trace->x0;
+    const int dy = y - trace->y0;
+    const int d2 = dx * dx + dy * dy;
+    trace->x = x;
+    trace->y = y;
+    trace->t = now_ms;
+    if (d2 > trace->max_stray2) {
+        trace->max_stray2 = d2;
+    }
+}
+
+static inline int mtc_is_still(const mtc_trace_t* trace)
+{
+    return trace->max_stray2 <= MTC_STILL_PX * MTC_STILL_PX;
+}
+
+/* Only a touch that began and is still inside one toggle region can be a toggle. */
+static inline int mtc_in_start_region(const mtc_trace_t* trace)
+{
+    return trace->region0 != MTC_REGION_EDGE && mtc_region_at(trace->x, trace->y) == trace->region0;
+}
+
+/* What the finished touch was. */
+static inline mtc_kind_t mtc_classify(const mtc_trace_t* trace)
+{
+    if (trace->region0 == MTC_REGION_EDGE || !mtc_is_still(trace) || !mtc_in_start_region(trace)) {
+        return MTC_KIND_DRAG;
+    }
+    const uint32_t held = trace->t - trace->t0;
+    if (held <= MTC_TAP_MAX_MS) {
+        return MTC_KIND_TAP;
+    }
+    if (held >= MTC_HOLD_MS) {
+        return MTC_KIND_HOLD;
+    }
+    return MTC_KIND_NONE; /* the dead band between a tap and a hold */
+}
+
+/* Which toggle (if any) a kind of touch starts in a region: the eyes toggle on a tap; the mouth and
+ * the forehead take a tap or a hold (owner 2026-11-13: tapping must work). */
+static inline mtc_action_t mtc_action_for(mtc_region_t region, mtc_kind_t kind)
+{
+    if (kind == MTC_KIND_TAP && (region == MTC_REGION_EYE_LEFT || region == MTC_REGION_EYE_RIGHT)) {
+        return MTC_ACTION_VISION;
+    }
+    if ((kind == MTC_KIND_HOLD || kind == MTC_KIND_TAP) && region == MTC_REGION_MOUTH) {
+        return MTC_ACTION_MUTE;
+    }
+    if ((kind == MTC_KIND_HOLD || kind == MTC_KIND_TAP) && region == MTC_REGION_FOREHEAD) {
+        return MTC_ACTION_QUIET;
+    }
+    return MTC_ACTION_NONE;
+}
+
+/* The action when the finger lifts. A hold is normally acted on while the finger is still down
+ * (mtc_hold_ready), so the release of a hold the caller already acted on must not call this. */
+static inline mtc_action_t mtc_action_on_release(const mtc_trace_t* trace)
+{
+    return mtc_action_for(trace->region0, mtc_classify(trace));
+}
+
+/* While the finger is still down: has it been held still, in place, long enough to count as a hold in a
+ * hold region? The caller acts once and then ignores the rest of the touch. */
+static inline mtc_action_t mtc_action_while_down(const mtc_trace_t* trace, uint32_t now_ms)
+{
+    if (trace->region0 == MTC_REGION_EDGE || !mtc_is_still(trace) || !mtc_in_start_region(trace)) {
+        return MTC_ACTION_NONE;
+    }
+    if (now_ms - trace->t0 < MTC_HOLD_MS) {
+        return MTC_ACTION_NONE;
+    }
+    return mtc_action_for(trace->region0, MTC_KIND_HOLD);
+}
+
+/* Does the unit's old tap-starts-a-listen rule still apply to this touch? Only where no toggle lives. */
+static inline int mtc_region_listens(mtc_region_t region)
+{
+    return region == MTC_REGION_REST;
+}
+
+#endif
