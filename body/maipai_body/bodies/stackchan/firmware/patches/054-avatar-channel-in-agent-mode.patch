@@ -527,0 +539,44 @@ void Hal::startWebSocketAvatarService(std::function<void(std::string_view)> onSt
+
+// The avatar channel in AI-agent mode (patch 054). WebsocketAvatarWorker is a Mooncake ability that
+// only AppAvatar creates, and the firmware boots straight into the voice agent without Mooncake
+// apps, so the avatar socket (camera frames, expression frames) was never opened at all. This runs
+// the same worker from a plain task once the voice agent is ready. It needs internal RAM for the
+// task stack and the websocket client, so it starts only when enough is free; otherwise it says why.
+static void _avatar_channel_task(void*)
+{
+    WebsocketAvatarWorker worker;
+    while (true) {
+        worker.onRunning();
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+}
+
+void Hal::startAvatarChannel()
+{
+    static bool started = false;
+    if (started) {
+        return;
+    }
+    constexpr size_t kMinFreeInternal = 32 * 1024;
+    constexpr uint32_t kStackBytes    = 8192;
+    if (secret_logic::get_server_url().empty()) {
+        started = true;
+        mclog::tagInfo(_tag, "avatar channel off: no avatar address in the saved settings");
+        device_events_push_diag("avatar_channel", "\"state\":\"off\",\"why\":\"no_url\"");
+        return;
+    }
+    size_t free_internal = heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
+    if (free_internal < kMinFreeInternal) {
+        mclog::tagInfo(_tag, "avatar channel not started: {} bytes of internal RAM free (need {})", free_internal,
+                       kMinFreeInternal);
+        char extra[64];
+        snprintf(extra, sizeof(extra), "\"state\":\"off\",\"why\":\"ram\",\"free\":%u",
+                 static_cast<unsigned>(free_internal));
+        device_events_push_diag("avatar_channel", extra);
+        return;
+    }
+    started = true;
+    mclog::tagInfo(_tag, "start avatar channel ({} bytes of internal RAM free)", free_internal);
+    xTaskCreate(_avatar_channel_task, "avatar_ws", kStackBytes, nullptr, 2, nullptr);
+    device_events_push_diag("avatar_channel", "\"state\":\"started\"");
+}
