@@ -240,9 +240,44 @@ void maipai_tailnet_init()
     }
 }
 
+static int64_t s_prefer_until_us = 0;
+static unsigned s_prefer_gen     = 0;
+
+bool maipai_tailnet_prefer_active()
+{
+    return s_prefer_until_us != 0 && esp_timer_get_time() < s_prefer_until_us;
+}
+
+unsigned maipai_tailnet_prefer_generation()
+{
+    return s_prefer_gen;
+}
+
 void maipai_tailnet_register_tools()
 {
     auto& mcp = McpServer::GetInstance();
+    // Patch 153: a test hook, off by default and never saved: while on, the unit prefers the tailnet path to the hub
+    // even when the home address answers, so the tailnet path can be proven at home.
+    mcp.AddTool("self.network.prefer_tailnet",
+                "Prefer the tailnet path to the hub for the given minutes (0 turns it off). Not saved: a restart "
+                "clears it. Answers {\"ok\":true,\"minutes\":n} or {\"ok\":false,\"error\":\"tailnet_not_ready\"}.",
+                PropertyList({Property("minutes", kPropertyTypeInteger, 0, 0, 120)}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    const int minutes = properties["minutes"].value<int>();
+                    if (minutes <= 0) {
+                        s_prefer_until_us = 0;
+                        s_prefer_gen++;
+                        return std::string("{\"ok\":true,\"minutes\":0}");
+                    }
+                    if (!maipai_tailnet_ready()) {
+                        return std::string("{\"ok\":false,\"error\":\"tailnet_not_ready\"}");
+                    }
+                    s_prefer_until_us = esp_timer_get_time() + static_cast<int64_t>(minutes) * 60 * 1000000;
+                    s_prefer_gen++;
+                    char buf[48];
+                    snprintf(buf, sizeof(buf), "{\"ok\":true,\"minutes\":%d}", minutes);
+                    return std::string(buf);
+                });
     mcp.AddTool("self.tailnet.status",
                 "The tailnet client: whether it is compiled in, switched on, its state (idle, waiting_wifi, connecting, "
                 "registering, connected, reconnecting, error, guard_off), the tailnet address, the hub address it "
