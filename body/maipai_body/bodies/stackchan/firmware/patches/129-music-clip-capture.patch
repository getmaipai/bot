+// Clip state is shared by MCP, the audio tap and worker. The lock is a short critical section;
+// the tap never allocates, logs, posts events or performs base64/JSON work.
+portMUX_TYPE s_clip_mux = portMUX_INITIALIZER_UNLOCKED;
+portMUX_TYPE s_clip_copy_mux = portMUX_INITIALIZER_UNLOCKED;
+uint8_t* s_clip_data = nullptr;
+size_t s_clip_capacity = 0;
+size_t s_clip_written = 0;
+size_t s_clip_ready_bytes = 0;
+int64_t s_clip_ready_at_us = 0;
+int32_t s_clip_partial_sum = 0;
+unsigned s_clip_partial_count = 0;
+std::atomic<bool> s_clip_capture{false};
+std::atomic<int> s_clip_cancel_reason{0};  // suppress, mute, quiet, link, wake
+std::atomic<bool> s_clip_ready_pending{false};
+
+enum ClipCancelReason { kClipNoCancel, kClipSuppress, kClipMute, kClipQuiet, kClipLink, kClipWake };
+
+const char* clip_cancel_name(int why)
+{
+    switch (why) {
+        case kClipSuppress: return "suppress";
+        case kClipMute: return "mute";
+        case kClipQuiet: return "quiet";
+        case kClipLink: return "link";
+        case kClipWake: return "wake";
+        default: return "unknown";
+    }
+}
+
+void clip_request_cancel(int why)
+{
+    if (s_clip_capture.exchange(false)) {
+        s_clip_cancel_reason.store(why);
+    }
+}
+
+void clip_release_locked()
+{
+    if (s_clip_data != nullptr) {
+        heap_caps_free(s_clip_data);
+    }
+    s_clip_data = nullptr;
+    s_clip_capacity = s_clip_written = s_clip_ready_bytes = 0;
+    s_clip_ready_at_us = 0;
+    s_clip_partial_sum = 0;
+    s_clip_partial_count = 0;
+}
+
+void clip_worker_housekeeping()
+{
+    const int why = s_clip_cancel_reason.exchange(kClipNoCancel);
+    if (why != kClipNoCancel) {
+        portENTER_CRITICAL(&s_clip_copy_mux);
+        portENTER_CRITICAL(&s_clip_mux);
+        if (s_clip_ready_bytes != 0) {
+            portEXIT_CRITICAL(&s_clip_mux);
+            portEXIT_CRITICAL(&s_clip_copy_mux);
+            return;  // the tap filled the clip before the cancellation reached the worker
+        }
+        clip_release_locked();
+        portEXIT_CRITICAL(&s_clip_mux);
+        portEXIT_CRITICAL(&s_clip_copy_mux);
+        char extra[48];
+        snprintf(extra, sizeof(extra), "\"why\":\"%s\"", clip_cancel_name(why));
+        device_events_push("music_clip_cancelled", extra);
+        ESP_LOGI("HAL-Music", "clip cancelled (%s)", clip_cancel_name(why));
+    }
+    if (s_clip_ready_pending.exchange(false)) {
+        size_t bytes;
+        portENTER_CRITICAL(&s_clip_mux);
+        bytes = s_clip_ready_bytes;
+        s_clip_ready_at_us = esp_timer_get_time();
+        portEXIT_CRITICAL(&s_clip_mux);
+        char extra[64];
+        snprintf(extra, sizeof(extra), "\"bytes\":%u,\"rate\":8000,\"codec\":\"mulaw\"", static_cast<unsigned>(bytes));
+        device_events_push("music_clip_ready", extra);
+        ESP_LOGI("HAL-Music", "clip ready (%u bytes)", static_cast<unsigned>(bytes));
+    }
+    bool expired = false;
+    portENTER_CRITICAL(&s_clip_mux);
+    if (!s_clip_capture.load() && s_clip_ready_bytes > 0 && s_clip_ready_at_us > 0 &&
+        esp_timer_get_time() - s_clip_ready_at_us >= 60000000) {
+        clip_release_locked();
+        expired = true;
+    }
+    portEXIT_CRITICAL(&s_clip_mux);
+    if (expired) {
+        ESP_LOGI("HAL-Music", "clip dropped (expired)");
+    }
+}
+
+int16_t clip_mulaw_sample(int16_t sample)
+{
+    constexpr int kBias = 0x84;
+    constexpr int kClip = 32635;
+    int value = sample;
+    int mask;
+    if (value < 0) {
+        value = -value;
+        mask = 0x7f;
+    } else {
+        mask = 0xff;
+    }
+    value = std::min(value, kClip) + kBias;
+    int exponent = 7;
+    for (int exp_mask = 0x4000; exponent > 0 && (value & exp_mask) == 0; --exponent, exp_mask >>= 1) {}
+    const int mantissa = (value >> (exponent + 3)) & 0x0f;
+    return static_cast<int16_t>((~((exponent << 4) | mantissa) & mask) & 0xff);
+}
