 private:
+    // Run bookkeeping for the statistics and the blip lockout.
+    void track_runs(bool touched, uint32_t now_ms)
+    {
+        if (touched) {
+            if (run_len == 0) {
+                quiet_before = quiet;
+            }
+            run_len++;
+            quiet = 0;
+            pending_blip = false;  // something touched soon after a short run: not isolated
+            if (run_len > run_max) {
+                run_max = run_len;
+            }
+            return;
+        }
+        if (run_len > 0) {
+            if (run_len >= static_cast<uint32_t>(kLongRunSamples)) {
+                long_runs++;
+            }
+            if (run_len <= static_cast<uint32_t>(kBlipMaxRun) && quiet_before >= static_cast<uint32_t>(kWindowSamples)) {
+                pending_blip = true;
+            }
+            run_len = 0;
+            quiet   = 0;
+        }
+        quiet++;
+        if (pending_blip && quiet >= static_cast<uint32_t>(kWindowSamples)) {
+            pending_blip = false;
+            blips++;
+            blip_times_ms[blip_next] = now_ms == 0 ? 1 : now_ms;
+            blip_next                = (blip_next + 1) % kBlipCountToLock;
+            uint32_t oldest          = blip_times_ms[blip_next];
+            if (oldest != 0 && now_ms - oldest < kBlipWindowMs) {
+                locked_until_ms = now_ms + kLockoutMs;
+            }
+        }
+    }
