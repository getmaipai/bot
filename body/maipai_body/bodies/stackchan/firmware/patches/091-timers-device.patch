--- /dev/null
+++ b/firmware/main/hal/maipai_timers.cc
@@ -0,0 +1,323 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * On-unit timers and alarms, the device side (patch 091). See maipai_timers.h.
+ */
+#include "maipai_timers.h"
+#include "maipai_timers_core.h"
+#include "hal.h"
+#include "device_events.h"
+#include "board/hal_bridge.h"
+#include <apps/common/common.h>
+#include <assets/assets.h>
+#include <stackchan/stackchan.h>
+#include <application.h>
+#include <esp_log.h>
+#include <esp_timer.h>
+#include <nvs.h>
+#include <nvs_flash.h>
+#include <atomic>
+#include <mutex>
+#include <ctime>
+#include <cstdio>
+
+static const char* TAG = "MAIPAI-TIMERS";
+static const char* kNamespace = "mp_timers";  // our own: never the websocket namespace (pairing token, Wi-Fi)
+static const char* kKey       = "v1";
+
+namespace {
+std::mutex s_mutex;
+mt_state_t s_state;
+mt_ring_t s_ring;
+bool s_loaded         = false;
+uint32_t s_last_tick_ms = 0;
+uint32_t s_last_pulse_ms = 0;
+int s_card_id         = -1;  // the avatar decorator showing the timer card
+// Set by a touch or the stop word from another task or the display thread; the tick acts on it, so
+// nothing here ever takes the timer lock while holding the display lock.
+std::atomic<const char*> s_dismiss_request{nullptr};
+std::atomic<bool> s_ringing{false};
+
+uint32_t mono_s()
+{
+    return static_cast<uint32_t>(esp_timer_get_time() / 1000000);
+}
+uint32_t mono_ms()
+{
+    return static_cast<uint32_t>(esp_timer_get_time() / 1000);
+}
+uint32_t wall_s()
+{
+    time_t t = time(nullptr);
+    return t > 0 ? static_cast<uint32_t>(t) : 0;
+}
+uint32_t seconds_of_day()
+{
+    time_t t = time(nullptr);
+    struct tm tm_local = {};
+    localtime_r(&t, &tm_local);
+    return static_cast<uint32_t>(tm_local.tm_hour * 3600 + tm_local.tm_min * 60 + tm_local.tm_sec);
+}
+
+void save_locked()
+{
+    uint8_t buf[MT_BLOB_MAX];
+    size_t n = mt_save(&s_state, buf, sizeof(buf));
+    nvs_handle_t h;
+    if (n == 0 || nvs_open(kNamespace, NVS_READWRITE, &h) != ESP_OK) {
+        ESP_LOGW(TAG, "could not save the timers");
+        return;
+    }
+    if (nvs_set_blob(h, kKey, buf, n) != ESP_OK || nvs_commit(h) != ESP_OK) {
+        ESP_LOGW(TAG, "could not write the timers");
+    }
+    nvs_close(h);
+    s_state.changed = 0;
+}
+
+void set_ring_colour(uint8_t level)
+{
+    // The standard's cyan (0, 91, 101) at the pulse level; the ring is 12 pixels.
+    const uint8_t g = static_cast<uint8_t>((91u * level) / 255u);
+    const uint8_t b = static_cast<uint8_t>((101u * level) / 255u);
+    for (int i = 0; i < 12; i++) {
+        GetHAL().setRgbColor(i, 0, g, b);
+    }
+    GetHAL().refreshRgb();
+}
+
+void push_ended(uint32_t id, const char* how)
+{
+    char extra[96];
+    snprintf(extra, sizeof(extra), "\"id\":%u,\"how\":\"%s\"", static_cast<unsigned>(id), how);
+    device_events_push("timer_ended", extra);
+}
+
+void end_ring_locked(const char* how)
+{
+    const uint32_t id = s_ring.id;
+    if (!mt_ring_end(&s_ring, mono_ms())) {
+        return;
+    }
+    s_ringing = false;
+    ESP_LOGI(TAG, "ring ended by %s", how);
+    {
+        LvglLockGuard lock;
+        if (s_card_id >= 0) {
+            GetStackChan().avatar().removeDecorator(s_card_id);
+            s_card_id = -1;
+        }
+        GetStackChan().avatar().setEmotion(stackchan::avatar::Emotion::Neutral);
+    }
+    set_ring_colour(0);
+    Application::GetInstance().GetAudioService().SetStopWordArmed(false);
+    push_ended(id, how);
+}
+
+void start_ring_locked(const mt_fired_t& f)
+{
+    char extra[128];
+    snprintf(extra, sizeof(extra), "\"id\":%u,\"what\":\"%s\",\"label\":\"%s\",\"late\":%d",
+             static_cast<unsigned>(f.id), f.kind == MT_KIND_ALARM ? "alarm" : "timer", f.label, f.late ? 1 : 0);
+    device_events_push("timer_fired", extra);
+    if (!mt_ring_start(&s_ring, &f, mono_ms())) {
+        return;  // already ringing: the extra one is counted
+    }
+    s_ringing = true;
+    ESP_LOGI(TAG, "ring: %s %u \"%s\"", f.kind == MT_KIND_ALARM ? "alarm" : "timer", static_cast<unsigned>(f.id),
+             f.label);
+    hal_bridge::power_keep_awake();
+    std::string text = f.label[0] ? f.label : (f.kind == MT_KIND_ALARM ? "Alarm" : "Time is up");
+    {
+        LvglLockGuard lock;
+        auto& avatar = GetStackChan().avatar();
+        avatar.setEmotion(stackchan::avatar::Emotion::Happy);
+        s_card_id = avatar.addDecorator(std::make_unique<view::ReminderView>(lv_screen_active(), text));
+    }
+    // "stop" ends the ring (patch 093). Arming is best effort: it needs the stop-word model and
+    // some free internal RAM, and a touch always works.
+    Application::GetInstance().GetAudioService().SetStopWordArmed(true);
+    s_last_pulse_ms = 0;
+}
+}  // namespace
+
+void maipai_timers_init()
+{
+    std::lock_guard<std::mutex> lock(s_mutex);
+    mt_init(&s_state);
+    mt_ring_init(&s_ring);
+    nvs_handle_t h;
+    if (nvs_open(kNamespace, NVS_READONLY, &h) == ESP_OK) {
+        uint8_t buf[MT_BLOB_MAX];
+        size_t n = sizeof(buf);
+        if (nvs_get_blob(h, kKey, buf, &n) == ESP_OK) {
+            if (mt_load(&s_state, buf, n) != MT_OK) {
+                ESP_LOGW(TAG, "saved timers unreadable (%u bytes): starting empty", static_cast<unsigned>(n));
+            }
+        }
+        nvs_close(h);
+    }
+    s_loaded = true;
+    ESP_LOGI(TAG, "loaded %d timer(s)", mt_count(&s_state));
+}
+
+void maipai_timers_tick()
+{
+    const uint32_t ms = mono_ms();
+    if (ms - s_last_tick_ms < 200) {
+        return;
+    }
+    s_last_tick_ms = ms;
+    std::lock_guard<std::mutex> lock(s_mutex);
+    if (!s_loaded) {
+        return;
+    }
+    if (!s_ring.active) {
+        s_dismiss_request = nullptr;
+    }
+    mt_fired_t fired[MT_MAX_ACTIVE];
+    int dropped = 0;
+    const int n = mt_tick(&s_state, wall_s(), mono_s(), fired, MT_MAX_ACTIVE, &dropped);
+    if (dropped > 0) {
+        char extra[32];
+        snprintf(extra, sizeof(extra), "\"dropped\":%d", dropped);
+        device_events_push("timer_missed", extra);
+    }
+    for (int i = 0; i < n; i++) {
+        start_ring_locked(fired[i]);
+    }
+    if (s_state.changed) {
+        save_locked();
+    }
+    if (!s_ring.active) {
+        return;
+    }
+    if (const char* how = s_dismiss_request.exchange(nullptr)) {
+        end_ring_locked(how);
+        return;
+    }
+    const int poll = mt_ring_poll(&s_ring, ms);
+    if (poll == MT_POLL_TIMEOUT) {
+        end_ring_locked("timeout");
+        return;
+    }
+    if (poll == MT_POLL_CHIME) {
+        hal_bridge::power_keep_awake();
+        hal_bridge::app_play_sound(OGG_NEW_NOTIFICATION);
+    }
+    if (ms - s_last_pulse_ms >= 200) {
+        s_last_pulse_ms = ms;
+        set_ring_colour(mt_pulse_level(ms - s_ring.start_ms));
+    }
+}
+
+int maipai_timers_add_timer(int seconds, const char* label, bool silent)
+{
+    std::lock_guard<std::mutex> lock(s_mutex);
+    if (seconds <= 0) {
+        return MT_ERR_ARGUMENT;
+    }
+    const int id = mt_add_timer(&s_state, wall_s(), mono_s(), static_cast<uint32_t>(seconds), label, silent);
+    if (s_state.changed) {
+        save_locked();
+    }
+    return id;
+}
+
+int maipai_timers_add_alarm(int hour, int minute, const char* label, bool silent)
+{
+    std::lock_guard<std::mutex> lock(s_mutex);
+    const int id = mt_add_alarm(&s_state, wall_s(), seconds_of_day(), hour, minute, label, silent);
+    if (s_state.changed) {
+        save_locked();
+    }
+    return id;
+}
+
+int maipai_timers_snooze(int seconds)
+{
+    std::lock_guard<std::mutex> lock(s_mutex);
+    const bool was_ringing = s_ring.active;
+    const uint32_t id      = s_ring.id;
+    const int result       = mt_snooze(&s_state, &s_ring, wall_s(), mono_s(), mono_ms(),
+                                       seconds > 0 ? static_cast<uint32_t>(seconds) : 0);
+    if (was_ringing) {
+        // mt_snooze ended the ring; put the screen and ring back the way end_ring_locked does.
+        LvglLockGuard lock2;
+        if (s_card_id >= 0) {
+            GetStackChan().avatar().removeDecorator(s_card_id);
+            s_card_id = -1;
+        }
+        GetStackChan().avatar().setEmotion(stackchan::avatar::Emotion::Neutral);
+        set_ring_colour(0);
+        Application::GetInstance().GetAudioService().SetStopWordArmed(false);
+        s_ringing = false;
+        push_ended(id, "snooze");
+    }
+    if (s_state.changed) {
+        save_locked();
+    }
+    return result;
+}
+
+bool maipai_timers_cancel(int id)
+{
+    std::lock_guard<std::mutex> lock(s_mutex);
+    bool ok = false;
+    if (id == 0) {
+        ok = mt_cancel_all(&s_state) > 0;
+    } else {
+        ok = mt_cancel(&s_state, static_cast<uint32_t>(id)) == MT_OK;
+    }
+    if (s_state.changed) {
+        save_locked();
+    }
+    return ok;
+}
+
+std::string maipai_timers_list_json()
+{
+    std::lock_guard<std::mutex> lock(s_mutex);
+    const uint32_t now = wall_s();
+    const uint32_t mono = mono_s();
+    std::string out = std::string("{\"clock\":") + (mt_clock_valid(now) ? "true" : "false") +
+                      ",\"ringing\":" + (s_ring.active ? "true" : "false") + ",\"timers\":[";
+    bool first = true;
+    for (int i = 0; i < MT_MAX_ACTIVE; i++) {
+        const mt_entry_t& e = s_state.e[i];
+        if (e.id == 0) {
+            continue;
+        }
+        char row[128];
+        snprintf(row, sizeof(row), "%s{\"id\":%u,\"kind\":\"%s\",\"left\":%lld,\"label\":\"%s\"}", first ? "" : ",",
+                 static_cast<unsigned>(e.id), e.kind == MT_KIND_ALARM ? "alarm" : "timer",
+                 static_cast<long long>(mt_remaining(&e, now, mono)), e.label);
+        out += row;
+        first = false;
+    }
+    return out + "]}";
+}
+
+bool maipai_timers_ringing()
+{
+    return s_ringing.load();
+}
+
+bool maipai_timers_request_dismiss(const char* how)
+{
+    if (!s_ringing.load()) {
+        return false;
+    }
+    s_dismiss_request = how;
+    return true;
+}
+
+bool maipai_timers_dismiss(const char* how)
+{
+    std::lock_guard<std::mutex> lock(s_mutex);
+    if (!s_ring.active) {
+        return false;
+    }
+    end_ring_locked(how);
+    return true;
+}
