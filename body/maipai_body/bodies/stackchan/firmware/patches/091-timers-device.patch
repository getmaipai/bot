+++ b/firmware/main/hal/maipai_timers.h
@@ -0,0 +1,27 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * On-unit timers and alarms (patches 090 to 093). The schedule lives in the unit's own flash (NVS
+ * namespace "mp_timers", never the websocket namespace) and runs off the RTC-backed clock, so it
+ * fires with no host and survives a reboot. Logic: maipai_timers_core.h.
+ */
+#pragma once
+#include <string>
+
+// Loads the saved schedule; call once after NVS and the RTC are up.
+void maipai_timers_init();
+// Call often (the 20 ms stackchan task): fires what is due and runs the ring.
+void maipai_timers_tick();
+// Each returns the id (> 0) or a negative MT_ERR_* code.
+int maipai_timers_add_timer(int seconds, const char* label, bool silent);
+int maipai_timers_add_alarm(int hour, int minute, const char* label, bool silent);
+int maipai_timers_snooze(int seconds);
+bool maipai_timers_cancel(int id);  // id 0 cancels all
+// JSON: {"clock":true,"ringing":false,"timers":[{"id":1,"kind":"timer","left":42,"label":"tea"}]}
+std::string maipai_timers_list_json();
+bool maipai_timers_ringing();
+// Ends a ring from the host's tool task. Returns true if one was going.
+bool maipai_timers_dismiss(const char* how);
+// Ends a ring from a touch, the stop word or any other task, without taking a lock: `how` must be a
+// string literal. Returns true if a ring was going; the tick ends it within 200 ms.
+bool maipai_timers_request_dismiss(const char* how);
