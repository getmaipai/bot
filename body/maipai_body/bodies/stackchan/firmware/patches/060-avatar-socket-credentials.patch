# Intent: let the hub accept the unit's avatar socket (host log 2026-10-21: the avatar worker of patch 054 connects every 5 s and the hub refuses it: "not authorized (token missing, device missing)"). The avatar socket sent the bare saved token, with no "Bearer " prefix, and sent Device-Id and Client-Id only when they were set at build time (they are not). It now sends the same credentials as the voice socket (websocket_protocol.cc): Authorization as a Bearer token, Device-Id as the unit's MAC address and Client-Id as its UUID. The hub still authorizes only a paired unit (device id, client id and token must match its pairing record), so no door is opened.
# Upstream: m5stack/StackChan firmware/main/hal/hal_ws_avatar.cpp (MIT). Applies after 059 with --unidiff-zero.
# Check after a flash: the host log shows "StackChan avatar: ..." without "refused", then "StackChan camera: N frames" with N above 0 once the camera stream starts.
diff --git a/firmware/main/hal/hal_ws_avatar.cpp b/firmware/main/hal/hal_ws_avatar.cpp
index fe9d76b..d8d7bc9 100644
--- a/firmware/main/hal/hal_ws_avatar.cpp
+++ b/firmware/main/hal/hal_ws_avatar.cpp
@@ -9,6 +9,7 @@
 #include <mooncake.h>
 #include <mooncake_log.h>
 #include <board.h>
+#include <system_info.h>
 #include <web_socket.h>
 #include <esp_log.h>
 #include <arpa/inet.h>
@@ -125,12 +126,23 @@ public:
         }
 
         // 设置认证头
+        // The same credentials the voice socket sends (websocket_protocol.cc): the saved token as a
+        // Bearer token, the unit's MAC as Device-Id and its UUID as Client-Id. The avatar socket sent
+        // the bare token and, without build-time ids, no Device-Id or Client-Id at all, so the hub
+        // refused it ("token missing, device missing").
+        if (!token.empty() && token.find(' ') == std::string::npos) {
+            token = "Bearer " + token;
+        }
         _websocket->SetHeader("Authorization", token.c_str());
 #ifdef CONFIG_STACKCHAN_DEVICE_ID
         _websocket->SetHeader("Device-Id", CONFIG_STACKCHAN_DEVICE_ID);
+#else
+        _websocket->SetHeader("Device-Id", SystemInfo::GetMacAddress().c_str());
 #endif
 #ifdef CONFIG_STACKCHAN_CLIENT_ID
         _websocket->SetHeader("Client-Id", CONFIG_STACKCHAN_CLIENT_ID);
+#else
+        _websocket->SetHeader("Client-Id", Board::GetInstance().GetUuid().c_str());
 #endif
 
         // 设置回调
