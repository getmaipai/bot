         out += one;
     }
     mclog::tagInfo(_tag, "main loop stalled; tasks: {}", out);
-    Settings settings("maipai", true);
-    settings.SetString("stall", out.substr(0, 230));
+    // Saving the record writes flash, and a flash write is not allowed from a task whose stack is in
+    // PSRAM (this task's is): it aborted the unit on every stall (serial log 2026-10-23, nvs_set_str
+    // from _imu_task). A short task with an internal stack saves it.
+    auto* record = new std::string(out.substr(0, 230));
+    if (xTaskCreate(
+            [](void* arg) {
+                {
+                    std::unique_ptr<std::string> text(static_cast<std::string*>(arg));
+                    Settings settings("maipai", true);
+                    settings.SetString("stall", *text);
+                }
+                vTaskDelete(nullptr);
+            },
+            "stall_save", 4096, record, 1, nullptr) != pdPASS) {
+        delete record;
+    }
 }
 
