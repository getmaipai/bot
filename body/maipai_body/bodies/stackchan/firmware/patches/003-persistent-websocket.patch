 bool WebsocketProtocol::OpenAudioChannel() {
+#if CONFIG_STACKCHAN_PERSISTENT_WEBSOCKET
+    if (reconnect_task_handle_ == nullptr) {
+        return false;
+    }
+    EventBits_t bits = xEventGroupWaitBits(event_group_handle_, WEBSOCKET_PROTOCOL_CONNECTED_EVENT, pdFALSE, pdTRUE, pdMS_TO_TICKS(10000));
+    bool opened = (bits & WEBSOCKET_PROTOCOL_CONNECTED_EVENT) != 0 && IsAudioChannelOpened();
+    if (opened && on_audio_channel_opened_ != nullptr) {
+        on_audio_channel_opened_();
+    }
+    return opened;
+#else
+    return ConnectAudioChannel();
+#endif
+}
