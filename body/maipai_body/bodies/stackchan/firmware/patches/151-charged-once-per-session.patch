# Intent: the "charged" cue plays once per charge and never repeats (owner 2026-11-14: a beep came every few minutes while the robot sat on a cable with a full battery; the unit's own sound report showed `charged` playing 10 times in 67 minutes while `charging` flipped 1, 0, 1, 0: a full battery on a charger cycles between top-off charging and done, and every flip to done played the cue). Now it needs a charging run of at least 5 minutes before the flip, plays once per plug-in session (re-armed only by an unplug confirmed for 20 s), and is limited to once in 6 hours; plug_in and unplug are limited to once in 2 minutes.
# Check after a flash: leave the robot on a cable with a full battery for an hour: no `unit played a sound name=charged` line repeats; a real charge from low battery plays `charged` once when it finishes.
diff --git a/firmware/main/hal/maipai_sounds_core.h b/firmware/main/hal/maipai_sounds_core.h
--- a/firmware/main/hal/maipai_sounds_core.h
+++ b/firmware/main/hal/maipai_sounds_core.h
@@ -58,9 +58,9 @@
  * (a charger reading, a battery icon at its threshold, a retrying link) cannot beep over and over. 0 = no limit. */
 static const uint32_t MS_SOUND_MIN_GAP_MS[MS_SND_COUNT] = {
     0u,       /* needs_you: the first-setup cue repeats once a minute by its own rule */
-    30000u,   /* plug_in */
-    60000u,   /* charged */
-    30000u,   /* unplug */
+    120000u,  /* plug_in: a person plugs in once; a flapping supply must not repeat it */
+    21600000u, /* charged: at most once in 6 hours */
+    120000u,  /* unplug */
     60000u,   /* offline */
     0u,       /* goodbye */
     1500u,    /* shutter: one click per picture */
@@ -197,13 +197,21 @@
  * supply that dips under the robot's load must not read as an unplug (owner report 2026-11-14). */
 #define MS_PWR_UNPLUG_CONFIRM 20
 
+/* "Charged" is for a battery that really finished a charge (owner report 2026-11-14: a full battery on a cable cycles between
+ * top-off charging and done every few minutes and every flip played the cue): the charging run that ended must have lasted
+ * at least this many polls (5 minutes), and the cue plays once per plug-in session (re-armed only by a confirmed unplug). */
+#define MS_PWR_FULL_MIN_RUN 300
+
 typedef struct {
     uint8_t init;
     uint8_t flaps;        /* candidate changes abandoned after 3 or more agreeing polls (saturates at 255) */
     uint8_t ext;          /* confirmed: a cable is in */
     uint8_t charging;     /* confirmed */
     uint8_t seen_charging; /* charging was seen since the cable went in, so "stopped" means "full" */
+    uint8_t full_announced; /* "charged" already played in this plug-in session: only a confirmed unplug re-arms it */
     uint8_t cand_ext, cand_charging, cand_n;
+    uint16_t run;         /* consecutive polls that read "charging" (saturates) */
+    uint16_t run_drop;    /* length of the charging run that ended most recently */
 } ms_power_t;
 
 static inline void ms_power_init(ms_power_t* p) { memset(p, 0, sizeof(*p)); }
@@ -222,6 +230,14 @@
         p->cand_n = 0;
         return MS_PWR_NONE;
     }
+    if (charging) {
+        if (p->run < 65535) {
+            p->run++;
+        }
+    } else if (p->run > 0) {
+        p->run_drop = p->run;  /* a charging run just ended: remember how long it was */
+        p->run = 0;
+    }
     if (ext == p->ext && charging == p->charging) {
         if (p->cand_n >= 3 && p->flaps < 255) {
             p->flaps++;  /* a change held for 3 s or more went back: a flapping reading */
@@ -249,12 +265,19 @@
     if (ext && !p->ext) {
         event = MS_PWR_PLUG;
         p->seen_charging = (uint8_t)charging;
+        p->full_announced = 0;
+        p->run_drop = 0;
     } else if (!ext && p->ext) {
         event = MS_PWR_UNPLUG;
         p->seen_charging = 0;
+        p->full_announced = 0;
+        p->run_drop = 0;
     } else if (ext && p->charging && !charging && p->seen_charging) {
-        event = MS_PWR_FULL;
         p->seen_charging = 0;
+        if (!p->full_announced && p->run_drop >= MS_PWR_FULL_MIN_RUN) {
+            event = MS_PWR_FULL;
+            p->full_announced = 1;
+        }
     } else if (charging) {
         p->seen_charging = 1;
     }
