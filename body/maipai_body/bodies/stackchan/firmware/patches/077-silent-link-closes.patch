# Intent: a hub link that goes silent no longer freezes the unit for minutes. The reconnect task waited forever for a disconnect event, so when a weak access point dropped data a send() on the main task blocked until TCP gave up (minutes): every tool call timed out and the host's own reboot request could not run (Fable review 2026-11-12, finding 1). The task now wakes every 5 s and, if nothing has arrived from the hub for 60 s, closes the socket so the blocked send fails and the loop reconnects. A ws_silent link event is pushed.
# Upstream: m5stack/StackChan firmware/xiaozhi-esp32/main/protocols/websocket_protocol.cc (MIT). Applies after 076.
# Check after a flash: switch the Wi-Fi router off for 90 s while the hub is up: the unit shows the Offline bubble within about a minute, does not reboot, and reconnects within 30 s of the router returning; the host log shows unit wifi ws_silent, then ws_up.
diff --git a/firmware/xiaozhi-esp32/main/protocols/websocket_protocol.cc b/firmware/xiaozhi-esp32/main/protocols/websocket_protocol.cc
--- a/firmware/xiaozhi-esp32/main/protocols/websocket_protocol.cc
+++ b/firmware/xiaozhi-esp32/main/protocols/websocket_protocol.cc
@@ -335,7 +335,29 @@
             }
             push_link_event("ws_up", 0, 0, 0, took_ms);
             TickType_t connected_at = xTaskGetTickCount();
-            EventBits_t bits = xEventGroupWaitBits(self->event_group_handle_, WEBSOCKET_PROTOCOL_DISCONNECTED_EVENT | WEBSOCKET_PROTOCOL_STOP_EVENT, pdTRUE, pdFALSE, portMAX_DELAY);
+            self->last_incoming_time_ = std::chrono::steady_clock::now();
+            // A link that goes silent (weak AP, dropped data) is closed here after kSilentLinkS so a
+            // blocked send() on the main task fails and the loop reconnects, instead of waiting for
+            // TCP to give up after minutes. The hub talks to the unit about twice a second.
+            EventBits_t bits = 0;
+            while (true) {
+                bits = xEventGroupWaitBits(self->event_group_handle_, WEBSOCKET_PROTOCOL_DISCONNECTED_EVENT | WEBSOCKET_PROTOCOL_STOP_EVENT, pdTRUE, pdFALSE, pdMS_TO_TICKS(5000));
+                if (bits & (WEBSOCKET_PROTOCOL_DISCONNECTED_EVENT | WEBSOCKET_PROTOCOL_STOP_EVENT)) {
+                    break;
+                }
+                constexpr int kSilentLinkS = 60;
+                const auto silent_s = std::chrono::duration_cast<std::chrono::seconds>(
+                    std::chrono::steady_clock::now() - self->last_incoming_time_).count();
+                if (silent_s >= kSilentLinkS) {
+                    ESP_LOGW(TAG, "Hub link silent for %d s, closing it to reconnect", static_cast<int>(silent_s));
+                    push_link_event("ws_silent", static_cast<unsigned>(silent_s), 0, 0, 0);
+                    auto ws = self->GetWebSocket();
+                    if (ws != nullptr) {
+                        ws->Close();
+                    }
+                    self->last_incoming_time_ = std::chrono::steady_clock::now();
+                }
+            }
             if (bits & WEBSOCKET_PROTOCOL_STOP_EVENT) {
                 break;
             }
