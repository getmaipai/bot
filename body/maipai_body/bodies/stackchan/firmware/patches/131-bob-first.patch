+// The first stage of a music session (owner 2026-11-14): the head nods up and down on the beat, for a while,
+// before the full dance with the looking around and the lights.
+void maipai_music_bob_start()
+{
+    LvglLockGuard lock;
+    if (s_dance_modifier_id >= 0) {
+        GetStackChan().removeModifier(s_dance_modifier_id);
+        s_dance_modifier_id = -1;
+    }
+    s_dance_modifier_id = GetStackChan().addModifier(std::make_unique<BeatSwayModifier>(true));
+}
