# Intent: the break between dance blocks is a slow mood, not a stop (owner 2026-11-13: "a 90 second break is crazy ... you can have it go into slow mood for 90 seconds but not just not dance; it should only not dance if it is paused or there is no music"). On MMJ_ACTION_BREAK the unit keeps the gentle sway running with one note instead of stopping the dance; the dance still ends on the end action (music gone for 60 s), mute, quiet, a turn or low battery. The 90 s gap in the session machine now only marks when the next full block starts.
# Upstream: MaiPai only (hal_music.cpp). Applies after 125.
# Check after a flash: with Home stopped, a long song: the dance never fully stops while music plays; one note during the slow mood.
diff --git a/firmware/main/hal/hal_music.cpp b/firmware/main/hal/hal_music.cpp
--- a/firmware/main/hal/hal_music.cpp
+++ b/firmware/main/hal/hal_music.cpp
@@ -159,16 +159,22 @@
             ESP_LOGI("HAL-Music", "offline music: dance");
         }
     } else if (action == MMJ_ACTION_BREAK) {
+        // The slow mood between dance blocks (owner 2026-11-13: "not just not dance"): the gentle sway goes on with
+        // one note until the next full dance.
+        offline_music_notes(dancing ? 1 : 0);
+        ESP_LOGI("HAL-Music", "offline music: slow mood");
+    } else if (action == MMJ_ACTION_PAUSE) {
+        // No music for a moment: no dance. It starts again when clear music returns.
         if (dancing) {
             maipai_music_dance_stop();
             dancing = false;
         }
         offline_music_notes(0);
-        ESP_LOGI("HAL-Music", "offline music: break");
+        ESP_LOGI("HAL-Music", "offline music: paused, no music");
     } else if (action == MMJ_ACTION_END) {
         stop_all("music stopped");
     } else if (dancing) {
-        offline_music_notes(3);  // keep the notes hopping (they hide on their own 30 s after the last call)
+        offline_music_notes(session.state == 4 ? 1 : 3);  // keep the notes hopping (they hide 30 s after the last call)
     }
 }
 
diff --git a/firmware/main/hal/maipai_music_judge.h b/firmware/main/hal/maipai_music_judge.h
--- a/firmware/main/hal/maipai_music_judge.h
+++ b/firmware/main/hal/maipai_music_judge.h
@@ -74,15 +74,17 @@
     return mmj_make(1, MMJ_MUSIC);
 }
 
-typedef enum { MMJ_ACTION_NONE, MMJ_ACTION_NOD, MMJ_ACTION_DANCE, MMJ_ACTION_BREAK, MMJ_ACTION_END } mmj_action_t;
+typedef enum { MMJ_ACTION_NONE, MMJ_ACTION_NOD, MMJ_ACTION_DANCE, MMJ_ACTION_BREAK, MMJ_ACTION_PAUSE, MMJ_ACTION_END } mmj_action_t;
 
 /* The unit's own music session (no hub), the same cycles as the host's music_dance.py: the slow start (the nod,
  * then the dance 20 s later), a dance block (5 minutes charging, 2 minutes on battery: mmj_session_set_block_ms),
- * a 90 s break, the dance again, and so on for as long as the music goes on. A gap of 60 s ends the session. No
- * hourly or daily caps. The caller stops the dance on BREAK and END. */
+ * then the SLOW MOOD for 90 s (MMJ_ACTION_BREAK: the gentle sway goes on, it does not stop), then the dance again,
+ * and so on for as long as the music goes on. No music for 9 s pauses the dance (MMJ_ACTION_PAUSE: the caller stops
+ * it; it starts again as soon as clear music returns); a gap of 60 s ends the session (MMJ_ACTION_END). No hourly
+ * or daily caps. The caller stops the dance on PAUSE and END only. */
 typedef struct {
     uint32_t run_start, last_music, nod_at, block_at, break_at, last_end, block_ms;
-    uint8_t state; /* 0 idle, 1 nod and watch, 2 dancing, 3 break */
+    uint8_t state; /* 0 idle, 1 nod and watch, 2 dancing, 3 paused (no music), 4 slow mood */
     uint8_t has_music, has_end;
 } mmj_session_t;
 
@@ -117,20 +119,29 @@
             return MMJ_ACTION_DANCE;
         }
         return MMJ_ACTION_NONE;
-    case 2:
+    case 2: /* dancing */
         if (silence >= MMJ_SESSION_GAP_MS) { s->state = 0; s->last_end = now_ms; s->has_end = 1; return MMJ_ACTION_END; }
-        if (silence >= MMJ_END_SILENCE_MS || mmj_elapsed(now_ms, s->block_at) >= s->block_ms) {
-            s->state = 3; s->break_at = now_ms;
+        if (silence >= MMJ_END_SILENCE_MS) { s->state = 3; return MMJ_ACTION_PAUSE; }
+        if (mmj_elapsed(now_ms, s->block_at) >= s->block_ms) {
+            s->state = 4; s->break_at = now_ms;
             return MMJ_ACTION_BREAK;
         }
         return MMJ_ACTION_NONE;
-    default: /* 3: break */
+    case 4: /* the slow mood */
         if (silence >= MMJ_SESSION_GAP_MS) { s->state = 0; s->last_end = now_ms; s->has_end = 1; return MMJ_ACTION_END; }
+        if (silence >= MMJ_END_SILENCE_MS) { s->state = 3; return MMJ_ACTION_PAUSE; }
         if (music && mmj_elapsed(now_ms, s->break_at) >= MMJ_BREAK_MS) {
             s->state = 2; s->block_at = now_ms;
