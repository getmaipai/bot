+    default: /* 3: paused, no music */
+        if (silence >= MMJ_SESSION_GAP_MS) { s->state = 0; s->last_end = now_ms; s->has_end = 1; return MMJ_ACTION_END; }
+        if (music) {
+            s->state = 2; s->block_at = now_ms;
+            return MMJ_ACTION_DANCE;
+        }
+        return MMJ_ACTION_NONE;
     }
 }
 
