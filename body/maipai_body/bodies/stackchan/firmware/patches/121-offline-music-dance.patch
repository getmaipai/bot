+void offline_music_step(const mm_feat_t& f)
+{
+    static mmj_session_t session;
+    static bool initialized = false;
+    static bool dancing = false;
+    if (!initialized) {
+        mmj_session_init(&session);
+        initialized = true;
+    }
+    if (hal_bridge::hub_link_up()) {
+        if (dancing) {
+            maipai_music_dance_stop();
+            ESP_LOGI("HAL-Music", "offline music: end (hub link up)");
+            dancing = false;
+        }
+        mmj_session_init(&session);
+        return;
+    }
+    if (!s_enabled.load()) {
+        if (dancing) {
+            maipai_music_dance_stop();
+            ESP_LOGI("HAL-Music", "offline music: end (features off)");
+            dancing = false;
+        }
+        mmj_session_init(&session);
+        return;
+    }
+    Application& app = Application::GetInstance();
+    const DeviceState state = app.GetDeviceState();
+    const bool busy = state == kDeviceStateListening || state == kDeviceStateSpeaking ||
+                      state == kDeviceStateConnecting || state == kDeviceStateUpgrading ||
+                      state == kDeviceStateAudioTesting;
+    const bool charging = GetHAL().isBatteryCharging();
+    const int battery = GetHAL().getBatteryLevel();
+    const bool blocked = maipai_muted() || maipai_quiet() || busy ||
+                         (!charging && battery < 20);
+    if (blocked) {
+        if (dancing) {
+            maipai_music_dance_stop();
+            ESP_LOGI("HAL-Music", "offline music: end (safety gate)");
+            dancing = false;
+        }
+        mmj_session_init(&session);
+        return;
+    }
 
+    mmj_feat_t input = {f.lv, f.bpm, f.tc, f.fl, f.mo, f.ps, 0};
+    const mmj_verdict_t verdict = mmj_judge(&input, MMJ_SENS_MEDIUM, session.state != 0);
+    const mmj_action_t action = mmj_session_step(&session,
+        static_cast<uint32_t>(esp_timer_get_time() / 1000), verdict.music);
+    if (dancing && !charging && battery < 40) {
+        maipai_music_dance_stop();
+        dancing = false;
+        mmj_session_init(&session);
+        ESP_LOGI("HAL-Music", "offline music: end (battery below dance threshold)");
+        return;
+    }
+    if (action == MMJ_ACTION_NOD && (charging || battery >= 20)) {
+        ESP_LOGI("HAL-Music", "offline music: nod");
+        LvglLockGuard lock;
+        auto* display = Board::GetInstance().GetDisplay();
+        if (display != nullptr) display->SetEmotion("happy");
+    } else if (action == MMJ_ACTION_DANCE && (charging || battery >= 40)) {
+        maipai_music_dance_start();
+        dancing = true;
+        ESP_LOGI("HAL-Music", "offline music: dance");
+    } else if (action == MMJ_ACTION_END) {
+        if (dancing) maipai_music_dance_stop();
+        dancing = false;
+        ESP_LOGI("HAL-Music", "offline music: end (music stopped)");
+    }
+}
