+// Shared by the MCP tools and the offline music worker. These wrappers keep the host-driven tool
+// behavior unchanged while letting the worker invoke the same firmware actions.
+void maipai_music_dance_start()
+{
+    LvglLockGuard lock;
+    if (s_dance_modifier_id >= 0) {
+        GetStackChan().removeModifier(s_dance_modifier_id);
+        s_dance_modifier_id = -1;
+    }
+    s_dance_modifier_id = GetStackChan().addModifier(std::make_unique<DanceModifier>(DanceModifier::Happy));
+}
+
+void maipai_music_dance_stop()
+{
+    LvglLockGuard lock;
+    if (s_dance_modifier_id >= 0) {
+        GetStackChan().removeModifier(s_dance_modifier_id);
+        s_dance_modifier_id = -1;
+    }
+}
