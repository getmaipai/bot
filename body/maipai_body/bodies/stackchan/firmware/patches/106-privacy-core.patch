new file mode 100644
index 0000000..9c721b0
--- /dev/null
+++ b/firmware/main/hal/maipai_privacy.h
@@ -0,0 +1,43 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The unit's three privacy states (patch 106), independent and combinable:
+ *   mute         no listening: the wake word, the stop word, voice processing and the microphone chip are off,
+ *                and nothing can turn them on until the unit is unmuted. The unit stays alive (face, link, charge).
+ *   vision off   the camera is not read: no frame is captured, none is sent.
+ *   full quiet   no movement (the servos hold), no sound out (the speaker is silent) and no listening
+ *                (the microphone is off exactly as for mute). Vision keeps whatever it was.
+ * The state is saved in the unit's own NVS namespace "maipai_priv" and restored at boot. The unit is the
+ * authority: the host reads it back and never assumes it.
+ */
+#pragma once
+#include <cstddef>
+
+enum MaipaiPrivacyBit { kPrivMute = 1, kPrivVision = 2, kPrivQuiet = 4 };
+
+// Read from every task; the first call reads the saved state.
+int maipai_privacy_bits();
+bool maipai_muted();
+bool maipai_vision_off();
+bool maipai_quiet();
+// True while nothing may open, feed or read the microphone (mute or full quiet).
+bool maipai_mic_blocked();
+
+// Changes the bits in `mask` to those in `value`. `source` is "face", "home" or "boot". Returns false when
+// the change is refused (the face may not unmute or leave quiet while local_unmute is off). `bits_out`, if
+// given, gets the state after the call. The saving and the microphone work run on the main task; the face
+// is the caller's to redraw (hal_bridge::display_apply_privacy_face), because LVGL calls arrive locked.
+bool maipai_privacy_set(int mask, int value, const char* source, int* bits_out);
+// Whether the unit's own face may unmute (default true); saved.
+void maipai_privacy_set_local_unmute(bool allowed);
+// Once the unit is up (the display ready): makes the saved state true (microphone off and read back).
+void maipai_privacy_boot();
+// JSON members without braces: muted, vision_off, quiet, mic_off, mic_off_verified, mute_source, local_unmute, mic_regs.
+void maipai_privacy_report(char* out, size_t size);
+// The short form for the minute report: muted, vision_off, quiet, mic_off_verified.
+void maipai_privacy_report_short(char* out, size_t size);
+// True once the microphone chip has been powered down and the read-back matched.
+bool maipai_privacy_mic_verified();
+// Counts a camera capture skipped because vision is off (hal_ws_avatar.cpp reports it).
+void maipai_privacy_note_cam_skip();
+unsigned maipai_privacy_take_cam_skips();
