diff --git a/firmware/main/hal/maipai_privacy.cpp b/firmware/main/hal/maipai_privacy.cpp
new file mode 100644
index 0000000..ded53b6
--- /dev/null
+++ b/firmware/main/hal/maipai_privacy.cpp
@@ -0,0 +1,225 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Mute, vision off and full quiet (patch 106). See maipai_privacy.h.
+ */
+#include "maipai_privacy.h"
+#include "device_events.h"
+#include "board/cores3_audio_codec.h"
+#include "board/hal_bridge.h"
+#include <application.h>
+#include <settings.h>
+#include <esp_log.h>
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+
+#define TAG "MAIPAI-PRIVACY"
+
+namespace {
+std::atomic<int> s_bits{0};
+std::atomic<bool> s_local_unmute{true};
+std::atomic<bool> s_mic_off_verified{false};
+std::atomic<unsigned> s_cam_skips{0};
+std::once_flag s_loaded;
+std::mutex s_mutex;
+char s_source[8]  = "boot";
+char s_regs[64]   = "";
+const char* kNamespace = "maipai_priv";
+
+void load_once()
+{
+    std::call_once(s_loaded, []() {
+        Settings settings(kNamespace, false);
+        int bits = 0;
+        if (settings.GetInt("mute", 0) != 0) {
+            bits |= kPrivMute;
+        }
+        if (settings.GetInt("vision", 0) != 0) {
+            bits |= kPrivVision;
+        }
+        if (settings.GetInt("quiet", 0) != 0) {
+            bits |= kPrivQuiet;
+        }
+        s_bits.store(bits);
+        s_local_unmute.store(settings.GetInt("local_unmute", 1) != 0);
+        ESP_LOGI(TAG, "saved state: mute=%d vision_off=%d quiet=%d local_unmute=%d", (bits & kPrivMute) ? 1 : 0,
+                 (bits & kPrivVision) ? 1 : 0, (bits & kPrivQuiet) ? 1 : 0, s_local_unmute.load() ? 1 : 0);
+    });
+}
+
+void save(int bits)
+{
+    Settings settings(kNamespace, true);
+    settings.SetInt("mute", (bits & kPrivMute) ? 1 : 0);
+    settings.SetInt("vision", (bits & kPrivVision) ? 1 : 0);
+    settings.SetInt("quiet", (bits & kPrivQuiet) ? 1 : 0);
+}
+
+CoreS3AudioCodec* codec()
+{
+    return CoreS3AudioCodec::Instance();
+}
+
+void announce(const char* source)
+{
+    char extra[256];
+    maipai_privacy_report(extra, sizeof(extra));
+    // A real event (not a diagnostic): it must reach the host at once and is never rate limited.
+    char with_source[300];
+    snprintf(with_source, sizeof(with_source), "%s,\"source\":\"%s\"", extra, source);
+    device_events_push("privacy", with_source);
+    ESP_LOGI(TAG, "state: %s (source %s)", extra, source);
+}
+
+// Runs on the main task: the saving, then the microphone, then the report.
+void apply(int bits, int old_bits, std::string source)
+{
+    save(bits);
+    const bool mic_off     = (bits & (kPrivMute | kPrivQuiet)) != 0;
+    const bool was_mic_off = (old_bits & (kPrivMute | kPrivQuiet)) != 0;
+    auto& app              = Application::GetInstance();
+    auto& audio            = app.GetAudioService();
+    if (mic_off) {
+        // Stop what is listening, then the wake word, the stop word and voice processing, then the chip.
+        const auto state = app.GetDeviceState();
+        if (state == kDeviceStateListening || state == kDeviceStateConnecting) {
+            app.StopListening();
+        }
+        audio.SetStopWordArmed(false);
+        audio.EnableVoiceProcessing(false);
+        audio.EnableWakeWordDetection(false);
+        if (auto* c = codec()) {
+            const bool verified = c->MaipaiMicOff(s_regs, sizeof(s_regs));
+            s_mic_off_verified.store(verified);
+            ESP_LOGI(TAG, "microphone off, read back %s (%s)", verified ? "verified" : "NOT verified", s_regs);
+        }
+    } else if (was_mic_off) {
+        s_mic_off_verified.store(false);
+        s_regs[0] = '\0';
+        // The audio task opens the microphone again on its own; the wake word is armed for an idle unit.
+        const auto state = app.GetDeviceState();
+        if (state == kDeviceStateIdle || state == kDeviceStateUnknown) {
+            audio.EnableWakeWordDetection(true);
+        }
+    }
+    if ((bits & kPrivQuiet) && !(old_bits & kPrivQuiet)) {
+        // Quiet starts: stop what is being said (the speaker is already dropping what is left).
+        if (app.GetDeviceState() == kDeviceStateSpeaking) {
+            app.AbortSpeaking(kAbortReasonNone);
+        }
+    }
+    announce(source.c_str());
+}
+}  // namespace
+
+int maipai_privacy_bits()
+{
+    load_once();
+    return s_bits.load();
+}
+bool maipai_muted()
+{
+    return (maipai_privacy_bits() & kPrivMute) != 0;
+}
+bool maipai_vision_off()
+{
+    return (maipai_privacy_bits() & kPrivVision) != 0;
+}
+bool maipai_quiet()
+{
+    return (maipai_privacy_bits() & kPrivQuiet) != 0;
+}
+bool maipai_mic_blocked()
+{
+    return (maipai_privacy_bits() & (kPrivMute | kPrivQuiet)) != 0;
+}
+
+bool maipai_privacy_set(int mask, int value, const char* source, int* bits_out)
+{
+    load_once();
+    std::string src = source != nullptr ? source : "home";
+    int old_bits;
+    int bits;
+    {
+        std::lock_guard<std::mutex> lock(s_mutex);
+        old_bits = s_bits.load();
+        bits     = (old_bits & ~mask) | (value & mask);
+        if (bits_out != nullptr) {
+            *bits_out = old_bits;
+        }
+        if (bits == old_bits) {
+            return true;
+        }
+        // The unit's own face may only turn listening back on while the household allows it.
+        const bool turns_listening_on = (old_bits & (kPrivMute | kPrivQuiet)) & ~bits;
+        if (src == "face" && turns_listening_on && !s_local_unmute.load()) {
+            ESP_LOGW(TAG, "face unmute refused: only the hub may unmute (local_unmute is off)");
+            device_events_push("privacy_refused", "\"why\":\"local_unmute_off\"");
+            return false;
+        }
+        s_bits.store(bits);  // the guards see it at once, before the main task does anything
+        snprintf(s_source, sizeof(s_source), "%.7s", src.c_str());
+    }
+    if (bits_out != nullptr) {
+        *bits_out = bits;
+    }
+    Application::GetInstance().Schedule([bits, old_bits, src]() { apply(bits, old_bits, src); });
+    return true;
+}
+
+void maipai_privacy_set_local_unmute(bool allowed)
+{
+    load_once();
+    if (s_local_unmute.exchange(allowed) != allowed) {
+        Application::GetInstance().Schedule([allowed]() {
+            Settings settings(kNamespace, true);
+            settings.SetInt("local_unmute", allowed ? 1 : 0);
+        });
+    }
+}
+
+void maipai_privacy_boot()
+{
+    const int bits = maipai_privacy_bits();
+    if (bits == 0) {
+        return;
+    }
+    snprintf(s_source, sizeof(s_source), "boot");
+    Application::GetInstance().Schedule([bits]() { apply(bits, 0, "boot"); });
+}
+
+void maipai_privacy_report(char* out, size_t size)
+{
+    const int bits = maipai_privacy_bits();
+    snprintf(out, size,
+             "\"muted\":%d,\"vision_off\":%d,\"quiet\":%d,\"mic_off\":%d,\"mic_off_verified\":%d,"
+             "\"mute_source\":\"%s\",\"local_unmute\":%d,\"mic_regs\":\"%s\"",
+             (bits & kPrivMute) ? 1 : 0, (bits & kPrivVision) ? 1 : 0, (bits & kPrivQuiet) ? 1 : 0,
+             (bits & (kPrivMute | kPrivQuiet)) ? 1 : 0, s_mic_off_verified.load() ? 1 : 0, s_source,
+             s_local_unmute.load() ? 1 : 0, s_regs);
+}
+
+void maipai_privacy_report_short(char* out, size_t size)
+{
+    const int bits = maipai_privacy_bits();
+    snprintf(out, size, "\"muted\":%d,\"vision_off\":%d,\"quiet\":%d,\"mic_off_verified\":%d",
+             (bits & kPrivMute) ? 1 : 0, (bits & kPrivVision) ? 1 : 0, (bits & kPrivQuiet) ? 1 : 0,
+             s_mic_off_verified.load() ? 1 : 0);
+}
+
+bool maipai_privacy_mic_verified()
+{
+    return s_mic_off_verified.load();
+}
+
+void maipai_privacy_note_cam_skip()
+{
+    s_cam_skips++;
+}
+unsigned maipai_privacy_take_cam_skips()
+{
+    return s_cam_skips.exchange(0);
+}
