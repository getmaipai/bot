+// Patch 106. The ES7210 registers the stop sequence of esp_codec_dev writes (es7210_stop): the four and two
+// microphone power registers to 0xff, the analog register to 0xc0, the clock-off register to 0x7f and the
+// power-down register to 0x07. They are written again by hand here because the chip may never have been
+// started (nothing to stop) or may have been closed by the idle timer; then they are read back. Only the
+// power registers and the power-down register decide "verified": the others are reported so the first
+// run on a unit shows what a powered-down chip really reads.
+bool CoreS3AudioCodec::MaipaiMicOff(char* regs, size_t regs_size) {
+    if (input_enabled_) {
+        EnableInput(false);  // esp_codec_dev_close: the chip's own stop, and input_enabled_ goes false
+    }
+    static const int kPower[] = {0x47, 0x48, 0x49, 0x4A, 0x4B, 0x4C};
+    bool ok = in_codec_if_ != nullptr && in_codec_if_->set_reg != nullptr && in_codec_if_->get_reg != nullptr;
+    if (ok) {
+        for (int reg : kPower) {
+            in_codec_if_->set_reg(in_codec_if_, reg, 0xff);
+        }
+        in_codec_if_->set_reg(in_codec_if_, 0x40, 0xc0);
+        in_codec_if_->set_reg(in_codec_if_, 0x01, 0x7f);
+        in_codec_if_->set_reg(in_codec_if_, 0x06, 0x07);
+    }
+    char line[96] = "";
+    size_t used = 0;
+    auto note = [&](int reg, int value) {
+        used += snprintf(line + used, sizeof(line) - used, "%s%02x:%02x", used == 0 ? "" : ",", reg, value & 0xff);
+    };
+    for (int reg : kPower) {
+        int value = 0;
+        if (!ok || in_codec_if_->get_reg(in_codec_if_, reg, &value) != 0) {
+            ok = false;
+            value = -1;
+        } else if ((value & 0xff) != 0xff) {
+            ok = false;
+        }
+        note(reg, value);
+    }
+    int value = 0;
+    if (in_codec_if_ != nullptr && in_codec_if_->get_reg != nullptr && in_codec_if_->get_reg(in_codec_if_, 0x06, &value) == 0) {
+        if ((value & 0x07) != 0x07) {
+            ok = false;
+        }
+        note(0x06, value);
+    } else {
+        ok = false;
+    }
+    if (in_codec_if_ != nullptr && in_codec_if_->get_reg != nullptr && in_codec_if_->get_reg(in_codec_if_, 0x01, &value) == 0) {
+        note(0x01, value);
+    }
+    if (in_codec_if_ != nullptr && in_codec_if_->get_reg != nullptr && in_codec_if_->get_reg(in_codec_if_, 0x40, &value) == 0) {
+        note(0x40, value);
+    }
+    if (regs != nullptr && regs_size > 0) {
+        snprintf(regs, regs_size, "%s", line);
+    }
+    return ok;
+}
