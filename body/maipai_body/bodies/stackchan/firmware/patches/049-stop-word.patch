+// ---- the stop word (patch 049) -------------------------------------------------------------
+//
+// A small MultiNet command list ("stop", "be quiet", ...) runs on the same echo-cancelled audio as
+// the wake word, but only while the robot is speaking. A hit aborts the reply. The model's own
+// threshold is kept low so near-misses can be logged; a hit counts only above kAcceptProb. All
+// commands mean "stop", so a close second candidate is the same intent and is no reason to refuse.
+// Only fixed command names are logged, never audio or text.
+namespace {
+constexpr float kModelThreshold = 0.5f;
+constexpr float kAcceptProb = 0.85f;
+constexpr int64_t kHitCooldownUs = 1500 * 1000;
+// Internal RAM is the limit (lowest seen in a session: 12.5 KB). The model may cost at most this
+// much of it, and arming is refused below this much free.
+constexpr size_t kMaxModelInternalCost = 6 * 1024;
+constexpr size_t kArmMinFreeInternal = 16 * 1024;
+
+struct StopCommand {
+    const char* name;
+    const char* phonemes;  // from multinet_g2p.py (esp-sr tool), English
+};
+constexpr StopCommand kStopCommands[] = {
+    {"stop", "STnP"},
+    {"stackchan stop", "STaK paN STnP"},
+    {"be quiet", "Bm KWicT"},
+    {"quiet", "KWicT"},
+    {"that's enough", "jaTS gNcF"},
+    {"never mind", "NfVk MiND"},
+    {"cancel", "KaNScL"},
+};
+}  // namespace
+
+void AfeWakeWord::InitStopWord() {
+    const char* mn_name = esp_srmodel_filter(models_, ESP_MN_PREFIX, ESP_MN_ENGLISH);
+    if (mn_name == nullptr) {
+        ESP_LOGI(TAG, "Stop word off: no English command-word model in the assets");
+        stop_disabled_ = true;
+        return;
+    }
+    size_t before = heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
+    mn_ = esp_mn_handle_from_name(const_cast<char*>(mn_name));
+    mn_data_ = mn_ != nullptr ? mn_->create(mn_name, 2000) : nullptr;
+    if (mn_data_ == nullptr) {
+        ESP_LOGW(TAG, "Stop word off: the command-word model did not start");
+        stop_disabled_ = true;
+        return;
+    }
+    size_t after = heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
+    size_t cost = before > after ? before - after : 0;
+    ESP_LOGI(TAG, "Stop word model %s: internal RAM %u -> %u bytes (cost %u)", mn_name,
+             static_cast<unsigned>(before), static_cast<unsigned>(after), static_cast<unsigned>(cost));
+    if (cost > kMaxModelInternalCost) {
+        ESP_LOGW(TAG, "Stop word off: it would use %u bytes of internal RAM (limit %u)",
+                 static_cast<unsigned>(cost), static_cast<unsigned>(kMaxModelInternalCost));
+        mn_->destroy(mn_data_);
+        mn_data_ = nullptr;
+        stop_disabled_ = true;
+        char extra[64];
+        snprintf(extra, sizeof(extra), "\"state\":\"off\",\"cost\":%u", static_cast<unsigned>(cost));
+        device_events_push_diag("stop_word", extra);
+        return;
+    }
+    mn_->set_det_threshold(mn_data_, kModelThreshold);
+    esp_mn_commands_clear();
+    int id = 1;
+    for (const auto& command : kStopCommands) {
+        esp_mn_commands_phoneme_add(id++, command.name, command.phonemes);
+    }
+    esp_mn_error_t* errors = esp_mn_commands_update();
+    if (errors != nullptr && errors->num > 0) {
+        ESP_LOGW(TAG, "Stop word: %d command(s) could not be added", errors->num);
+    }
+    ESP_LOGI(TAG, "Stop word ready: %d commands, accept at %.2f", id - 1, kAcceptProb);
+    char extra[64];
+    snprintf(extra, sizeof(extra), "\"state\":\"ready\",\"cost\":%u", static_cast<unsigned>(cost));
+    device_events_push_diag("stop_word", extra);
+}
+
+void AfeWakeWord::SetStopWordArmed(bool armed) {
+    if (armed) {
+        if (mn_data_ == nullptr || stop_disabled_) {
+            return;
+        }
+        size_t free_internal = heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
+        if (free_internal < kArmMinFreeInternal) {
+            ESP_LOGW(TAG, "Stop word not armed: only %u bytes of internal RAM free",
+                     static_cast<unsigned>(free_internal));
+            return;
+        }
+    }
+    stop_armed_ = armed;
+}
+
+void AfeWakeWord::StopWordStep(const int16_t* data, size_t samples) {
+    int chunk = mn_->get_samp_chunksize(mn_data_);
+    stop_buffer_.insert(stop_buffer_.end(), data, data + samples);
+    while (chunk > 0 && stop_buffer_.size() >= static_cast<size_t>(chunk)) {
+        esp_mn_state_t state = mn_->detect(mn_data_, stop_buffer_.data());
+        stop_buffer_.erase(stop_buffer_.begin(), stop_buffer_.begin() + chunk);
+        if (state == ESP_MN_STATE_TIMEOUT) {
+            mn_->clean(mn_data_);
+        } else if (state == ESP_MN_STATE_DETECTED) {
+            esp_mn_results_t* results = mn_->get_results(mn_data_);
+            if (results != nullptr && results->num > 0) {
+                int id = results->command_id[0];
+                float prob = results->prob[0];
+                float second = results->num > 1 ? results->prob[1] : 0.0f;
+                bool accepted = prob >= kAcceptProb;
+                int64_t now = esp_timer_get_time();
+                if (accepted && now - stop_last_hit_us_ < kHitCooldownUs) {
+                    accepted = false;
+                }
+                const char* name = (id >= 1 && id <= static_cast<int>(sizeof(kStopCommands) / sizeof(kStopCommands[0])))
+                                       ? kStopCommands[id - 1].name
+                                       : "?";
+                ESP_LOGI(TAG, "Stop word: heard '%s' score %.2f second %.2f -> %s", name, prob, second,
+                         accepted ? "accepted" : "rejected");
+                char extra[96];
+                snprintf(extra, sizeof(extra), "\"cmd\":\"%s\",\"score\":%d,\"second\":%d,\"accepted\":%s", name,
+                         static_cast<int>(prob * 100), static_cast<int>(second * 100), accepted ? "true" : "false");
+                device_events_push_diag("stop_word", extra);
+                if (accepted) {
+                    stop_last_hit_us_ = now;
+                    stop_armed_ = false;
+                    if (stop_word_callback_) {
+                        stop_word_callback_();
+                    }
+                }
+            }
+            mn_->clean(mn_data_);
+            stop_buffer_.clear();
+            return;
+        }
+    }
+}
+
@@ -151,0 +302,11 @@ void AfeWakeWord::AudioDetectionTask() {
+        // The stop word listens to the same cleaned audio, but only while the robot speaks.
+        bool stop_armed = stop_armed_.load();
+        if (stop_armed && mn_data_ != nullptr) {
+            if (!stop_was_armed_) {
+                mn_->clean(mn_data_);
+                stop_buffer_.clear();
+            }
+            StopWordStep(res->data, res->data_size / sizeof(int16_t));
+        }
+        stop_was_armed_ = stop_armed;
+
