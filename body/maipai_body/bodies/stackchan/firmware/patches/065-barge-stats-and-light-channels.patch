+// Barge-in measurement: how loud the echo-cancelled microphone is while the robot speaks, and how
+// often the voice detector fires then. Set from the application's state change, reported once a
+// minute by device_events_barge_stats. Compare a minute with nobody talking over a reply against a
+// minute with a person talking over it.
+std::atomic<bool> g_barge_speaking{false};
+static std::atomic<uint32_t> s_barge_chunks{0};
+static std::atomic<uint32_t> s_barge_vad{0};
+static std::atomic<uint32_t> s_barge_rms_sum{0};
+static std::atomic<uint32_t> s_barge_rms_max{0};
+static std::atomic<uint32_t> s_barge_bin[5] = {};  // chunks with rms under 150, 400, 1000, 2500, above
+
+static void barge_step(const int16_t* data, size_t samples, bool vad)
+{
+    if (samples == 0) {
+        return;
+    }
+    uint64_t sum = 0;
+    for (size_t i = 0; i < samples; i++) {
+        sum += static_cast<int64_t>(data[i]) * data[i];
+    }
+    const uint32_t rms = static_cast<uint32_t>(std::sqrt(static_cast<double>(sum) / samples));
+    s_barge_chunks++;
+    s_barge_rms_sum += rms;
+    if (vad) {
+        s_barge_vad++;
+    }
+    uint32_t prev = s_barge_rms_max.load();
+    while (rms > prev && !s_barge_rms_max.compare_exchange_weak(prev, rms)) {
+    }
+    s_barge_bin[rms < 150 ? 0 : rms < 400 ? 1 : rms < 1000 ? 2 : rms < 2500 ? 3 : 4]++;
+}
+
+void device_events_barge_stats(char* out, size_t size)
+{
+    const uint32_t chunks = s_barge_chunks.exchange(0);
+    const uint32_t sum    = s_barge_rms_sum.exchange(0);
+    snprintf(out, size,
+             "\"chunks\":%u,\"vad\":%u,\"rms_avg\":%u,\"rms_max\":%u,\"lt150\":%u,\"lt400\":%u,"
+             "\"lt1000\":%u,\"lt2500\":%u,\"ge2500\":%u",
+             static_cast<unsigned>(chunks), static_cast<unsigned>(s_barge_vad.exchange(0)),
+             static_cast<unsigned>(chunks ? sum / chunks : 0), static_cast<unsigned>(s_barge_rms_max.exchange(0)),
+             static_cast<unsigned>(s_barge_bin[0].exchange(0)), static_cast<unsigned>(s_barge_bin[1].exchange(0)),
+             static_cast<unsigned>(s_barge_bin[2].exchange(0)), static_cast<unsigned>(s_barge_bin[3].exchange(0)),
+             static_cast<unsigned>(s_barge_bin[4].exchange(0)));
+}
