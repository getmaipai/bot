+// One place decides what the link looks like from what the unit knows; called under the display lock.
+void StackChanAvatarDisplay::ApplyLink()
+{
+    const LinkLook look = boot_done_ ? LinkLook::None : boot_look_;
+    if (look == LinkLook::None) {
+        HideLinkScreen();
+    } else {
+        ShowLinkScreen(look);
+    }
+    // The ring is dark unless the unit needs a person (Wi-Fi setup, waiting for approval).
+    const bool ring = look == LinkLook::WifiSetup || look == LinkLook::Approval;
+    if (!ring) {
+        SetLinkRing(false);
+    }
+    UpdateLinkTimer();
+}
