+// The timer runs only while something animates: the Wi-Fi bars, or the ring's blink.
+void StackChanAvatarDisplay::UpdateLinkTimer()
+{
+    const bool need = link_look_ == LinkLook::WifiJoin || link_look_ == LinkLook::HomeJoin ||
+                      link_look_ == LinkLook::WifiSetup || link_look_ == LinkLook::Approval;
+    if (need && link_timer_ == nullptr) {
+        link_timer_ = lv_timer_create(LinkTick, 100, this);
+    } else if (!need && link_timer_ != nullptr) {
+        lv_timer_delete(link_timer_);
+        link_timer_ = nullptr;
+    }
+}
