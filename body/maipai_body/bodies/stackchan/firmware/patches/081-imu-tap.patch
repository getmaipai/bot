@@ -19,0 +21 @@
+#include <esp_timer.h>
@@ -22,0 +25,39 @@ static const std::string_view _tag = "HAL-IMU";
+// Head tap (patch 081). The sensor is read every 10 ms (its own rate is 100 Hz; the old task read it
+// every 100 ms and could not see a tap). A tap on the head is a short jolt on a still body: one
+// sample whose change from the previous one (the three axes' changes added, the shake detector's
+// measure) is at least kTapJoltMin, after kTapQuietSamples samples whose changes all stayed under
+// kTapQuietMax. The time and size of the latest jolt are shared with the head strip task
+// (hal_head_touch.cpp), which turns a strip contact near it into a tap; a jolt alone (a bump on the
+// desk, a nudge) is never a touch. Measured 2026-11-12 on the unit: at rest the change stays under
+// 0.1 m/s^2 and reached 0.46 once in ten minutes; a servo move (looking around) runs 1.7 to 2.8 for
+// seconds at a time and is never quiet before, so it cannot arm a jolt.
+// Measured 2026-11-12 (owner): 10 light taps on the strip jolted 1.1 to 4.6; 15 light taps on the
+// front shell above the screen 2.0 to 7.8; five slaps on the desk beside the unit 2.3 to 4.4;
+// typing beside it under 0.5; a pick-up starts under 0.5; a put-down is big but never still
+// before. The unit's own head moves can start with a jerk of 3 to 5, so jolts are ignored for
+// kServoBlankUs after any servo command (hal_servo.cpp). A tap by the motion sensor alone (a jolt
+// of kFrontTapJoltMin that no strip contact claims within kFrontTapWaitUs, "front tap") is built
+// but OFF: a desk slap beside the unit is the same size as a light tap on the shell, and only the
+// gyro told them apart (3 to 6 against 13 to 29 deg/s) on five taps, too few to ship on.
+constexpr float kTapJoltMin      = 1.0f;   // m/s^2, with a strip contact
+constexpr float kTapQuietMax     = 0.4f;   // m/s^2: a change under this is "still"
+constexpr int kTapQuietSamples   = 15;     // 150 ms still before the jolt
+constexpr bool kFrontTapEnabled  = false;
+constexpr float kFrontTapJoltMin = 2.0f;   // m/s^2, with no strip contact
+constexpr int64_t kFrontTapWaitUs = 300000;
+// 0.6 s: the jerk is at a move's start and the move itself is never still; 1.5 s swallowed five
+// light taps while the host was returning the head to centre (18:32:24 on 2026-11-12).
+constexpr int64_t kServoBlankUs  = 600000;
+std::atomic<int64_t> g_imu_jolt_us{0};    // when the latest jolt was read (esp_timer, us)
+std::atomic<int32_t> g_imu_jolt_x100{0};  // its size, m/s^2 times 100
+extern std::atomic<int64_t> g_servo_cmd_us;
+extern std::atomic<int64_t> g_head_strip_touch_us;  // the latest touched strip sample (hal_head_touch.cpp)
+extern std::atomic<int64_t> g_head_strip_used_jolt_us;  // the jolt the strip made a tap from
+void device_events_push_front_tap(int jolt_x100);
+// Serial trace for tuning, for the first half hour after boot: moving samples
+// "I <ms> <change*100> <ax*100> <ay*100> <az*100> <gx> <gy> <gz>", once a second
+// "IS <ms> <samples> <change_max*100> <gyro_max>", and "J <ms> <change*100>" for each jolt.
+constexpr int64_t kTraceUntilUs = 30LL * 60 * 1000000;
+constexpr float kTraceAdiff     = 0.5f;   // m/s^2
+constexpr float kTraceGyro      = 10.0f;  // deg/s, sum of the three axes
+
@@ -174,0 +216,18 @@ static void _imu_task(void* param)
+    // Fast sampling: the sensor is read every 10 ms (its own rate is 100 Hz); the shake, orientation
+    // and stall checks keep their 100 ms rhythm by running on every tenth sample.
+    constexpr int kSlowEvery = 10;
+    int fast_n               = 0;
+    TickType_t last_wake     = xTaskGetTickCount();
+    float prev[3]            = {0, 0, 0};
+    bool have_prev           = false;
+    int64_t sec_start_us     = 0;
+    int sec_n                = 0;
+    float sec_amax = 0, sec_gmax = 0;
+    int quiet_run            = 0;  // samples in a row whose change stayed under kTapQuietMax
+    uint32_t jolts           = 0;  // this minute, for imu_stats
+    float jolt_max           = 0;
+    uint32_t blanked         = 0;  // jolts ignored because a servo was moving
+    uint32_t front_taps      = 0;
+    int64_t front_pending_us = 0;  // a big jolt waiting to see whether the strip claims it
+    int32_t front_pending_x100 = 0;
+
@@ -175,0 +235 @@ static void _imu_task(void* param)
+        const bool slow = (fast_n++ % kSlowEvery) == 0;
@@ -178,0 +239,64 @@ static void _imu_task(void* param)
+            {
+                const int64_t now_us = esp_timer_get_time();
+                const float adiff    = have_prev ? std::fabs(data.accel_x - prev[0]) + std::fabs(data.accel_y - prev[1]) +
+                                                    std::fabs(data.accel_z - prev[2])
+                                                 : 0.0f;
+                prev[0] = data.accel_x, prev[1] = data.accel_y, prev[2] = data.accel_z;
+                have_prev        = true;
+                const float gsum = std::fabs(data.gyro_x) + std::fabs(data.gyro_y) + std::fabs(data.gyro_z);
+                if (adiff >= kTapJoltMin && quiet_run >= kTapQuietSamples) {
+                    if (now_us - g_servo_cmd_us.load() < kServoBlankUs) {
+                        blanked++;
+                    } else {
+                        g_imu_jolt_x100.store(static_cast<int32_t>(adiff * 100));
+                        g_imu_jolt_us.store(now_us);
+                        jolts++;
+                        if (adiff > jolt_max) jolt_max = adiff;
+                        if (kFrontTapEnabled && adiff >= kFrontTapJoltMin && front_pending_us == 0) {
+                            front_pending_us   = now_us;
+                            front_pending_x100 = static_cast<int32_t>(adiff * 100);
+                        }
+                        if (now_us < kTraceUntilUs) {
+                            printf("J %u %d\n", static_cast<unsigned>(now_us / 1000), static_cast<int>(adiff * 100));
+                        }
+                    }
+                }
+                if (front_pending_us != 0 && now_us - front_pending_us >= kFrontTapWaitUs) {
+                    // The strip had its chance: a contact near the jolt makes it the strip's tap.
+                    const int64_t strip_us = g_head_strip_touch_us.load();
+                    const bool strip_near  = std::llabs(strip_us - front_pending_us) <= kFrontTapWaitUs;
+                    if (!strip_near && g_head_strip_used_jolt_us.load() != front_pending_us) {
+                        front_taps++;
+                        device_events_push_front_tap(front_pending_x100);
+                        if (now_us < kTraceUntilUs) {
+                            printf("F %u %d\n", static_cast<unsigned>(front_pending_us / 1000),
+                                   static_cast<int>(front_pending_x100));
+                        }
+                    }
+                    front_pending_us = 0;
+                }
+                quiet_run = adiff < kTapQuietMax ? quiet_run + 1 : 0;
+                if (now_us < kTraceUntilUs) {
+                    if (adiff > kTraceAdiff || gsum > kTraceGyro) {
+                        printf("I %u %d %d %d %d %d %d %d\n", static_cast<unsigned>(now_us / 1000),
+                               static_cast<int>(adiff * 100), static_cast<int>(data.accel_x * 100),
+                               static_cast<int>(data.accel_y * 100), static_cast<int>(data.accel_z * 100),
+                               static_cast<int>(data.gyro_x), static_cast<int>(data.gyro_y), static_cast<int>(data.gyro_z));
+                    }
+                    sec_n++;
+                    if (adiff > sec_amax) sec_amax = adiff;
+                    if (gsum > sec_gmax) sec_gmax = gsum;
+                    if (sec_start_us == 0) {
+                        sec_start_us = now_us;
+                    } else if (now_us - sec_start_us >= 1000000) {
+                        printf("IS %u %d %d %d\n", static_cast<unsigned>(now_us / 1000), sec_n,
+                               static_cast<int>(sec_amax * 100), static_cast<int>(sec_gmax));
+                        sec_n = 0, sec_amax = 0, sec_gmax = 0;
+                        sec_start_us = now_us;
+                    }
+                }
+            }
+            if (!slow) {
+                vTaskDelayUntil(&last_wake, pdMS_TO_TICKS(10));
+                continue;
+            }
@@ -198,3 +322,6 @@ static void _imu_task(void* param)
-                char stats[64];
-                snprintf(stats, sizeof(stats), "\"max_diff\":%d,\"shakes\":%u",
-                         static_cast<int>(motion_detector->takeMaxDiff()), static_cast<unsigned>(shakes));
+                char stats[128];
+                snprintf(stats, sizeof(stats),
+                         "\"max_diff\":%d,\"shakes\":%u,\"jolts\":%u,\"jolt_max\":%d,\"blanked\":%u,\"front_taps\":%u",
+                         static_cast<int>(motion_detector->takeMaxDiff()), static_cast<unsigned>(shakes),
+                         static_cast<unsigned>(jolts), static_cast<int>(jolt_max * 100), static_cast<unsigned>(blanked),
+                         static_cast<unsigned>(front_taps));
@@ -202,0 +330,4 @@ static void _imu_task(void* param)
+                jolts          = 0;
