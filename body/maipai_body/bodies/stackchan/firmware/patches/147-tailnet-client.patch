diff --git a/firmware/main/hal/maipai_tailnet.cc b/firmware/main/hal/maipai_tailnet.cc
new file mode 100644
index 0000000..5bebf6a
--- /dev/null
+++ b/firmware/main/hal/maipai_tailnet.cc
@@ -0,0 +1,293 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The robot's own tailnet client, the device side (patch 147). See maipai_tailnet.h.
+ *
+ * MicroLink (a downloaded, pinned MIT Tailscale client) runs only when CONFIG_STACKCHAN_TAILNET is set and the saved
+ * switch is on. Memory rule (the unit has about 76 KB free internal RAM): the client's task stacks are in PSRAM
+ * except wg_mgr, which writes NVS and so keeps an internal stack (library patch 148); this file's one task keeps an
+ * internal stack because microlink_init writes the node identity to NVS.
+ */
+#include "maipai_tailnet.h"
+#include "maipai_tailnet_core.h"
+#include "device_events.h"
+#include <mcp_server.h>
+#include <esp_event.h>
+#include <esp_log.h>
+#include <esp_netif.h>
+#include <esp_system.h>
+#include <esp_timer.h>
+#include <esp_attr.h>
+#include <esp_heap_caps.h>
+#include <nvs.h>
+#include <nvs_flash.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+#ifndef CONFIG_STACKCHAN_TAILNET
+#define CONFIG_STACKCHAN_TAILNET 0
+#endif
+
+#if CONFIG_STACKCHAN_TAILNET
+#include "microlink.h"
+#endif
+
+static const char* TAG        = "MAIPAI-TAILNET";
+static const char* kNamespace = "maipai_tn";  // our own: never the websocket namespace, never MicroLink's "microlink"/"ml_peers"
+static const char* kKeyOn     = "on";
+
+static RTC_NOINIT_ATTR mt_guard_t s_guard;  // survives a crash reset, not a power cycle
+static volatile bool s_enabled   = false;
+static volatile bool s_guard_off = false;
+static volatile bool s_started   = false;
+static volatile int s_state      = 0;       // microlink_state_t when compiled in
+static volatile uint32_t s_vpn_ip = 0;
+static volatile int64_t s_started_at_us = 0;
+
+bool maipai_tailnet_compiled()
+{
+    return CONFIG_STACKCHAN_TAILNET != 0;
+}
+
+static bool load_enabled()
+{
+    nvs_handle_t h;
+    if (nvs_open(kNamespace, NVS_READONLY, &h) != ESP_OK) {
+        return CONFIG_STACKCHAN_TAILNET_AUTHKEY[0] != 0;  // never saved: OFF (a private first-enrolment build, a key compiled in, starts ON)
+    }
+    uint8_t v = CONFIG_STACKCHAN_TAILNET_AUTHKEY[0] != 0 ? 1 : 0;  // not found in flash: the default above
+    nvs_get_u8(h, kKeyOn, &v);
+    nvs_close(h);
+    return v == 1;
+}
+
+static void save_enabled(bool on)
+{
+    nvs_handle_t h;
+    if (nvs_open(kNamespace, NVS_READWRITE, &h) != ESP_OK) {
+        return;
+    }
+    nvs_set_u8(h, kKeyOn, on ? 1 : 0);
+    nvs_commit(h);
+    nvs_close(h);
+}
+
+static bool last_reset_was_crash()
+{
+    switch (esp_reset_reason()) {
+        case ESP_RST_PANIC:
+        case ESP_RST_INT_WDT:
+        case ESP_RST_TASK_WDT:
+        case ESP_RST_WDT:
+        case ESP_RST_BROWNOUT:
+            return true;
+        default:
+            return false;
+    }
+}
+
+std::string maipai_tailnet_peer_host()
+{
+    return std::string(CONFIG_STACKCHAN_TAILNET_PEER_IP);
+}
+
+#if CONFIG_STACKCHAN_TAILNET
+
+static microlink_t* s_ml = nullptr;
+
+bool maipai_tailnet_ready()
+{
+    return s_ml != nullptr && s_state == ML_STATE_CONNECTED && s_vpn_ip != 0;
+}
+
+static const char* state_word(int s)
+{
+    switch (s) {
+        case ML_STATE_IDLE: return "idle";
+        case ML_STATE_WIFI_WAIT: return "waiting_wifi";
+        case ML_STATE_CONNECTING: return "connecting";
+        case ML_STATE_REGISTERING: return "registering";
+        case ML_STATE_CONNECTED: return "connected";
+        case ML_STATE_RECONNECTING: return "reconnecting";
+        case ML_STATE_ERROR: return "error";
+        default: return "unknown";
+    }
+}
+
+static void push_state_event()
+{
+    char ip[16] = "";
+    if (s_vpn_ip != 0) {
+        mt_ip_to_str(s_vpn_ip, ip);
+    }
+    char extra[96];
+    snprintf(extra, sizeof(extra), "\"state\":\"%s\",\"ip\":\"%s\"", state_word(s_state), ip);
+    device_events_push("tailnet_state", extra);
+}
+
+static void on_state(microlink_t* ml, microlink_state_t state, void*)
+{
+    s_state  = state;
+    s_vpn_ip = microlink_get_vpn_ip(ml);
+    ESP_LOGI(TAG, "tailnet state: %s", state_word(state));
+    push_state_event();
+}
+
+static bool sta_has_ip()
+{
+    esp_netif_t* netif = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
+    esp_netif_ip_info_t ip;
+    return netif != nullptr && esp_netif_get_ip_info(netif, &ip) == ESP_OK && ip.ip.addr != 0;
+}
+
+static void tailnet_task(void*)
+{
+    // Wait for a Wi-Fi address (the client needs one), then give the rest of the boot a few seconds first.
+    while (!sta_has_ip()) {
+        vTaskDelay(pdMS_TO_TICKS(1000));
+        if (!s_enabled) {
+            vTaskDelete(nullptr);
+            return;
+        }
+    }
+    vTaskDelay(pdMS_TO_TICKS(5000));
+    microlink_config_t config = {};
+    config.auth_key        = CONFIG_STACKCHAN_TAILNET_AUTHKEY;  // empty in every published build; a private first-enrolment build only
+    config.device_name     = CONFIG_STACKCHAN_TAILNET_HOSTNAME;
+    config.enable_derp     = true;
+    config.enable_stun     = true;
+    config.enable_disco    = true;
+    config.max_peers       = CONFIG_STACKCHAN_TAILNET_MAX_PEERS;
+    config.priority_peer_ip = mt_parse_ip(CONFIG_STACKCHAN_TAILNET_PEER_IP);
+    ESP_LOGI(TAG, "starting the tailnet client (internal free %u, largest block %u)",
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL));
+    mt_guard_started(&s_guard);
+    s_started_at_us = esp_timer_get_time();
+    s_ml = microlink_init(&config);
+    if (s_ml == nullptr) {
+        ESP_LOGE(TAG, "the tailnet client did not initialise");
+        mt_guard_stable(&s_guard);  // not a crash
+        vTaskDelete(nullptr);
+        return;
+    }
+    microlink_set_state_callback(s_ml, on_state, nullptr);
+    if (microlink_start(s_ml) != ESP_OK) {
+        ESP_LOGE(TAG, "the tailnet client did not start");
+    }
+    s_started = true;
+    bool stable_said = false;
+    int tick = 0;
+    for (;;) {
+        vTaskDelay(pdMS_TO_TICKS(1000));
+        tick++;
+        s_state  = microlink_get_state(s_ml);
+        s_vpn_ip = microlink_get_vpn_ip(s_ml);
+        if (!stable_said && (esp_timer_get_time() - s_started_at_us) / 1000 >= MT_STABLE_MS) {
+            mt_guard_stable(&s_guard);
+            stable_said = true;
+            ESP_LOGI(TAG, "the tailnet client has run %d s: this boot counts as good", MT_STABLE_MS / 1000);
+        }
+        if (tick % 60 == 0) {
+            ESP_LOGI(TAG, "tailnet %s, internal free %u, largest block %u, min free %u", state_word(s_state),
+                     (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+                     (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL),
+                     (unsigned)heap_caps_get_minimum_free_size(MALLOC_CAP_INTERNAL));
+        }
+    }
+}
+
+static void start_task()
+{
+    // An internal stack on purpose: microlink_init writes the node identity to NVS (flash).
+    xTaskCreatePinnedToCore(tailnet_task, "tailnet", 5120, nullptr, 3, nullptr, 0);
+}
+
+#else  // not compiled in
+
+bool maipai_tailnet_ready()
+{
+    return false;
+}
+
+static void start_task() {}
+
+#endif
+
+void maipai_tailnet_init()
+{
+    const bool crash = last_reset_was_crash();
+    const int allowed = mt_guard_boot(&s_guard, crash ? 1 : 0);
+    s_enabled = load_enabled();
+    if (!allowed) {
+        // Three crashed boots in a row with the client running: switch it off by itself (saved), say so to the host.
+        s_guard_off = true;
+        if (s_enabled) {
+            s_enabled = false;
+            save_enabled(false);
+        }
+        ESP_LOGW(TAG, "the boot-loop guard switched the tailnet client off (%d crashed boots in a row)", MT_GUARD_CRASHES);
+        device_events_push("tailnet_state", "\"state\":\"guard_off\",\"ip\":\"\"");
+        mt_guard_stable(&s_guard);
+        return;
+    }
+    ESP_LOGI(TAG, "tailnet client: compiled %s, switch %s", maipai_tailnet_compiled() ? "in" : "out", s_enabled ? "on" : "off");
+    if (maipai_tailnet_compiled() && s_enabled) {
+        start_task();
+    }
+}
+
+void maipai_tailnet_register_tools()
+{
+    auto& mcp = McpServer::GetInstance();
+    mcp.AddTool("self.tailnet.status",
+                "The tailnet client: whether it is compiled in, switched on, its state (idle, waiting_wifi, connecting, "
+                "registering, connected, reconnecting, error, guard_off), the tailnet address, the hub address it "
+                "reaches, and the internal RAM free now. Answers JSON.",
+                PropertyList(), [](const PropertyList&) -> ReturnValue {
+                    char ip[16] = "";
+                    if (s_vpn_ip != 0) {
+                        mt_ip_to_str(s_vpn_ip, ip);
+                    }
+                    char buf[320];
+                    snprintf(buf, sizeof(buf),
+                             "{\"compiled\":%s,\"enabled\":%s,\"guard_off\":%s,\"state\":\"%s\",\"ip\":\"%s\",\"peer\":\"%s\","
+                             "\"ready\":%s,\"internal_free\":%u,\"largest_block\":%u}",
+                             maipai_tailnet_compiled() ? "true" : "false", s_enabled ? "true" : "false",
+                             s_guard_off ? "true" : "false",
+#if CONFIG_STACKCHAN_TAILNET
+                             state_word(s_state),
+#else
+                             "off",
+#endif
+                             ip, CONFIG_STACKCHAN_TAILNET_PEER_IP, maipai_tailnet_ready() ? "true" : "false",
+                             (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+                             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL));
+                    return std::string(buf);
+                });
+    mcp.AddTool("self.tailnet.set",
+                "Switch the tailnet client on or off (saved in flash). Switching on starts it at once when Wi-Fi has an "
+                "address; switching off takes effect at the next restart. Answers {\"ok\":true,\"restart\":bool} or "
+                "{\"ok\":false,\"error\":\"not_compiled\"}.",
+                PropertyList({Property("enabled", kPropertyTypeBoolean, false)}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    if (!maipai_tailnet_compiled()) {
+                        return std::string("{\"ok\":false,\"error\":\"not_compiled\"}");
+                    }
+                    const bool on = properties["enabled"].value<bool>();
+                    save_enabled(on);
+                    const bool was = s_enabled;
+                    s_enabled = on;
+                    s_guard_off = s_guard_off && !on;
+                    bool restart = false;
+                    if (on && !was && !s_started) {
+                        start_task();
+                    } else if (!on && s_started) {
+                        restart = true;  // the client cannot be stopped cleanly mid-run: off at the next restart
+                    }
+                    return std::string("{\"ok\":true,\"restart\":") + (restart ? "true" : "false") + "}";
+                });
+}
