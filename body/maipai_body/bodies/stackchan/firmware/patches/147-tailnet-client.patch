+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The robot's own tailnet client (patch 147): the unit joins the household's Tailscale network itself (MicroLink,
+ * a downloaded and pinned MIT client) after Wi-Fi gets an address, so it reaches the hub over the tailnet from any
+ * Wi-Fi with no relay and no public address. Compiled in only with CONFIG_STACKCHAN_TAILNET; off at runtime until
+ * the host enables it (self.tailnet.set). The pure logic is in maipai_tailnet_core.h.
+ */
+#pragma once
+#include <string>
+
+// Reads the saved on/off flag and the boot-loop guard, and starts the client when Wi-Fi gets an address (it waits
+// for the address by itself). Call once after NVS and the network stack are up (Hal::startXiaozhi).
+void maipai_tailnet_init();
+
+// True when the tailnet client is compiled into this firmware.
+bool maipai_tailnet_compiled();
+
+// True once the client is connected to the control plane and has an address on the tailnet.
+bool maipai_tailnet_ready();
+
+// The hub's tailnet address (CONFIG_STACKCHAN_TAILNET_PEER_IP) as text; empty when none is configured.
+std::string maipai_tailnet_peer_host();
+
+// The pure host choice the fallback uses (patch 148): the tailnet peer first while the tailnet is up.
+// Registers self.tailnet.status and self.tailnet.set.
+void maipai_tailnet_register_tools();
diff --git a/firmware/main/hal/maipai_tailnet_core.h b/firmware/main/hal/maipai_tailnet_core.h
new file mode 100644
index 0000000..46c2812
--- /dev/null
+++ b/firmware/main/hal/maipai_tailnet_core.h
@@ -0,0 +1,122 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The pure choices behind the robot's own tailnet client (patch 147), plain C so a host test can run them:
+ * the boot-loop guard (the client switches itself off after three crashes of its boots in a row) and the
+ * tailnet address helpers. Nothing here touches the hardware.
+ */
+#pragma once
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+/* Crashes of boots in which the client had started, in a row, that switch the client off. */
+#define MT_GUARD_CRASHES 3
+/* A boot that keeps the client up this long is a good boot (the crash counter goes back to zero). */
+#define MT_STABLE_MS 120000
+
+/* Kept in RTC no-init memory: it survives a reset, not a power cycle (a power cycle is a person acting). */
+typedef struct {
+    uint32_t magic;
+    uint8_t started;  /* the client had started in the previous boot and had not yet proven itself stable */
+    uint8_t crashes;  /* consecutive crashed boots */
+    uint8_t reserved[2];
+} mt_guard_t;
+
+#define MT_GUARD_MAGIC 0x4d544731u
+
+/* Call once at boot with the saved record and whether the last reset was a crash (panic, watchdog, brownout).
+ * Returns 1 when the client may start, 0 when the guard has switched it off (three crashed boots in a row). */
+static inline int mt_guard_boot(mt_guard_t* g, int last_reset_was_crash)
+{
+    if (g->magic != MT_GUARD_MAGIC) {
+        memset(g, 0, sizeof(*g));
+        g->magic = MT_GUARD_MAGIC;
+    }
+    if (g->started && last_reset_was_crash) {
+        if (g->crashes < 255) {
+            g->crashes++;
+        }
+    } else {
+        g->crashes = 0;
+    }
+    g->started = 0;
+    return g->crashes < MT_GUARD_CRASHES ? 1 : 0;
+}
+
+/* The client has started: a crash from here on counts. */
+static inline void mt_guard_started(mt_guard_t* g)
+{
+    g->started = 1;
+}
+
+/* The client has stayed up for MT_STABLE_MS: this boot was a good one. */
+static inline void mt_guard_stable(mt_guard_t* g)
+{
+    g->started = 0;
+    g->crashes = 0;
+}
+
+/* Host byte order IPv4 -> "a.b.c.d" (out holds at least 16 bytes). */
+static inline void mt_ip_to_str(uint32_t ip, char* out)
+{
+    snprintf(out, 16, "%u.%u.%u.%u", (unsigned)((ip >> 24) & 255), (unsigned)((ip >> 16) & 255),
+             (unsigned)((ip >> 8) & 255), (unsigned)(ip & 255));
+}
+
+/* "a.b.c.d" -> host byte order, 0 when it does not parse. */
+static inline uint32_t mt_parse_ip(const char* s)
+{
+    unsigned a, b, c, d;
+    char tail;
+    if (s == NULL || sscanf(s, "%u.%u.%u.%u%c", &a, &b, &c, &d, &tail) != 4 || a > 255 || b > 255 || c > 255 || d > 255) {
+        return 0;
+    }
+    return (a << 24) | (b << 16) | (c << 8) | d;
+}
+
+/* 1 for an address in the tailnet range 100.64.0.0/10 (CGNAT), which the WireGuard interface owns. */
+static inline int mt_is_tailnet_ip(uint32_t ip)
+{
+    return (ip & 0xffc00000u) == 0x64400000u ? 1 : 0;
+}
+
+/* The candidate hosts for the hub, in order, for attempt number `attempt` after the home address failed: the tailnet
+ * address first (only when the tailnet is up: it is encrypted end to end, safe on any network), then the others
+ * the caller passes (the gateway when the network may use it, the configured host). A NULL or empty entry, a
+ * duplicate of an earlier one or of `home` is skipped. Returns 1 and fills `out` when there is a candidate. */
+static inline int mt_pick_host(int attempt, const char* tailnet, const char* second, const char* third, const char* home,
+                               char* out, size_t out_size)
+{
+    const char* list[3] = {tailnet, second, third};
+    const char* cand[3];
+    int n = 0;
+    for (int i = 0; i < 3; i++) {
+        const char* h = list[i];
+        if (h == NULL || h[0] == '\0' || strcmp(h, "0.0.0.0") == 0) {
+            continue;
+        }
+        if (home != NULL && strcmp(h, home) == 0) {
+            continue;
+        }
+        int dup = 0;
+        for (int j = 0; j < n; j++) {
+            if (strcmp(cand[j], h) == 0) {
+                dup = 1;
+            }
+        }
+        if (!dup) {
+            cand[n++] = h;
+        }
+    }
+    if (n == 0 || out == NULL || out_size == 0) {
+        return 0;
+    }
+    const char* chosen = cand[(attempt < 0 ? 0 : attempt) % n];
+    size_t len = strlen(chosen);
+    if (len + 1 > out_size) {
+        return 0;
+    }
+    memcpy(out, chosen, len + 1);
+    return 1;
+}
