+void hal_bridge::display_set_rotation(int degrees)
+{
+    if (s_panel == nullptr) {
+        return;
+    }
+    const bool flip = degrees == 180;
+    if (flip) {
+        s_rotated_until_us = esp_timer_get_time() + kRotationLeaseUs;
+    }
+    if (flip == s_rotated) {
+        return;
+    }
+    s_rotated = flip;
+    esp_lcd_panel_mirror(s_panel, DISPLAY_MIRROR_X != flip, DISPLAY_MIRROR_Y != flip);
+    auto display = Board::GetInstance().GetDisplay();
+    if (display != nullptr) {
+        DisplayLockGuard lock(display);
+        lv_obj_invalidate(lv_screen_active());  // draw the whole screen again in the new orientation
+    }
+    ESP_LOGI(TAG, "screen rotation %d", flip ? 180 : 0);
+}
+
+void hal_bridge::display_rotation_tick()
+{
+    if (s_rotated && esp_timer_get_time() > s_rotated_until_us) {
+        display_set_rotation(0);
+    }
+}
