diff --git a/firmware/main/hal/hal_imu.cpp b/firmware/main/hal/hal_imu.cpp
index e0c377f..c42cf29 100644
--- a/firmware/main/hal/hal_imu.cpp
+++ b/firmware/main/hal/hal_imu.cpp
@@ -10,12 +10,97 @@
 #include <mooncake_log.h>
 #include <memory>
 #include <cstdio>
+#include <cmath>
 #include "device_events.h"
 
 static const std::string_view _tag = "HAL-IMU";
 
 static std::unique_ptr<BMI270> _bmi270;
 
+// Which way is down: the axis the gravity vector mostly lies along ("+x", "-y", ...), kept steady by a
+// low-pass filter, a minimum pull, a margin over the axis it replaces and a hold of about a second, so
+// carrying or shaking the unit does not flap. The host maps the axis to a pose (orientation.py), so a
+// wrong guess about how the sensor sits in the body is fixed there without a flash.
+struct OrientationTracker {
+    float filt[3]       = {0, 0, 0};
+    bool primed         = false;
+    int current         = -1;  // 0..5 = +x -x +y -y +z -z
+    int candidate       = -1;
+    int hold            = 0;
+    uint32_t reported_ms = 0;
+
+    static constexpr float kAlpha       = 0.3f;
+    static constexpr float kMinPull     = 6.5f;   // m/s^2 along the axis (gravity is 9.8)
+    static constexpr float kMargin      = 2.0f;   // new axis must beat the old one by this much
+    static constexpr float kMinMag      = 7.8f;   // total pull outside 0.8 to 1.2 g means moving
+    static constexpr float kMaxMag      = 11.8f;
+    static constexpr int kHoldSamples   = 10;     // samples 100 ms apart
+
+    static int index_for(int axis, float value) { return axis * 2 + (value < 0 ? 1 : 0); }
+
+    void report(const char* why)
+    {
+        static const char* names[] = {"+x", "-x", "+y", "-y", "+z", "-z"};
+        char extra[96];
+        snprintf(extra, sizeof(extra), "\"axis\":\"%s\",\"gx\":%d,\"gy\":%d,\"gz\":%d", names[current],
+                 static_cast<int>(filt[0] * 101.97f), static_cast<int>(filt[1] * 101.97f),
+                 static_cast<int>(filt[2] * 101.97f));
+        mclog::tagInfo(_tag, "orientation {} ({})", extra, why);
+        device_events_push_diag("orientation", extra);
+        reported_ms = pdTICKS_TO_MS(xTaskGetTickCount());
+    }
+
+    void update(float x, float y, float z)
+    {
+        const float in[3] = {x, y, z};
+        for (int i = 0; i < 3; i++) {
+            filt[i] = primed ? filt[i] + kAlpha * (in[i] - filt[i]) : in[i];
+        }
+        primed = true;
+        const float mag = std::sqrt(filt[0] * filt[0] + filt[1] * filt[1] + filt[2] * filt[2]);
+        if (mag < kMinMag || mag > kMaxMag) {
+            hold = 0;
+            return;
+        }
+        int axis = 0;
+        for (int i = 1; i < 3; i++) {
+            if (std::fabs(filt[i]) > std::fabs(filt[axis])) {
+                axis = i;
+            }
+        }
+        const float pull = std::fabs(filt[axis]);
+        const int idx    = index_for(axis, filt[axis]);
+        if (pull < kMinPull) {
+            hold = 0;
+            return;
+        }
+        if (idx == current) {
+            hold = 0;
+            // Say it again once a minute so a host that connected later learns the pose.
+            if (pdTICKS_TO_MS(xTaskGetTickCount()) - reported_ms >= 60000) {
+                report("still");
+            }
+            return;
+        }
+        if (current >= 0) {
+            const int cur_axis = current / 2;
+            if (pull < std::fabs(filt[cur_axis]) + kMargin) {
+                hold = 0;
+                return;
+            }
+        }
+        if (idx != candidate) {
+            candidate = idx;
+            hold      = 0;
+        }
+        if (++hold >= kHoldSamples) {
+            current = idx;
+            hold    = 0;
+            report("changed");
+        }
+    }
+};
