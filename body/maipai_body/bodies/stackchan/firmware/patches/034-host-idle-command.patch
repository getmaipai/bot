# Intent: let the host end a silent follow-up. In auto mode the firmware goes straight back to Listening after every reply and only the server could end the utterance, so a quiet room kept re-arming the listen loop. {"type":"system","command":"idle"} now moves a Listening or Speaking device to Idle (which disables voice processing and re-arms the wake word).
# Upstream: 78/xiaozhi-esp32 main/application.cc (MIT), via m5stack/StackChan firmware. Applies after 002, 014, 015, 016, 030, 032 with --unidiff-zero.
# Check after a flash: after a silent follow-up the serial log shows "System command: idle" and the state returns to idle; the host log shows "ending quietly and going idle".
diff --git a/firmware/xiaozhi-esp32/main/application.cc b/firmware/xiaozhi-esp32/main/application.cc
index aa0c00f..4599d25 100644
--- a/firmware/xiaozhi-esp32/main/application.cc
+++ b/firmware/xiaozhi-esp32/main/application.cc
@@ -621,0 +622,9 @@ void Application::InitializeProtocol() {
+                } else if (strcmp(command->valuestring, "idle") == 0) {
+                    // The host ends a silent follow-up: leave Listening or Speaking and go idle.
+                    // Idle disables voice processing and re-arms the wake word.
+                    Schedule([this]() {
+                        auto state = GetDeviceState();
+                        if (state == kDeviceStateListening || state == kDeviceStateSpeaking) {
+                            SetDeviceState(kDeviceStateIdle);
+                        }
+                    });
