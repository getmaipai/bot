+    MintEye(lv_obj_t* parent, bool isLeftEye);
+    ~MintEye();
+
+    void setPosition(const uitk::Vector2i& position) override;
+    void setWeight(int weight) override;
+    void setEmotion(const Emotion& emotion) override;
+    Emotion getEmotion() const override;
+    void setVisible(bool visible) override;
+    void setSize(int size) override;
+
+private:
+    void render();
+
+    bool _is_left_eye = false;
+    Emotion _emotion  = Emotion::Neutral;
+    lv_obj_t* _container = nullptr;
+    lv_obj_t* _dot       = nullptr;
+    lv_obj_t* _line      = nullptr;
+    lv_obj_t* _brow      = nullptr;
+    std::array<lv_point_precise_t, 17> _line_points{};
+    std::array<lv_point_precise_t, 2> _brow_points{};
+    uint32_t _line_count = 0;
+    uint32_t _brow_count = 0;
+};
+
+class MintMouth : public Feature {
+public:
