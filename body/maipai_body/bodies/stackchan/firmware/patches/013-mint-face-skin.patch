+/*
+ * SPDX-FileCopyrightText: 2026 MaiPai contributors
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+#include "../default/default.h"
+#include <array>
+#include <memory>
+
+namespace stackchan::avatar {
+
+/**
+ * @brief Mint face: pale mint screen, small dot eyes, thin ink lines, green filled mouths.
+ *
+ * Eyes and mouth draw a shape per emotion. Eye weight keeps the blink contract (below 50 is
+ * closed) and mouth weight keeps the lip sync contract (above 20 opens the mouth).
+ */
+class MintAvatar : public Avatar {
+public:
+    void init(lv_obj_t* parent, const lv_font_t* font = &lv_font_montserrat_16);
+    uitk::lvgl_cpp::Container* getPanel() const;
+
+private:
+    std::unique_ptr<uitk::lvgl_cpp::Container> _panel;
+};
+
+class MintEye : public Feature {
+public:
+    MintEye(lv_obj_t* parent, bool isLeftEye);
+    ~MintEye();
+
+    void setPosition(const uitk::Vector2i& position) override;
+    void setWeight(int weight) override;
+    void setEmotion(const Emotion& emotion) override;
+    Emotion getEmotion() const override;
+    void setVisible(bool visible) override;
+    void setSize(int size) override;
+
+private:
+    void render();
+
+    bool _is_left_eye = false;
+    Emotion _emotion  = Emotion::Neutral;
+    lv_obj_t* _container = nullptr;
+    lv_obj_t* _dot       = nullptr;
+    lv_obj_t* _line      = nullptr;
+    lv_obj_t* _brow      = nullptr;
+    std::array<lv_point_precise_t, 17> _line_points{};
+    std::array<lv_point_precise_t, 2> _brow_points{};
+};
+
+class MintMouth : public Feature {
+public:
+    explicit MintMouth(lv_obj_t* parent);
+    ~MintMouth();
+
+    void setPosition(const uitk::Vector2i& position) override;
+    void setWeight(int weight) override;
+    void setEmotion(const Emotion& emotion) override;
+    Emotion getEmotion() const override;
+    void setVisible(bool visible) override;
+
+private:
+    void render();
+    void showCap(int width, int height, int top, bool lowerHalf, bool tongue);
+    void showOval(int width, int height, int centerY, bool tongue);
+
+    Emotion _emotion     = Emotion::Neutral;
+    lv_obj_t* _container = nullptr;
