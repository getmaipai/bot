+/*
+ * SPDX-FileCopyrightText: 2026 MaiPai contributors
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#include "mint.h"
+#include <algorithm>
+#include <cmath>
+
+using namespace uitk;
+using namespace uitk::lvgl_cpp;
+using namespace stackchan::avatar;
+
+// Shapes are drawn in mockup units (the owner-approved sheet) and scaled up to the 320x240 panel.
+static constexpr float kScale       = 1.35f;
+static const lv_color_t kBg         = lv_color_hex(0xC4F0DA);
+static const lv_color_t kInk        = lv_color_hex(0x18241F);
+static const lv_color_t kFill       = lv_color_hex(0x3E9E6B);
+static const lv_color_t kTongue     = lv_color_hex(0x8ED6A4);
+static const lv_color_t kTeeth      = lv_color_hex(0xFFFFFF);
+static constexpr int kStroke        = 7;
+static constexpr int kThinStroke    = 5;
+static constexpr int kEyeX          = 78;
+static constexpr int kEyeY          = -23;
+// Boxes just hold their shapes (with a few pixels spare): moving a box repaints all of it.
+static constexpr int kEyeBoxW       = 52;
+static constexpr int kEyeBoxH       = 76;
+static constexpr int kMouthY        = 39;
+static constexpr int kMouthBoxW     = 96;
+static constexpr int kMouthBoxH     = 84;
+static constexpr int kOffsetRange   = 16;
+static constexpr int kClosedEyeAt   = 50;
+static constexpr int kOpenMouthAt   = 20;
+
+static int px(float mockup)
+{
+    return static_cast<int>(std::lround(mockup * kScale));
+}
+
+static int lerp(int value, int inMin, int inMax, int outMin, int outMax)
+{
+    value = clamp(value, inMin, inMax);
+    return outMin + (value - inMin) * (outMax - outMin) / (inMax - inMin);
+}
+
+template <size_t N>
+static uint32_t quad(std::array<lv_point_precise_t, N>& out, uint32_t start, uint32_t count, float x0, float y0,
+                     float cx, float cy, float x1, float y1, int originX, int originY)
+{
+    for (uint32_t i = 0; i < count; ++i) {
+        float t        = static_cast<float>(i) / static_cast<float>(count - 1);
+        float u        = 1.0f - t;
+        float x        = u * u * x0 + 2 * u * t * cx + t * t * x1;
+        float y        = u * u * y0 + 2 * u * t * cy + t * t * y1;
+        out[start + i] = {static_cast<lv_value_precise_t>(originX + px(x)),
+                          static_cast<lv_value_precise_t>(originY + px(y))};
+    }
+    return start + count;
+}
+
+static lv_obj_t* make_box(lv_obj_t* parent)
+{
+    lv_obj_t* obj = lv_obj_create(parent);
+    lv_obj_remove_style_all(obj);
+    lv_obj_remove_flag(obj, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(obj, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_add_flag(obj, LV_OBJ_FLAG_EVENT_BUBBLE);
+    return obj;
+}
+
+static lv_obj_t* make_line(lv_obj_t* parent, int width, int height, int stroke)
+{
+    lv_obj_t* line = lv_line_create(parent);
+    lv_obj_set_size(line, width, height);
+    lv_obj_set_pos(line, 0, 0);
+    lv_obj_set_style_line_width(line, stroke, 0);
+    lv_obj_set_style_line_color(line, kInk, 0);
+    lv_obj_set_style_line_rounded(line, true, 0);
+    lv_obj_remove_flag(line, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_add_flag(line, LV_OBJ_FLAG_EVENT_BUBBLE);
+    return line;
+}
+
+static lv_obj_t* make_blob(lv_obj_t* parent, lv_color_t fill, int border)
+{
+    lv_obj_t* obj = make_box(parent);
+    lv_obj_set_style_radius(obj, LV_RADIUS_CIRCLE, 0);
+    lv_obj_set_style_bg_opa(obj, LV_OPA_COVER, 0);
+    lv_obj_set_style_bg_color(obj, fill, 0);
+    lv_obj_set_style_border_width(obj, border, 0);
+    lv_obj_set_style_border_color(obj, kInk, 0);
+    lv_obj_set_style_border_post(obj, true, 0);
+    return obj;
+}
+
+// LVGL repaints on every hide, show, align and set_points call, even when nothing changes. Each
+// helper below skips the call when the object already looks that way, so a lip sync tick only
+// repaints the parts that moved (a repaint on every tick starved Wi-Fi and made speech stutter).
+static void set_hidden(lv_obj_t* obj, bool hidden)
+{
+    if (lv_obj_has_flag(obj, LV_OBJ_FLAG_HIDDEN) == hidden) {
+        return;
+    }
+    if (hidden) {
+        lv_obj_add_flag(obj, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_obj_remove_flag(obj, LV_OBJ_FLAG_HIDDEN);
+    }
+}
+
+static void align(lv_obj_t* obj, lv_align_t where, int x, int y)
+{
+    if (lv_obj_get_style_align(obj, LV_PART_MAIN) == where && lv_obj_get_style_x(obj, LV_PART_MAIN) == x &&
+        lv_obj_get_style_y(obj, LV_PART_MAIN) == y) {
+        return;
+    }
+    lv_obj_align(obj, where, x, y);
+}
+
+// `shown` is the array the line draws from; `next` holds the new shape in parent coordinates. The
+// line object is cut to the shape's bounds, so a change repaints the shape, not the whole box.
+template <size_t N>
+static void set_points(lv_obj_t* line, std::array<lv_point_precise_t, N>& shown, uint32_t& shownCount,
+                       const std::array<lv_point_precise_t, N>& next, uint32_t count)
+{
+    if (count == 0) {
+        return;
+    }
+    const int pad = lv_obj_get_style_line_width(line, LV_PART_MAIN) / 2 + 1;
+    lv_value_precise_t minX = next[0].x, minY = next[0].y, maxX = next[0].x, maxY = next[0].y;
+    for (uint32_t i = 1; i < count; ++i) {
+        minX = std::min(minX, next[i].x);
+        minY = std::min(minY, next[i].y);
+        maxX = std::max(maxX, next[i].x);
+        maxY = std::max(maxY, next[i].y);
+    }
+    const int left = static_cast<int>(minX) - pad;
+    const int top  = static_cast<int>(minY) - pad;
+    std::array<lv_point_precise_t, N> local{};
+    for (uint32_t i = 0; i < count; ++i) {
+        local[i] = {next[i].x - left, next[i].y - top};
+    }
+    lv_obj_set_pos(line, left, top);
+    lv_obj_set_size(line, static_cast<int>(maxX - minX) + 2 * pad + 1, static_cast<int>(maxY - minY) + 2 * pad + 1);
+    auto same = [](const lv_point_precise_t& a, const lv_point_precise_t& b) { return a.x == b.x && a.y == b.y; };
+    if (count == shownCount && std::equal(local.begin(), local.begin() + count, shown.begin(), same)) {
+        return;
+    }
+    std::copy(local.begin(), local.begin() + count, shown.begin());
+    shownCount = count;
+    lv_line_set_points(line, shown.data(), count);
+}
+
+/* --------------------------------- Avatar -------------------------------- */
+
+void MintAvatar::init(lv_obj_t* parent, const lv_font_t* font)
+{
+    (void)font;  // No speech bubble: the owner wants no text under the face.
+    _panel = std::make_unique<Container>(parent);
+    _panel->align(LV_ALIGN_CENTER, 0, 0);
+    _panel->setSize(320, 240);
+    _panel->setRadius(0);
+    _panel->setBorderWidth(0);
+    _panel->setBgColor(kBg);
+    _panel->removeFlag(LV_OBJ_FLAG_SCROLLABLE);
+
+    _key_elements.leftEye      = std::make_unique<MintEye>(_panel->get(), true);
+    _key_elements.rightEye     = std::make_unique<MintEye>(_panel->get(), false);
+    _key_elements.mouth        = std::make_unique<MintMouth>(_panel->get());
+}
+
+Container* MintAvatar::getPanel() const
+{
+    return _panel.get();
+}
+
+/* ---------------------------------- Eyes --------------------------------- */
+
+MintEye::MintEye(lv_obj_t* parent, bool isLeftEye) : _is_left_eye(isLeftEye)
+{
+    _container = make_box(parent);
+    lv_obj_set_size(_container, kEyeBoxW, kEyeBoxH);
+    lv_obj_add_flag(_container, LV_OBJ_FLAG_OVERFLOW_VISIBLE);
+
+    _dot  = make_blob(_container, kInk, 0);
+    _line = make_line(_container, kEyeBoxW, kEyeBoxH, kStroke);
+    _brow = make_line(_container, kEyeBoxW, kEyeBoxH, kStroke);
+
+    _weight = 100;
+    setPosition(_position);
+    render();
+}
+
+MintEye::~MintEye()
+{
+    lv_obj_delete(_container);
+}
+
+void MintEye::setPosition(const Vector2i& position)
+{
+    Element::setPosition(position);
+    int x = (_is_left_eye ? -kEyeX : kEyeX) + lerp(_position.x, -100, 100, -kOffsetRange, kOffsetRange);
+    int y = kEyeY + lerp(_position.y, -100, 100, -kOffsetRange, kOffsetRange);
+    align(_container, LV_ALIGN_CENTER, x, y);
+}
+
+void MintEye::setWeight(int weight)
+{
+    Feature::setWeight(weight);
+    render();
+}
+
+void MintEye::setEmotion(const Emotion& emotion)
+{
+    if (getIgnoreEmotion()) {
+        return;
+    }
+    _emotion = emotion;
+    // The blink modifier reads this back as the open weight.
+    Feature::setWeight(100);
+    render();
+}
+
+Emotion MintEye::getEmotion() const
+{
+    return _emotion;
+}
+
+void MintEye::setVisible(bool visible)
+{
+    Element::setVisible(visible);
+    set_hidden(_container, !visible);
+}
+
+void MintEye::setSize(int size)
+{
+    Feature::setSize(size);
+    render();
+}
+
+void MintEye::render()
+{
+    const int cx      = kEyeBoxW / 2;
+    const int cy      = kEyeBoxH / 2;
+    const bool closed = _weight < kClosedEyeAt;
+    const float side  = _is_left_eye ? 1.0f : -1.0f;
+    uint32_t points   = 0;
+    float dot_radius  = 0;
+    std::array<lv_point_precise_t, 17> line{};
+    bool brow         = false;
+
+    enum class Shape { Dot, Up, Down, Point, Flat } shape = Shape::Dot;
+    switch (_emotion) {
+        case Emotion::Happy:
+            shape = Shape::Up;
+            break;
+        case Emotion::Angry:
+            shape = Shape::Point;
+            break;
+        case Emotion::Sad:
+            dot_radius = 8;
+            brow       = true;
+            break;
+        case Emotion::Doubt:
+            if (_is_left_eye) {
+                dot_radius = 9;
+            } else {
+                shape = Shape::Flat;
+                brow  = true;
+            }
+            break;
+        case Emotion::Sleepy:
+            shape = Shape::Down;
+            break;
+        case Emotion::Surprised:
+            dot_radius = 11;
+            break;
+        case Emotion::Wink:
+            if (_is_left_eye) {
+                dot_radius = 8;
+            } else {
+                shape = Shape::Up;
+            }
+            break;
+        case Emotion::Neutral:
+        default:
+            dot_radius = 8;
+            break;
+    }
+    if (shape == Shape::Dot && closed) {
+        shape = Shape::Flat;
+    }
+
+    switch (shape) {
+        case Shape::Up:  // "^"
+            points = quad(line, 0, 9, -13, 4, 0, -14, 13, 4, cx, cy);
+            break;
+        case Shape::Down:  // "u"
+            points = quad(line, 0, 9, -13, -4, 0, 14, 13, -4, cx, cy);
+            break;
+        case Shape::Point:  // ">" on the left eye, "<" on the right
+            points = quad(line, 0, 2, -11 * side, -10, 0, -5, 11 * side, 0, cx, cy);
+            points = quad(line, points, 2, 11 * side, 0, 0, 5, -11 * side, 10, cx, cy);
+            break;
+        case Shape::Flat:
+            points = quad(line, 0, 2, -12, 0, 0, 0, 12, 0, cx, cy);
+            break;
+        case Shape::Dot:
+            break;
+    }
+
+    set_hidden(_line, shape == Shape::Dot);
+    if (points > 0) {
+        set_points(_line, _line_points, _line_count, line, points);
+    }
+
+    set_hidden(_dot, shape != Shape::Dot);
+    if (shape == Shape::Dot) {
+        int scale    = lerp(_size, -100, 100, 70, 130);
+        int diameter = px(dot_radius * 2) * scale / 100;
+        lv_obj_set_size(_dot, diameter, diameter);
+        align(_dot, LV_ALIGN_CENTER, 0, 0);
+    }
+
+    set_hidden(_brow, !brow);
+    if (brow) {
+        std::array<lv_point_precise_t, 2> next{};
+        if (_emotion == Emotion::Sad) {  // inner end raised
+            float outer = _is_left_eye ? -12 : 12;
+            quad(next, 0, 2, outer, -13, 0, -18, -outer, -23, cx, cy);
+        } else {  // doubt: one raised brow
+            quad(next, 0, 2, -12, -22, 0, -19, 12, -16, cx, cy);
+        }
+        set_points(_brow, _brow_points, _brow_count, next, 2);
+    }
+}
+
+/* ---------------------------------- Mouth -------------------------------- */
+
+MintMouth::MintMouth(lv_obj_t* parent)
+{
+    _container = make_box(parent);
+    lv_obj_set_size(_container, kMouthBoxW, kMouthBoxH);
+    lv_obj_add_flag(_container, LV_OBJ_FLAG_OVERFLOW_VISIBLE);
+
+    // Filled cap: a pill clipped to its upper or lower half; the straight edge is a line on top.
+    _cap_box = make_box(_container);
+    _cap     = make_blob(_cap_box, kFill, kStroke);
+    _cap_tongue = make_blob(_cap, kTongue, 0);
+
+    _oval        = make_blob(_container, kFill, kStroke);
+    _oval_tongue = make_blob(_oval, kTongue, 0);
+
+    _teeth = make_blob(_container, kTeeth, kStroke);
+    lv_obj_set_style_radius(_teeth, 8, 0);
+    for (auto& line : _teeth_lines) {
+        line = make_line(_container, kMouthBoxW, kMouthBoxH, kThinStroke);
+    }
+
+    _line        = make_line(_container, kMouthBoxW, kMouthBoxH, kStroke);
+    _wink_tongue = make_blob(_container, kTongue, 4);
+    _parts = {_line,           _cap_box,        _cap_tongue,     _oval,           _oval_tongue,  _teeth,
+              _teeth_lines[0], _teeth_lines[1], _teeth_lines[2], _teeth_lines[3], _wink_tongue};
+
+    setPosition(_position);
+    render();
+}
+
+MintMouth::~MintMouth()
+{
+    lv_obj_delete(_container);
+}
+
+void MintMouth::setPosition(const Vector2i& position)
+{
+    Element::setPosition(position);
+    int x = lerp(_position.x, -100, 100, -kOffsetRange, kOffsetRange);
+    int y = kMouthY + lerp(_position.y, -100, 100, -kOffsetRange, kOffsetRange);
+    align(_container, LV_ALIGN_CENTER, x, y);
+}
+
+void MintMouth::setWeight(int weight)
+{
+    Feature::setWeight(weight);
+    render();
+}
+
+void MintMouth::setEmotion(const Emotion& emotion)
+{
+    if (getIgnoreEmotion()) {
+        return;
+    }
+    _emotion = emotion;
+    render();
+}
+
+Emotion MintMouth::getEmotion() const
+{
+    return _emotion;
+}
+
+void MintMouth::setVisible(bool visible)
+{
+    Element::setVisible(visible);
+    set_hidden(_container, !visible);
+}
+
+void MintMouth::showCap(int width, int height, int top, bool lowerHalf, bool tongue)
+{
+    const int cx = kMouthBoxW / 2;
+    const int cy = kMouthBoxH / 2;
+    show(_cap_box);
+    lv_obj_set_size(_cap_box, width, height);
+    lv_obj_set_pos(_cap_box, cx - width / 2, cy + top);
+    lv_obj_set_size(_cap, width, height * 2);
+    lv_obj_set_pos(_cap, 0, lowerHalf ? -height : 0);
+
+    if (tongue) {
+        show(_cap_tongue);
+        lv_obj_set_size(_cap_tongue, width * 53 / 100, px(14));
+        align(_cap_tongue, LV_ALIGN_BOTTOM_MID, 0, kStroke);
+    }
+
+    // The straight edge sits on the cut, so the stroke closes the shape.
+    float edge  = (lowerHalf ? top : top + height) / kScale;
+    float half  = (width / 2 - kStroke / 2) / kScale;
+    std::array<lv_point_precise_t, 17> line{};
+    uint32_t n = quad(line, 0, 2, -half, edge, 0, edge, half, edge, cx, cy);
+    show(_line);
+    set_points(_line, _line_points, _line_count, line, n);
+}
+
+void MintMouth::showOval(int width, int height, int centerY, bool tongue)
+{
+    show(_oval);
+    lv_obj_set_size(_oval, width, height);
+    align(_oval, LV_ALIGN_CENTER, 0, centerY);
+    if (tongue) {
+        show(_oval_tongue);
+        lv_obj_set_size(_oval_tongue, px(20), px(12));
+        align(_oval_tongue, LV_ALIGN_BOTTOM_MID, 0, kStroke / 2);
+    }
+}
+
+void MintMouth::show(lv_obj_t* part)
+{
+    for (size_t i = 0; i < _parts.size(); ++i) {
+        if (_parts[i] == part) {
+            _wanted[i] = true;
+        }
+    }
+}
+
+void MintMouth::render()
+{
+    // Decide which parts the face needs first, then hide or show each once, so a part that stays
+    // visible is never hidden and shown again (each flip repaints it).
+    _wanted.fill(false);
+    layout();
+    for (size_t i = 0; i < _parts.size(); ++i) {
+        set_hidden(_parts[i], !_wanted[i]);
+    }
+}
+
+void MintMouth::layout()
+{
+    const int cx = kMouthBoxW / 2;
+    const int cy = kMouthBoxH / 2;
+
+    // Lip sync: the speaking modifier swings weight between 0..20 (closed) and 40..80 (open).
+    if (_weight > kOpenMouthAt) {
+        int height = lerp(_weight, kOpenMouthAt, 100, px(9), px(36));
+        int width  = lerp(_weight, kOpenMouthAt, 100, px(40), px(60));
+        showCap(width, height, px(-10), true, height >= px(26));
+        return;
+    }
+
+    uint32_t n = 0;
+    std::array<lv_point_precise_t, 17> line{};
+    switch (_emotion) {
+        case Emotion::Happy:
+            showCap(px(60), px(36), px(-10), true, true);
+            return;
+        case Emotion::Angry: {
+            int w = px(56), h = px(22), y = px(3);
+            show(_teeth);
+            lv_obj_set_size(_teeth, w, h);
+            align(_teeth, LV_ALIGN_CENTER, 0, y);
+            std::array<std::array<lv_point_precise_t, 2>, 4> teeth{};
+            teeth[0][0] = {lv_value_precise_t(cx - w / 2), lv_value_precise_t(cy + y)};
+            teeth[0][1] = {lv_value_precise_t(cx + w / 2), lv_value_precise_t(cy + y)};
+            for (int i = 0; i < 3; ++i) {
+                int x                   = cx + px(14) * (i - 1);
+                teeth[i + 1][0] = {lv_value_precise_t(x), lv_value_precise_t(cy + y - h / 2)};
+                teeth[i + 1][1] = {lv_value_precise_t(x), lv_value_precise_t(cy + y + h / 2)};
+            }
+            for (size_t i = 0; i < _teeth_lines.size(); ++i) {
+                show(_teeth_lines[i]);
+                set_points(_teeth_lines[i], _teeth_points[i], _teeth_counts[i], teeth[i], 2);
+            }
+            return;
+        }
+        case Emotion::Sad:
+            showCap(px(48), px(13), px(-1), false, false);
+            return;
+        case Emotion::Doubt:  // a small wave
+            n = quad(line, 0, 9, -22, 2, -11, -7, 0, 2, cx, cy);
+            n = quad(line, n - 1, 9, 0, 2, 11, 11, 22, 2, cx, cy);
+            break;
+        case Emotion::Sleepy:
+            showOval(px(14), px(18), px(4), false);
+            return;
+        case Emotion::Surprised:
+            showOval(px(36), px(44), px(4), true);
+            return;
+        case Emotion::Wink:
+            n = quad(line, 0, 9, -26, -4, 0, 14, 26, -4, cx, cy);
+            show(_wink_tongue);
+            lv_obj_set_size(_wink_tongue, px(13), px(13));
+            align(_wink_tongue, LV_ALIGN_CENTER, px(17), px(9));
+            break;
+        case Emotion::Neutral:
+        default:  // a soft smile
+            n = quad(line, 0, 9, -26, -4, 0, 14, 26, -4, cx, cy);
+            break;
+    }
+    show(_line);
+    set_points(_line, _line_points, _line_count, line, n);
+}
