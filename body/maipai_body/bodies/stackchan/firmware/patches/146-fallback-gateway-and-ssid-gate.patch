diff --git a/firmware/main/hal/maipai_fallback_core.h b/firmware/main/hal/maipai_fallback_core.h
new file mode 100644
index 000000000..33af80cea
--- /dev/null
+++ b/firmware/main/hal/maipai_fallback_core.h
@@ -0,0 +1,62 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The pure choices behind the away-from-home fallback (patch 146), plain C so a host test can run them:
+ * which hosts to try (the Wi-Fi gateway first, then a configured address) and which networks may use the fallback
+ * at all (only one whose name starts with a prefix the owner controls, so a stranger's network is never given the
+ * robot's pairing token).
+ */
+#pragma once
+#include <stddef.h>
+#include <string.h>
+#include <strings.h>
+
+/* 1 when the connected network's name starts with `prefix` (case-insensitive). An empty prefix allows every network
+ * (a development setting); an empty or missing ssid never matches a non-empty prefix. */
+static inline int mf_ssid_allowed(const char* ssid, const char* prefix)
+{
+    if (prefix == NULL || prefix[0] == '\0') {
+        return 1;
+    }
+    if (ssid == NULL || ssid[0] == '\0') {
+        return 0;
+    }
+    return strncasecmp(ssid, prefix, strlen(prefix)) == 0 ? 1 : 0;
+}
+
+static inline int mf_usable_host(const char* host, const char* home)
+{
+    if (host == NULL || host[0] == '\0' || strcmp(host, "0.0.0.0") == 0) {
+        return 0;
+    }
+    if (home != NULL && strcmp(host, home) == 0) {
+        return 0;  /* the home address is already the first attempt: a fallback that is the same host adds nothing */
+    }
+    return 1;
+}
+
+/* The fallback host for attempt number `attempt` (0, 1, 2 ...): candidates are the Wi-Fi default gateway, then the
+ * configured host (skipping a duplicate, a 0.0.0.0 and the home host), rotating by attempt. Returns 1 and fills `out`
+ * when there is a candidate, else 0. */
+static inline int mf_pick_host(int attempt, const char* gateway, const char* configured, const char* home, char* out,
+                               size_t out_size)
+{
+    const char* cand[2];
+    int n = 0;
+    if (mf_usable_host(gateway, home)) {
+        cand[n++] = gateway;
+    }
+    if (mf_usable_host(configured, home) && !(n == 1 && strcmp(cand[0], configured) == 0)) {
+        cand[n++] = configured;
+    }
+    if (n == 0 || out == NULL || out_size == 0) {
+        return 0;
+    }
+    const char* chosen = cand[(attempt < 0 ? 0 : attempt) % n];
+    size_t len = strlen(chosen);
+    if (len + 1 > out_size) {
+        return 0;
+    }
+    memcpy(out, chosen, len + 1);
+    return 1;
+}
