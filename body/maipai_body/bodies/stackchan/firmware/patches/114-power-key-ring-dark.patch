+    // The power key (patch 114). REG 0x27 above gives the key's "long press" flag at about 1 s and the PMIC's own
+    // power cut at about 4 s (the shortest settings; the bit meanings are from the AXP2101 register map and are
+    // not yet checked on a unit). REG 0x41 bit 2 lets the PMIC keep the long-press flag in REG 0x49 (the IRQ
+    // pin is not used); TakePowerKeyLong() reads and clears it.
+    void EnablePowerKeyFlag()
+    {
+        uint8_t enable = 0;
+        if (TryReadRegs(0x41, &enable, 1, 100) == ESP_OK) {
+            WriteReg(0x41, enable | 0x04);
+        }
+        WriteReg(0x49, 0x0F);  // whatever the press that switched the unit on left behind
+    }
+
+    bool TakePowerKeyLong()
+    {
+        uint8_t status = 0;
+        if (TryReadRegs(0x49, &status, 1, 20) != ESP_OK || (status & 0x04) == 0) {
+            return false;
+        }
+        WriteReg(0x49, 0x04);
+        return true;
+    }
