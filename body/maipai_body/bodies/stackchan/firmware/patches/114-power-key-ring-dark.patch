+    // Holding the power key. At about 1 s the PMIC flags a long press; at about 4 s it cuts power with no warning.
+    // In between the ring goes dark and the face shuts its eyes, so the cut lands on a sleeping, unlit unit (the
+    // base keeps the ring's last colours when the CoreS3 loses power, so it must be dark before). A key let go
+    // before the cut puts the ring and the face back after a few seconds.
+    void PollPowerKey()
+    {
+        const int64_t now_ms = esp_timer_get_time() / 1000;
+        if (now_ms - last_power_key_poll_ms_ < kPowerKeyPollIntervalMs) {
+            return;
+        }
+        last_power_key_poll_ms_ = now_ms;
+        if (power_key_hold_ms_ != 0) {
+            if (now_ms - power_key_hold_ms_ >= kPowerKeyRestoreAfterMs) {
+                ESP_LOGW(TAG, "power key let go before the cut: ring and face back");
