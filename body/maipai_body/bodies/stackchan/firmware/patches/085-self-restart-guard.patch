index 0000000..1676472
--- /dev/null
+++ b/firmware/main/hal/heal_guard.cpp
@@ -0,0 +1,141 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+// The self-restart guard (patch 085). Every restart the unit chooses for itself (the host asked, the
+// main loop stalled for 30 s, a failed wake-word self-test twice in a row) goes through
+// maipai_heal_restart. At most kMaxPerHour of them an hour: the next is refused, logged and
+// reported as heal_hold=1, so a fault that survives a restart can never become a reboot loop.
+// Panics are not chosen and are not counted here (crash_resets counts them).
+//
+// The hour is counted in the unit's own running time, because the unit has no clock that survives a
+// restart: NVS holds how many restarts the window has seen (heal_n) and how many seconds the window
+// has run as of the last of them (heal_s); at boot kBootGapS is added for the restart itself. A
+// power loss does not reset the count, so the window only ends after an hour of running.
+#include "device_events.h"
+
+#include <esp_log.h>
+#include <esp_system.h>
+#include <esp_timer.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <settings.h>
+
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <mutex>
+
+namespace {
+constexpr int kMaxPerHour = 3;
+constexpr int kWindowS    = 3600;
+constexpr int kBootGapS   = 10;  // what a restart itself costs, added to the window clock at boot
+
+std::mutex s_mutex;
+bool s_loaded   = false;
+int s_count     = 0;  // restarts in the current window
+int s_window_s  = 0;  // window clock at boot
+
+struct Request {
+    char why[16];
+    uint32_t delay_ms;
+};
+
+void load_locked()
+{
+    if (s_loaded) {
+        return;
+    }
+    s_loaded = true;
+    Settings settings("maipai", false);
+    s_count    = settings.GetInt("heal_n", 0);
+    s_window_s = settings.GetInt("heal_s", 0) + kBootGapS;
+}
+
+int elapsed_locked()
+{
+    return s_window_s + static_cast<int>(esp_timer_get_time() / 1000000);
+}
+
+// A window that has run an hour starts over.
+void expire_locked()
+{
+    if (s_count > 0 && elapsed_locked() >= kWindowS) {
+        s_count    = 0;
+        s_window_s = -static_cast<int>(esp_timer_get_time() / 1000000);
+    }
+}
+
+void restart_task(void* arg)
+{
+    std::unique_ptr<Request> request(static_cast<Request*>(arg));
+    vTaskDelay(pdMS_TO_TICKS(request->delay_ms));
+    int count = 0;
+    bool allowed;
+    {
+        std::lock_guard<std::mutex> lock(s_mutex);
+        load_locked();
+        expire_locked();
+        allowed = s_count < kMaxPerHour;
+        count   = s_count;
+    }
+    char extra[80];
+    if (!allowed) {
+        ESP_LOGW("HealGuard", "restart refused (%s): %d self-restarts this hour already", request->why, count);
+        snprintf(extra, sizeof(extra), "\"action\":\"refused\",\"why\":\"%s\",\"n\":%d", request->why, count);
+        device_events_push_diag("heal", extra);
+        vTaskDelete(nullptr);
+        return;
+    }
+    ESP_LOGW("HealGuard", "restarting (%s): self-restart %d of %d this hour", request->why, count + 1, kMaxPerHour);
+    snprintf(extra, sizeof(extra), "\"action\":\"restart\",\"why\":\"%s\",\"n\":%d", request->why, count + 1);
+    device_events_push_diag("heal", extra);
+    vTaskDelay(pdMS_TO_TICKS(300));  // the log line and the event leave first
+    {
+        std::lock_guard<std::mutex> lock(s_mutex);
+        Settings settings("maipai", true);
+        settings.SetInt("heal_n", s_count + 1);
+        settings.SetInt("heal_s", elapsed_locked());
+        settings.SetString("heal_why", request->why);
+    }
+    esp_restart();
+}
+}  // namespace
+
+void maipai_heal_restart(const char* why, uint32_t delay_ms)
+{
+    // A short task with an internal 4 KB stack: the caller may be a task whose stack is in PSRAM (the
+    // motion sensor task is), and a flash write from such a task aborts the unit (patch 074).
+    auto* request = new Request{};
+    snprintf(request->why, sizeof(request->why), "%s", why != nullptr ? why : "?");
+    request->delay_ms = delay_ms;
+    if (xTaskCreate(restart_task, "heal_restart", 4096, request, 5, nullptr) != pdPASS) {
+        ESP_LOGW("HealGuard", "could not start the restart task (%s)", request->why);
+        delete request;
+    }
+}
+
+void maipai_heal_status(int* count, bool* hold)
+{
+    std::lock_guard<std::mutex> lock(s_mutex);
+    load_locked();
+    expire_locked();
+    if (count != nullptr) {
+        *count = s_count;
+    }
+    if (hold != nullptr) {
+        *hold = s_count >= kMaxPerHour;
+    }
+}
+
+// The reason the last restart was chosen ("host", "stall", "deaf"), read once at boot; empty when
+// the last restart was a power-on or a panic.
+void maipai_heal_take_reason(char* out, size_t size)
+{
+    out[0] = '\0';
+    Settings settings("maipai", true);
+    std::string why = settings.GetString("heal_why", "");
+    if (!why.empty()) {
+        snprintf(out, size, "%s", why.c_str());
+        settings.EraseKey("heal_why");
+    }
+}
