+void AudioService::GetQueueDepths(size_t& decode, size_t& playback) {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    decode = audio_decode_queue_.size();
+    playback = audio_playback_queue_.size();
+}
+
+void AudioService::TakePlaybackGaps(uint32_t& count, int& max_ms) {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    count = playback_gap_count_;
+    max_ms = playback_gap_max_ms_;
+    playback_gap_count_ = 0;
+    playback_gap_max_ms_ = 0;
