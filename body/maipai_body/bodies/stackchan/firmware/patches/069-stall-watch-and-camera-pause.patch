diff --git a/firmware/main/hal/hal_imu.cpp b/firmware/main/hal/hal_imu.cpp
index c42cf29..98d8aac 100644
--- a/firmware/main/hal/hal_imu.cpp
+++ b/firmware/main/hal/hal_imu.cpp
@@ -12,11 +12,46 @@
 #include <cstdio>
 #include <cmath>
 #include "device_events.h"
+#include <atomic>
+#include <string>
+#include <settings.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
 
 static const std::string_view _tag = "HAL-IMU";
 
 static std::unique_ptr<BMI270> _bmi270;
 
+// The application main loop adds one every second (application.cc, clock tick). If it stops for 8 s
+// the unit is stalled while its socket may still be open (host log 2026-10-22: every tool call timed
+// out, no reboot, no crash). The host cannot be told then (events leave through that same loop), so
+// the state of the known tasks is written to flash and reported in the "boot" event after the next
+// restart ("stall").
+std::atomic<uint32_t> g_main_alive{0};
+
+static void _dump_stall()
+{
+    static const char* names[] = {"main",         "LVGL",       "taskLVGL",  "lvgl_port", "stackchan",
+                                  "avatar_ws",    "opus_codec", "audio_input", "audio_output", "audio_detection",
+                                  "ws_reconnect", "headtouch",  "imu",       "tiT",       "wifi",
+                                  "esp_timer",    "sys_evt",    "IDLE0",     "IDLE1"};
+    std::string out;
+    for (const char* name : names) {
+        TaskHandle_t task = xTaskGetHandle(name);
+        if (task == nullptr) {
+            continue;
+        }
+        const char state = "RrBSD?"[eTaskGetState(task) < 5 ? static_cast<int>(eTaskGetState(task)) : 5];
+        char one[40];
+        snprintf(one, sizeof(one), "%s%s:%c/%u", out.empty() ? "" : " ", name, state,
+                 static_cast<unsigned>(uxTaskGetStackHighWaterMark(task)));
+        out += one;
+    }
+    mclog::tagInfo(_tag, "main loop stalled; tasks: {}", out);
+    Settings settings("maipai", true);
+    settings.SetString("stall", out.substr(0, 230));
+}
+
