 /* --------------------------------- Avatar -------------------------------- */
 
+// Teeth stay white; every other part is recognised by the palette color it was drawn with.
+static void recolor(lv_obj_t* obj, const lv_color_t& oldInk, const lv_color_t& oldFill, const lv_color_t& oldTongue)
+{
+    if (lv_obj_check_type(obj, &lv_line_class)) {
+        lv_obj_set_style_line_color(obj, kInk, 0);
+    } else {
+        lv_color_t bg = lv_obj_get_style_bg_color(obj, LV_PART_MAIN);
+        if (lv_color_eq(bg, oldInk)) {
+            lv_obj_set_style_bg_color(obj, kInk, 0);
+        } else if (lv_color_eq(bg, oldFill)) {
+            lv_obj_set_style_bg_color(obj, kFill, 0);
+        } else if (lv_color_eq(bg, oldTongue)) {
+            lv_obj_set_style_bg_color(obj, kTongue, 0);
+        }
+        if (lv_obj_get_style_border_width(obj, LV_PART_MAIN) > 0) {
+            lv_obj_set_style_border_color(obj, kInk, 0);
+        }
+    }
+    for (uint32_t i = 0; i < lv_obj_get_child_count(obj); ++i) {
+        recolor(lv_obj_get_child(obj, i), oldInk, oldFill, oldTongue);
+    }
+}
+
+bool MintAvatar::setPalette(const char* name, bool night)
+{
+    const Palette* next = night ? &kNightPalette : nullptr;
+    for (const auto& palette : kPalettes) {
+        if (!next && name && std::strcmp(palette.name, name) == 0) {
+            next = &palette;
+        }
+    }
+    if (!next) {
+        return false;
+    }
+    const lv_color_t oldInk = kInk, oldFill = kFill, oldTongue = kTongue;
+    kBg     = lv_color_hex(next->bg);
+    kInk    = lv_color_hex(next->ink);
+    kFill   = lv_color_hex(next->fill);
+    kTongue = lv_color_hex(next->tongue);
+    if (_panel) {  // before init() there is nothing drawn yet; init() reads the colors above
+        _panel->setBgColor(kBg);
+        for (uint32_t i = 0; i < lv_obj_get_child_count(_panel->get()); ++i) {
+            recolor(lv_obj_get_child(_panel->get(), i), oldInk, oldFill, oldTongue);
+        }
+        lv_obj_invalidate(_panel->get());
+    }
+    return true;
+}
