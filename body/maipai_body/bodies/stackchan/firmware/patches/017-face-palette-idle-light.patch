+bool StackChanAvatarDisplay::SetFacePalette(const char* palette, bool night)
+{
+    auto& stackchan = GetStackChan();
+    if (!stackchan.hasAvatar()) {
+        return false;
+    }
+    auto* avatar = dynamic_cast<MintAvatar*>(&stackchan.avatar());
+    if (!avatar || !avatar->setPalette(palette, night)) {
+        return false;
+    }
+    if (!night) {  // night is a mode, not a choice: only the palette name is saved
+        Settings settings("xiaozhi", true);
+        settings.SetString("face_pal", palette);
+    }
+    return true;
+}
+
+void StackChanAvatarDisplay::SetIdleMotionEnabled(bool enabled)
+{
+    // A runtime gate: the stored idle_lv is not touched.
+    idle_motion_enabled_ = enabled;
+    auto& stackchan      = GetStackChan();
+    if (!enabled && idle_motion_modifier_id_ >= 0) {
+        stackchan.removeModifier(idle_motion_modifier_id_);
+        idle_motion_modifier_id_ = -1;
+    } else if (enabled && idle_expression_modifier_id_ >= 0 && !is_sleeping_ && idle_motion_modifier_id_ < 0 && idle_motion_level_ > 0) {
+        CreateIdleMotionModifier();
+    }
+}
