+// LTR-553ALS ambient light sensor on the CoreS3 internal I2C bus. Light channels only, no proximity.
+namespace {
+constexpr uint8_t kLtr553Address = 0x23;
+constexpr uint8_t kLtr553AlsContr = 0x80;
+constexpr uint8_t kLtr553AlsData  = 0x88;  // CH1 low, CH1 high, CH0 low, CH0 high
+
+i2c_master_dev_handle_t ltr553 = nullptr;
+
+void ltr553_init()
+{
+    auto bus = hal_bridge::board_get_i2c_bus();
+    i2c_device_config_t config = {};
+    config.dev_addr_length     = I2C_ADDR_BIT_LEN_7;
+    config.device_address      = kLtr553Address;
+    config.scl_speed_hz        = 400000;
+    const uint8_t enable[]     = {kLtr553AlsContr, 0x01};  // active, gain 1x
+    if (!bus || i2c_master_probe(bus, kLtr553Address, 100) != ESP_OK ||
+        i2c_master_bus_add_device(bus, &config, &ltr553) != ESP_OK ||
+        i2c_master_transmit(ltr553, enable, sizeof(enable), 100) != ESP_OK) {
+        ESP_LOGW("HAL-MCP", "ltr553 absent");
+        ltr553 = nullptr;
+    }
+}
+
+bool ltr553_read_lux(float& lux)
+{
+    if (!ltr553) {
+        return false;
+    }
+    const uint8_t reg = kLtr553AlsData;
+    uint8_t data[4]   = {};
+    if (i2c_master_transmit_receive(ltr553, &reg, 1, data, sizeof(data), 100) != ESP_OK) {
+        return false;
+    }
+    const float ch1 = data[0] | (data[1] << 8);
+    const float ch0 = data[2] | (data[3] << 8);
+    if (ch0 + ch1 <= 0) {
+        lux = 0;
+        return true;
+    }
+    // Datasheet ratio formula, gain 1x and 100 ms integration (the power-on default).
+    const float ratio = ch1 / (ch0 + ch1);
+    if (ratio < 0.45f) {
+        lux = 1.7743f * ch0 + 1.1059f * ch1;
+    } else if (ratio < 0.64f) {
+        lux = 4.2785f * ch0 - 1.9548f * ch1;
+    } else if (ratio < 0.85f) {
+        lux = 0.5926f * ch0 + 0.1185f * ch1;
+    } else {
+        lux = 0;
+    }
+    return true;
+}
+}  // namespace
