+
+void AfeWakeWord::RequestRebuild() {
+    s_rebuild_request.store(true);
+}
+
+// Builds the front end again from the same configuration, on the detection task between two fetches
+// (nothing else uses the old one then). It resets the echo canceller and WakeNet's state, and takes
+// about 400 ms; the audio input task waits on the same lock meanwhile.
+void AfeWakeWord::RebuildEngine() {
+    if (afe_config_ == nullptr) {
+        return;
+    }
+    const int64_t start = esp_timer_get_time();
+    {
+        std::lock_guard<std::mutex> lock(input_buffer_mutex_);
+        afe_iface_->destroy(afe_data_);
+        afe_data_ = afe_iface_->create_from_config(afe_config_);
+        input_buffer_.clear();
+    }
+    s_rebuilds++;
+    char extra[48];
+    snprintf(extra, sizeof(extra), "\"result\":\"rebuilt\",\"ms\":%d", static_cast<int>((esp_timer_get_time() - start) / 1000));
+    ESP_LOGW(TAG, "Wake engine rebuilt: %s", extra);
+    device_events_push_diag("wake_selftest", extra);
+}
+
+// Called from the application's system command (application.cc), on the websocket task. True when the
+// test started: the wake word is armed (the unit is idle) and the clip is in the assets.
+bool maipai_wake_selftest_start() {
+    if (s_instance == nullptr || !s_instance->IsRunning()) {
+        return false;
+    }
+    if (s_selftest.load() != 0) {
+        if (esp_timer_get_time() - s_selftest_started_us.load() < 10 * 1000000LL) {
+            return false;
+        }
+        s_selftest.store(0);  // a test that never ended (the feed stopped): start over
+    }
+    if (s_clip == nullptr) {
+        void* ptr = nullptr;
+        size_t size = 0;
+        if (!Assets::GetInstance().GetAssetData("wake_selftest.pcm", ptr, size) || size < 3200) {
+            ESP_LOGW(TAG, "Wake self-test clip is not in the assets");
+            return false;
+        }
+        auto* copy = static_cast<int16_t*>(heap_caps_malloc(size & ~static_cast<size_t>(1), MALLOC_CAP_SPIRAM));
+        if (copy == nullptr) {
+            return false;
+        }
+        memcpy(copy, ptr, size & ~static_cast<size_t>(1));
+        s_clip_len = size / 2;
+        s_clip = copy;
+    }
+    s_selftest_hits.store(0);
+    s_inject_pos = 0;
+    s_selftest_started_us.store(esp_timer_get_time());
+    s_selftest.store(1);
+    return true;
+}
+
+void maipai_wake_rebuild() {
+    if (s_instance != nullptr) {
+        s_instance->RequestRebuild();
+    }
+}
