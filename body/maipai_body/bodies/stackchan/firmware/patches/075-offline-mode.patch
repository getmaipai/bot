+// One "wifi" event for the host log: what the link to the hub is doing and why. Pushed to the unit's
+// event queue, so the host reads it once it is connected again.
+static void push_link_event(const char* state, unsigned attempt, int error, unsigned next_ms, unsigned took_ms) {
+    wifi_ap_record_t ap = {};
+    const bool wifi_up = esp_wifi_sta_get_ap_info(&ap) == ESP_OK;
+    char extra[160];
+    snprintf(extra, sizeof(extra),
+             "\"state\":\"%s\",\"wifi\":%d,\"rssi\":%d,\"attempt\":%u,\"error\":%d,\"next_ms\":%u,\"took_ms\":%u",
+             state, wifi_up ? 1 : 0, wifi_up ? ap.rssi : 0, attempt, error, next_ms, took_ms);
+    ESP_LOGI(TAG, "unit wifi: %s", extra);
+    device_events_push_diag("wifi", extra);
+}
