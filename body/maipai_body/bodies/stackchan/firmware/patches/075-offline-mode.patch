+void Application::ShowCantReachHome() {
+    ESP_LOGW(TAG, "Can't reach Home: a tap or the wake word found no hub link");
+    device_events_push_diag("offline_tap", "\"why\":\"hub_unreachable\"");
+    // Idle first (it resets the face), then the calm face, the words and a short tone.
+    SetDeviceState(kDeviceStateIdle);
+    auto display = Board::GetInstance().GetDisplay();
+    display->SetEmotion("doubtful");
+    display->SetChatMessage("system", "Can't reach Home");
+    audio_service_.PlaySound(Lang::Sounds::OGG_VIBRATION);
+    // After three seconds the face goes back to neutral and the "Offline" words return if the outage goes on.
+    static esp_timer_handle_t restore_timer = nullptr;
+    if (restore_timer == nullptr) {
+        esp_timer_create_args_t args = {};
+        args.callback = [](void*) {
+            Application::GetInstance().Schedule([]() {
+                auto& app = Application::GetInstance();
+                if (app.GetDeviceState() != kDeviceStateIdle) {
+                    return;
+                }
+                Board::GetInstance().GetDisplay()->SetEmotion("neutral");
+                hal_bridge::offline_indicator_refresh();
+            });
+        };
+        args.name = "cant_reach_home";
+        esp_timer_create(&args, &restore_timer);
     }
+    esp_timer_stop(restore_timer);
+    esp_timer_start_once(restore_timer, 3 * 1000 * 1000);
 }
 
