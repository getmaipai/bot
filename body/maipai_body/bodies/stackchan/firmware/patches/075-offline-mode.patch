+void hal_bridge::leds_offline(bool on)
+{
+    if (!_io_expander || on == _rgb_offline) {
+        return;
+    }
+    _rgb_offline = on;
+    for (int i = 0; i < 12; i++) {
+        if (_rgb_blank) {
+            _io_expander->setLedColor(i, 0, 0, 0);
+        } else if (on) {
+            _io_expander->setLedColor(i, kOfflineAmber[0], kOfflineAmber[1], kOfflineAmber[2]);
+        } else {
+            _io_expander->setLedColor(i, _rgb_shadow[i][0], _rgb_shadow[i][1], _rgb_shadow[i][2]);
+        }
+    }
+    _io_expander->refreshLeds();
+}
