 void WebsocketProtocol::ReconnectTask(void* arg) {
     auto* self = static_cast<WebsocketProtocol*>(arg);
     constexpr uint32_t kInitialDelayMs = 1000;
-    constexpr uint32_t kMaximumDelayMs = 60000;
+    constexpr uint32_t kMaximumDelayMs = 30000;
     constexpr uint32_t kStableConnectionMs = 30000;
+    constexpr int64_t kOfflineIndicatorAfterUs = 10LL * 1000 * 1000;  // a blip is not an outage
     uint32_t delay_ms = kInitialDelayMs;
+    unsigned attempt = 0;
+    int64_t down_since_us = esp_timer_get_time();
+    bool offline_shown = false;
 
     while (!(xEventGroupGetBits(self->event_group_handle_) & WEBSOCKET_PROTOCOL_STOP_EVENT)) {
         xEventGroupClearBits(self->event_group_handle_, WEBSOCKET_PROTOCOL_DISCONNECTED_EVENT | WEBSOCKET_PROTOCOL_CONNECTED_EVENT);
+        attempt++;
+        const int64_t started_us = esp_timer_get_time();
+        // The radio stays awake while the hub is not reached (hal_bridge::set_hub_link(false) makes the
+        // board hold Wi-Fi power save at NONE): in modem sleep the mesh AP did not deliver the SYN-ACK.
+        hal_bridge::set_hub_link(false);
         if (self->ConnectAudioChannel()) {
+            const unsigned took_ms = static_cast<unsigned>((esp_timer_get_time() - started_us) / 1000);
+            attempt = 0;
+            hal_bridge::set_hub_link(true);
+            if (offline_shown) {
+                offline_shown = false;
+                hal_bridge::offline_indicator(false);
+            }
+            push_link_event("ws_up", 0, 0, 0, took_ms);
             TickType_t connected_at = xTaskGetTickCount();
             EventBits_t bits = xEventGroupWaitBits(self->event_group_handle_, WEBSOCKET_PROTOCOL_DISCONNECTED_EVENT | WEBSOCKET_PROTOCOL_STOP_EVENT, pdTRUE, pdFALSE, portMAX_DELAY);
             if (bits & WEBSOCKET_PROTOCOL_STOP_EVENT) {
                 break;
             }
             xEventGroupClearBits(self->event_group_handle_, WEBSOCKET_PROTOCOL_CONNECTED_EVENT);
+            hal_bridge::set_hub_link(false);
+            down_since_us = esp_timer_get_time();
+            push_link_event("ws_down", 0, 0, 0, 0);
             if ((xTaskGetTickCount() - connected_at) >= pdMS_TO_TICKS(kStableConnectionMs)) {
                 delay_ms = kInitialDelayMs;
             }
+        } else {
+            const unsigned took_ms = static_cast<unsigned>((esp_timer_get_time() - started_us) / 1000);
+            uint32_t next_ms = std::min(kMaximumDelayMs, delay_ms);
+            ESP_LOGW(TAG, "Hub connect failed (attempt %u, %u ms), retry in about %u ms", attempt, took_ms, static_cast<unsigned>(next_ms));
+            push_link_event("ws_retry", attempt, self->last_connect_error_, next_ms, took_ms);
         }
 
         if (xEventGroupGetBits(self->event_group_handle_) & WEBSOCKET_PROTOCOL_STOP_EVENT) {
             break;
         }
+        if (!offline_shown && (esp_timer_get_time() - down_since_us) >= kOfflineIndicatorAfterUs) {
+            offline_shown = true;
+            hal_bridge::offline_indicator(true);
+        }
         uint32_t jitter_ms = esp_random() % (delay_ms / 4 + 1);
         uint32_t wait_ms = std::min(kMaximumDelayMs, delay_ms + jitter_ms);
         EventBits_t bits = xEventGroupWaitBits(self->event_group_handle_, WEBSOCKET_PROTOCOL_STOP_EVENT, pdTRUE, pdFALSE, pdMS_TO_TICKS(wait_ms));
