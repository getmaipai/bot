+/* The least time between two plays of the same cue (owner rule 2026-11-14: a chime is for something a person must
+ * notice, never repeating). The unit enforces it for every cue that goes through the gate, so a flapping trigger
+ * (a charger reading, a battery icon at its threshold, a retrying link) cannot beep over and over. 0 = no limit. */
+static const uint32_t MS_SOUND_MIN_GAP_MS[MS_SND_COUNT] = {
+    0u,       /* needs_you: the first-setup cue repeats once a minute by its own rule */
+    30000u,   /* plug_in */
+    60000u,   /* charged */
+    30000u,   /* unplug */
+    60000u,   /* offline */
+    0u,       /* goodbye */
+    1500u,    /* shutter: one click per picture */
+    30000u,   /* success */
+    0u,       /* popup: the wake word answer never goes through the gate */
+    5000u,    /* vibration */
+    10000u,   /* exclamation */
+    600000u,  /* low_battery: once per ten minutes */
+};
+
+/* True when `snd` may play now given when it last played (last_ms == 0 means never). Wrap safe. */
+static inline int ms_gap_ok(uint32_t last_ms, uint32_t now_ms, int snd)
+{
+    if (snd < 0 || snd >= MS_SND_COUNT || last_ms == 0u) {
+        return 1;
+    }
+    return (uint32_t)(now_ms - last_ms) >= MS_SOUND_MIN_GAP_MS[snd];
+}
