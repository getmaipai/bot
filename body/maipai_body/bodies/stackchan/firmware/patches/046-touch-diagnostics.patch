# Intent: diagnostics for the face screen's touch path (2026-10-21; swipes and taps did nothing on the unit). Each finger down (with x and y) and up, and each LVGL event the face panel gets (pressed, clicked with the xiaozhi-ready flag, gesture with its direction, a gesture ignored and why), is written to the serial log and queued for the host as a low-rate event in patch 021's queue (kinds touch_down, touch_up, face_pressed, face_clicked, gesture, gesture_ignored; at most 20 a minute, none queued while the queue is nearly full). The host logs each as "unit touch: ..." (kinds and coordinates only).
# Upstream: m5stack/StackChan firmware/main/hal/hal.cpp, hal/hal_mcp.cpp, hal/board/stackchan_display.cc, stackchan_display.h (MIT); new file hal/device_events.h. Applies after 044 with --unidiff-zero.
# Check after a flash: touch and swipe the face for 30 s; the host log shows "unit touch:" lines. No touch_down means the controller reports nothing; touch_down without face_pressed means another object gets the touch; face_pressed without gesture or face_clicked means LVGL did not recognise the swipe or tap.
diff --git a/firmware/main/hal/board/stackchan_display.cc b/firmware/main/hal/board/stackchan_display.cc
index 78593d0..03e63c4 100644
--- a/firmware/main/hal/board/stackchan_display.cc
+++ b/firmware/main/hal/board/stackchan_display.cc
@@ -25,0 +26 @@
+#include <hal/device_events.h>
@@ -284,0 +286,2 @@ void StackChanAvatarDisplay::SetupUI()
+    // Diagnostic (patch 046): every LVGL touch event the face panel receives, one line each.
+    lv_obj_add_event_cb(avatar->getPanel()->get(), &StackChanAvatarDisplay::OnTouchDiag, LV_EVENT_ALL, this);
@@ -390,0 +394,32 @@ void StackChanAvatarDisplay::BootRingTick(lv_timer_t* timer)
+void StackChanAvatarDisplay::OnTouchDiag(lv_event_t* event)
+{
+    auto* self = static_cast<StackChanAvatarDisplay*>(lv_event_get_user_data(event));
+    switch (lv_event_get_code(event)) {
+        case LV_EVENT_PRESSED:
+            ESP_LOGI(TAG, "face: pressed (boot_done=%d, panel_open=%d)", self != nullptr && self->boot_done_,
+                     self != nullptr && self->quick_panel_ != nullptr);
+            device_events_push_diag("face_pressed", "");
+            break;
+        case LV_EVENT_CLICKED:
+            ESP_LOGI(TAG, "face: clicked (xiaozhi_ready=%d)", hal_bridge::is_xiaozhi_ready());
+            device_events_push_diag("face_clicked", hal_bridge::is_xiaozhi_ready() ? "\"ready\":true" : "\"ready\":false");
+            break;
+        case LV_EVENT_LONG_PRESSED:
+            ESP_LOGI(TAG, "face: long pressed");
+            break;
+        case LV_EVENT_SCROLL_BEGIN:
+            ESP_LOGI(TAG, "face: scroll began");
+            break;
+        case LV_EVENT_GESTURE: {
+            const int dir = static_cast<int>(lv_indev_get_gesture_dir(lv_indev_active()));
+            ESP_LOGI(TAG, "face: gesture dir=%d (1 left, 2 right, 4 top, 8 bottom)", dir);
+            char extra[24];
+            snprintf(extra, sizeof(extra), "\"dir\":%d", dir);
+            device_events_push_diag("gesture", extra);
+            break;
+        }
+        default:
+            break;
+    }
+}
+
@@ -397,0 +433,3 @@ void StackChanAvatarDisplay::OnGesture(lv_event_t* event)
+        ESP_LOGI(TAG, "face: gesture ignored (boot_done=%d, panel_open=%d)", self->boot_done_,
+                 self->quick_panel_ != nullptr);
+        device_events_push_diag("gesture_ignored", !self->boot_done_ ? "\"why\":\"boot\"" : "\"why\":\"panel_open\"");
