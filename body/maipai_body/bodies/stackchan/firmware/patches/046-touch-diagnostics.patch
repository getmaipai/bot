diff --git a/firmware/main/hal/device_events.h b/firmware/main/hal/device_events.h
new file mode 100644
index 0000000..d6c0f45
--- /dev/null
+++ b/firmware/main/hal/device_events.h
@@ -0,0 +1,10 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+
+// A low-rate diagnostic event for the host (patch 046): kind must be a string literal, extra is
+// JSON object members without braces, for example "\"x\":12,\"y\":34", or empty. At most 20 a
+// minute are kept and none are queued when the queue is nearly full, so a diagnostic never pushes
+// a real touch or shake event out.
+void device_events_push_diag(const char* kind, const char* extra);
diff --git a/firmware/main/hal/hal.cpp b/firmware/main/hal/hal.cpp
index 84b8341..3dcb122 100644
--- a/firmware/main/hal/hal.cpp
+++ b/firmware/main/hal/hal.cpp
@@ -6,0 +7,2 @@
+#include "device_events.h"
+#include <cstdio>
@@ -307,0 +310,17 @@ static void lvgl_read_cb(lv_indev_t* indev, lv_indev_data_t* data)
+    // Diagnostic (patch 046): one line when a finger goes down or lifts, with where.
+    static bool s_diag_down = false;
+    const bool diag_down    = bridge_data.touchPoint.num != 0;
+    if (diag_down != s_diag_down) {
+        s_diag_down = diag_down;
+        if (diag_down) {
+            mclog::tagInfo(_tag, "touch down x={} y={}", bridge_data.touchPoint.x, bridge_data.touchPoint.y);
+            char extra[40];
+            snprintf(extra, sizeof(extra), "\"x\":%d,\"y\":%d", static_cast<int>(bridge_data.touchPoint.x),
+                     static_cast<int>(bridge_data.touchPoint.y));
+            device_events_push_diag("touch_down", extra);
+        } else {
+            mclog::tagInfo(_tag, "touch up");
+            device_events_push_diag("touch_up", "");
+        }
+    }
+
diff --git a/firmware/main/hal/hal_mcp.cpp b/firmware/main/hal/hal_mcp.cpp
index 362a01e..0875804 100644
--- a/firmware/main/hal/hal_mcp.cpp
+++ b/firmware/main/hal/hal_mcp.cpp
@@ -19,0 +20,2 @@
+#include "device_events.h"
+#include <string>
@@ -53,0 +56 @@ struct DeviceEvent {
+    std::string extra;  // JSON members without braces; diagnostics only
@@ -65 +68,21 @@ void push_event(const char* kind)
-    s_events.push_back({kind, static_cast<uint32_t>(esp_timer_get_time() / 1000)});
+    s_events.push_back({kind, static_cast<uint32_t>(esp_timer_get_time() / 1000), {}});
+}
+
+constexpr int kMaxDiagEventsPerMinute = 20;
+uint32_t s_diag_times_ms[kMaxDiagEventsPerMinute] = {};
+int s_diag_next                                   = 0;
+
+void push_diag_event(const char* kind, const char* extra)
+{
+    const uint32_t now_ms = static_cast<uint32_t>(esp_timer_get_time() / 1000);
+    std::lock_guard<std::mutex> lock(s_events_mutex);
+    if (s_events.size() >= 12) {
+        return;
+    }
+    uint32_t oldest = s_diag_times_ms[s_diag_next];
+    if (oldest != 0 && now_ms - oldest < 60000) {
+        return;
+    }
+    s_diag_times_ms[s_diag_next] = now_ms == 0 ? 1 : now_ms;
+    s_diag_next                  = (s_diag_next + 1) % kMaxDiagEventsPerMinute;
+    s_events.push_back({kind, now_ms, extra != nullptr ? extra : ""});
@@ -126,0 +150,5 @@ std::string json_escape(const std::string& input)
+void device_events_push_diag(const char* kind, const char* extra)
+{
+    push_diag_event(kind, extra);
+}
+
@@ -427 +455,7 @@ void Hal::xiaozhi_mcp_init()
-                                    result += fmt::format(R"({{"kind":"{}", "at_ms":{}}})", s_events[i].kind, s_events[i].at_ms);
+                                    if (s_events[i].extra.empty()) {
+                                        result += fmt::format(R"({{"kind":"{}", "at_ms":{}}})", s_events[i].kind,
+                                                              s_events[i].at_ms);
+                                    } else {
+                                        result += fmt::format(R"({{"kind":"{}", "at_ms":{}, {}}})", s_events[i].kind,
+                                                              s_events[i].at_ms, s_events[i].extra);
+                                    }
