+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * "Use this network now" (patch 154): self.wifi.use_now(index) makes the unit leave its current Wi-Fi and join one
+ * saved network, for a real away test without carrying the unit out of range of the home Wi-Fi. The choice is held in
+ * RAM only: while it lasts the Wi-Fi component sees only the chosen network, and the saved list in flash is never
+ * written (a restart, or the end of the hold, brings every saved network back, the home network included). If the hub
+ * is not reached on the new network within 3 minutes the unit goes back by itself and reports why.
+ */
+#pragma once
+
+// Registers self.wifi.use_now.
+void maipai_wifi_use_register_tools();
+
+// Ends a hold at once and gives every saved network back. The tools that add, forget or switch saved networks call
+// it first, so a hold can never be written to flash.
+void maipai_wifi_use_release();
