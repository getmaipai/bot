diff --git a/firmware/main/hal/maipai_wifi_use.cc b/firmware/main/hal/maipai_wifi_use.cc
new file mode 100644
index 0000000..e61b180
--- /dev/null
+++ b/firmware/main/hal/maipai_wifi_use.cc
@@ -0,0 +1,132 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+#include "maipai_wifi_use.h"
+#include "board/hal_bridge.h"
+#include "device_events.h"
+#include <mcp_server.h>
+#include <esp_log.h>
+#include <esp_timer.h>
+#include <esp_wifi.h>
+#include <ssid_manager.h>
+#include <cstdio>
+#include <mutex>
+#include <string>
+#include <vector>
+
+static const char* TAG = "MAIPAI-WIFIUSE";
+
+namespace {
+constexpr int64_t kRevertUs = 180LL * 1000 * 1000;  // the hub must be reached on the new network within 3 minutes
+constexpr int64_t kSwitchDelayUs = 1500LL * 1000;   // the answer leaves over the old network before the radio drops
+
+std::mutex s_lock;
+std::vector<SsidItem> s_saved;  // the full list, held while a network is pinned
+bool s_pinned           = false;
+int64_t s_deadline_us   = 0;
+int64_t s_switch_at_us  = 0;
+std::string s_target;
+esp_timer_handle_t s_timer = nullptr;
+
+// The in-memory list the Wi-Fi component scans against. Edited only here, never saved: SaveToNvs runs only inside
+// AddSsid, RemoveSsid, SetDefaultSsid and Clear, which this file never calls.
+std::vector<SsidItem>& list_ref()
+{
+    return const_cast<std::vector<SsidItem>&>(SsidManager::GetInstance().GetSsidList());
+}
+
+std::string current_ssid()
+{
+    wifi_ap_record_t ap;
+    if (esp_wifi_sta_get_ap_info(&ap) == ESP_OK) {
+        return std::string(reinterpret_cast<const char*>(ap.ssid));
+    }
+    return std::string();
+}
+
+void release_locked()
+{
+    if (!s_pinned) {
+        return;
+    }
+    list_ref() = s_saved;
+    s_saved.clear();
+    s_pinned       = false;
+    s_switch_at_us = 0;
+    ESP_LOGI(TAG, "all saved networks are back in use");
+}
+
+void tick(void*)
+{
+    std::lock_guard<std::mutex> lock(s_lock);
+    if (!s_pinned) {
+        return;
+    }
+    const int64_t now = esp_timer_get_time();
+    if (s_switch_at_us != 0 && now >= s_switch_at_us) {
+        s_switch_at_us = 0;
+        ESP_LOGI(TAG, "leaving the current network for the chosen one");
+        esp_wifi_disconnect();
+        return;
+    }
+    if (s_switch_at_us == 0 && current_ssid() == s_target && hal_bridge::hub_link_up()) {
+        ESP_LOGI(TAG, "hub reached on the chosen network: the hold ends");
+        device_events_push_diag("wifi_use_ok", "hub_reached");
+        release_locked();
+        esp_timer_stop(s_timer);
+        return;
+    }
+    if (now >= s_deadline_us) {
+        ESP_LOGW(TAG, "hub not reached on the chosen network in 3 minutes: going back");
+        device_events_push_diag("wifi_use_revert", "no_hub_3min");
+        release_locked();
+        esp_wifi_disconnect();  // the Wi-Fi component now scans every saved network again and joins the strongest
+        esp_timer_stop(s_timer);
+    }
+}
+}  // namespace
+
+void maipai_wifi_use_release()
+{
+    std::lock_guard<std::mutex> lock(s_lock);
+    release_locked();
+}
+
+void maipai_wifi_use_register_tools()
+{
+    McpServer::GetInstance().AddTool(
+        "self.wifi.use_now",
+        "Leave the current Wi-Fi and join one saved network (index from self.wifi.list_saved) now. Held in memory "
+        "only: the saved list in flash is not changed. If the hub is not reached on that network within 3 minutes the "
+        "unit goes back to the saved networks by itself (event wifi_use_revert). Answers JSON.",
+        PropertyList({Property("index", kPropertyTypeInteger, -1)}),
+        [](const PropertyList& properties) -> ReturnValue {
+            const int index = properties["index"].value<int>();
+            std::lock_guard<std::mutex> lock(s_lock);
+            release_locked();  // a new request starts from the full list
+            auto& list = list_ref();
+            if (index < 0 || static_cast<size_t>(index) >= list.size()) {
+                return std::string("{\"ok\":false,\"error\":\"no_such_network\"}");
+            }
+            const SsidItem chosen = list[index];
+            if (current_ssid() == chosen.ssid && hal_bridge::hub_link_up()) {
+                return std::string("{\"ok\":true,\"already\":true}");
+            }
+            s_saved = list;
+            list.assign(1, chosen);
+            s_target       = chosen.ssid;
+            s_pinned       = true;
+            s_deadline_us  = esp_timer_get_time() + kRevertUs;
+            s_switch_at_us = esp_timer_get_time() + kSwitchDelayUs;
+            if (s_timer == nullptr) {
+                esp_timer_create_args_t args = {};
+                args.callback                = tick;
+                args.name                    = "wifi_use";
+                esp_timer_create(&args, &s_timer);
+            }
+            esp_timer_stop(s_timer);
+            esp_timer_start_periodic(s_timer, 1000 * 1000);
+            ESP_LOGI(TAG, "use_now: switching in 1.5 s, back by itself after 3 minutes without the hub");
+            return std::string("{\"ok\":true,\"revert_in_s\":180}");
+        });
+}
diff --git a/firmware/main/hal/maipai_wifi_use.h b/firmware/main/hal/maipai_wifi_use.h
new file mode 100644
