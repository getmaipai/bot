+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The unit's own sounds (patches 115 to 119): one earcon family, the play_sound tool for the host, the
+ * firmware's own cues (charger, link, first setup) and the local offline phrases. Logic:
+ * maipai_sounds_core.h; the policy (on, night, mute, quiet hours) is kept in NVS namespace "mp_sounds".
+ */
+#pragma once
+
+// Loads the saved policy; call once after NVS is up (Hal::startXiaozhi).
+void maipai_sounds_init();
+// Call often (the 20 ms stackchan task): the setup cue repeat and the refused cue.
+void maipai_sounds_tick();
+// Registers self.audio.play_sound, self.audio.set_sound_policy and self.audio.sound_info.
+void maipai_sounds_register_tools();
+
+// Plays a shipped or new earcon by its fixed name through the policy gate. `urgent` lets the first-setup
+// cue through at night; `bypass` is the self-test (skips "off" and the night rule, never the mute).
+// Returns true when it was queued; otherwise `why` (if given) holds the reason word.
+bool maipai_sound_play(const char* name, bool urgent, bool bypass, const char** why);
+
+// The charger: call once a second with the AXP2101 facts. Plays plug_in, unplug or charged by day.
+void maipai_sounds_power_poll(bool external_power, bool charging);
+
+// The link to Home: DOWN when a connect fails or the socket drops, UP when it is open again, OFFLINE when
+// it has been down 10 s (the same moment the Offline words show), HELLO_FAILED when Home accepted the
+// connection and closed it before saying hello (a refusal).
+enum { MAIPAI_LINK_DOWN = 1, MAIPAI_LINK_UP = 2, MAIPAI_LINK_OFFLINE = 3, MAIPAI_LINK_HELLO_FAILED = 4 };
+void maipai_sounds_link_event(int event);
+
+// The unit entered Wi-Fi setup (first use, or no saved network): the needs_you cue, at night too.
+void maipai_sounds_setup_needed();
+
+// The wake word or a tap fired and there is no link: says the right local clip for the link state, or the
+// short tone when the limit is reached or it is night, or nothing when muted.
+void maipai_sounds_wake_offline();
+
+// The power key was pressed to shut down: the goodbye cue. Not called by anything in this release (the
+// power cut is the PMIC's and gives no warning); the power key work calls it.
+void maipai_sounds_goodbye();
+
+// The hard mute's hook. This file defines a weak version that returns false; the mute patch overrides it.
+bool maipai_mute_active();
