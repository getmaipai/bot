--- /dev/null
+++ b/firmware/main/hal/maipai_sounds.cc
@@ -0,0 +1,483 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The unit's own sounds, the device side (patch 116). See maipai_sounds.h.
+ */
+#include "maipai_sounds.h"
+#include "maipai_sounds_core.h"
+#include "device_events.h"
+#include "board/hal_bridge.h"
+#include <application.h>
+#include <assets.h>
+#include <assets/lang_config.h>
+#include <mcp_server.h>
+#include <esp_log.h>
+#include <esp_timer.h>
+#include <esp_wifi.h>
+#include <nvs.h>
+#include <nvs_flash.h>
+#include <cstdio>
+#include <ctime>
+#include <mutex>
+#include <string>
+#include <string_view>
+
+static const char* TAG = "MAIPAI-SOUNDS";
+static const char* kNamespace = "mp_sounds";  // our own: never the websocket namespace (pairing token, Wi-Fi)
+static const char* kKey       = "v1";
+
+// The seven new earcons are embedded in the app image (not the assets partition): the first-setup cue
+// must play before the assets are applied, and a file in the image cannot be missing at run time. The
+// recipe copies the .ogg files into main/assets/sfx and patch 116 adds them to EMBED_FILES.
+#define DECLARE_EARCON(n)                                                    \
+    extern const char snd_##n##_start[] asm("_binary_snd_" #n "_ogg_start"); \
+    extern const char snd_##n##_end[] asm("_binary_snd_" #n "_ogg_end");
+DECLARE_EARCON(needs_you)
+DECLARE_EARCON(plug_in)
+DECLARE_EARCON(charged)
+DECLARE_EARCON(unplug)
+DECLARE_EARCON(offline)
+DECLARE_EARCON(goodbye)
+DECLARE_EARCON(shutter)
+#define EARCON(n) std::string_view(snd_##n##_start, static_cast<size_t>(snd_##n##_end - snd_##n##_start))
+
+namespace {
+
+constexpr uint32_t kSetupRepeatMs = 60000;  // the first-setup cue repeats once a minute while the unit waits
+
+std::mutex s_mutex;
+ms_policy_t s_policy;
+ms_link_t s_link;
+ms_phrases_t s_phrases;
+bool s_loaded            = false;
+bool s_refused_announced = false;
+uint32_t s_last_setup_ms = 0;
+uint32_t s_plays_ok      = 0;
+uint32_t s_plays_refused = 0;
+uint32_t s_clips_played  = 0;
+uint32_t s_clips_missing = 0;
+
+uint32_t mono_ms()
+{
+    return static_cast<uint32_t>(esp_timer_get_time() / 1000);
+}
+
+// The unit's local minute of the day, or -1 while its clock has never been set.
+int minute_of_day()
+{
+    time_t t = time(nullptr);
+    if (t < 1700000000) {
+        return -1;
+    }
+    struct tm tm_local = {};
+    localtime_r(&t, &tm_local);
+    return tm_local.tm_hour * 60 + tm_local.tm_min;
+}
+
+bool wifi_up()
+{
+    wifi_ap_record_t ap = {};
+    return esp_wifi_sta_get_ap_info(&ap) == ESP_OK;
+}
+
+void save_policy_locked()
+{
+    uint8_t buf[8];
+    buf[0] = 1;  // version
+    buf[1] = s_policy.enabled;
+    buf[2] = s_policy.night_ok;
+    buf[3] = s_policy.muted;
+    buf[4] = static_cast<uint8_t>(s_policy.quiet_from & 0xFF);
+    buf[5] = static_cast<uint8_t>((s_policy.quiet_from >> 8) & 0xFF);
+    buf[6] = static_cast<uint8_t>(s_policy.quiet_to & 0xFF);
+    buf[7] = static_cast<uint8_t>((s_policy.quiet_to >> 8) & 0xFF);
+    nvs_handle_t h;
+    if (nvs_open(kNamespace, NVS_READWRITE, &h) != ESP_OK) {
+        ESP_LOGW(TAG, "could not save the sound policy");
+        return;
+    }
+    if (nvs_set_blob(h, kKey, buf, sizeof(buf)) != ESP_OK || nvs_commit(h) != ESP_OK) {
+        ESP_LOGW(TAG, "could not write the sound policy");
+    }
+    nvs_close(h);
+}
+
+void load_policy_locked()
+{
+    ms_policy_default(&s_policy);
+    nvs_handle_t h;
+    if (nvs_open(kNamespace, NVS_READONLY, &h) != ESP_OK) {
+        return;
+    }
+    uint8_t buf[8];
+    size_t n = sizeof(buf);
+    if (nvs_get_blob(h, kKey, buf, &n) == ESP_OK && n == sizeof(buf) && buf[0] == 1) {
+        s_policy.enabled    = buf[1] != 0;
+        s_policy.night_ok   = buf[2] != 0;
+        s_policy.muted      = buf[3] != 0;
+        s_policy.quiet_from = static_cast<int16_t>(buf[4] | (buf[5] << 8));
+        s_policy.quiet_to   = static_cast<int16_t>(buf[6] | (buf[7] << 8));
+    }
+    nvs_close(h);
+}
+
+std::string_view earcon_data(int snd)
+{
+    switch (snd) {
+        case MS_SND_NEEDS_YOU: return EARCON(needs_you);
+        case MS_SND_PLUG_IN: return EARCON(plug_in);
+        case MS_SND_CHARGED: return EARCON(charged);
+        case MS_SND_UNPLUG: return EARCON(unplug);
+        case MS_SND_OFFLINE: return EARCON(offline);
+        case MS_SND_GOODBYE: return EARCON(goodbye);
+        case MS_SND_SHUTTER: return EARCON(shutter);
+        case MS_SND_SUCCESS: return Lang::Sounds::OGG_SUCCESS;
+        case MS_SND_POPUP: return Lang::Sounds::OGG_POPUP;
+        case MS_SND_VIBRATION: return Lang::Sounds::OGG_VIBRATION;
+        case MS_SND_EXCLAMATION: return Lang::Sounds::OGG_EXCLAMATION;
+        case MS_SND_LOW_BATTERY: return Lang::Sounds::OGG_LOW_BATTERY;
+        default: return std::string_view();
+    }
+}
+
+// The policy as a copy, with whether it is night now (under the lock, the facts are read once).
+void snapshot(ms_policy_t* policy, bool* night)
+{
+    std::lock_guard<std::mutex> lock(s_mutex);
+    if (!s_loaded) {
+        load_policy_locked();
+        s_loaded = true;
+    }
+    *policy = s_policy;
+    *night  = ms_is_night(&s_policy, minute_of_day(), hal_bridge::hub_link_up()) != 0;
+}
+
+bool muted(const ms_policy_t& p)
+{
+    return p.muted != 0 || maipai_mute_active();
+}
+
+bool play_gated(int snd, bool urgent, bool bypass, const char** why)
+{
+    ms_policy_t policy;
+    bool night = false;
+    snapshot(&policy, &night);
+    if (maipai_mute_active()) {
+        policy.muted = 1;
+    }
+    ms_reason_t reason = ms_decide(&policy, snd, urgent, night, bypass);
+    if (reason != MS_OK) {
+        std::lock_guard<std::mutex> lock(s_mutex);
+        s_plays_refused++;
+        if (why != nullptr) {
+            *why = ms_reason_word(reason);
+        }
+        return false;
+    }
+    std::string_view data = earcon_data(snd);
+    if (data.empty()) {
+        if (why != nullptr) {
+            *why = "missing";
+        }
+        return false;
+    }
+    Application::GetInstance().PlaySound(data);
+    std::lock_guard<std::mutex> lock(s_mutex);
+    s_plays_ok++;
+    return true;
+}
+
+// Plays the asset file `name` (a phrase) from the assets partition. False when it is not there.
+bool play_asset(const char* name)
+{
+    void* ptr   = nullptr;
+    size_t size = 0;
+    if (!Assets::GetInstance().GetAssetData(name, ptr, size) || size < 64) {
+        return false;
+    }
+    Application::GetInstance().PlaySound(std::string_view(static_cast<const char*>(ptr), size));
+    return true;
+}
+
+// The link is back after an outage that sounded "offline": the success chime, and after a minute or more the
+// local "I'm back" clip. Day only (the gate and the night rule decide).
+void play_back(bool chime, bool clip)
+{
+    const uint32_t now = mono_ms();
+    if (chime) {
+        play_gated(MS_SND_SUCCESS, false, false, nullptr);
+    }
+    if (!clip) {
+        return;
+    }
+    ms_policy_t policy;
+    bool night = false;
+    snapshot(&policy, &night);
+    ms_phrase_t pick;
+    {
+        std::lock_guard<std::mutex> lock(s_mutex);
+        pick = ms_phrase_pick(&s_phrases, MS_LINK_UP, now, night && !policy.night_ok, muted(policy), MS_GRP_BACK);
+    }
+    if (pick.kind != MS_PH_CLIP) {
+        return;
+    }
+    char file[40];
+    const bool played = ms_phrase_file(file, sizeof(file), pick.group, pick.variant) && play_asset(file);
+    std::lock_guard<std::mutex> lock(s_mutex);
+    (played ? s_clips_played : s_clips_missing)++;
+}
+
+// Cues raised from another task (the 1 s power poll runs on the esp_timer task, the link events on the
+// websocket reconnect task, the tick on the 4 KB stackchan task) are played from the main task.
+void schedule_play(int snd, bool urgent)
+{
+    Application::GetInstance().Schedule([snd, urgent]() { play_gated(snd, urgent, false, nullptr); });
+}
+
+}  // namespace
+
+__attribute__((weak)) bool maipai_mute_active()
+{
+    return false;
+}
+
+void maipai_sounds_init()
+{
+    std::lock_guard<std::mutex> lock(s_mutex);
+    load_policy_locked();
+    s_loaded = true;
+    ms_link_init(&s_link);
+    ms_link_down(&s_link, mono_ms());  // booting: the link is not up until the first socket opens
+    ms_phrases_init(&s_phrases);
+    ESP_LOGI(TAG, "sound policy: enabled=%d night_ok=%d muted=%d quiet=%d..%d", s_policy.enabled, s_policy.night_ok,
+             s_policy.muted, s_policy.quiet_from, s_policy.quiet_to);
+}
+
+bool maipai_sound_play(const char* name, bool urgent, bool bypass, const char** why)
+{
+    int snd = ms_sound_from_name(name);
+    if (snd < 0) {
+        if (why != nullptr) {
+            *why = ms_reason_word(MS_NO_SUCH_SOUND);
+        }
+        return false;
+    }
+    return play_gated(snd, urgent, bypass, why);
+}
+
+void maipai_sounds_power_poll(bool external_power, bool charging)
+{
+    static ms_power_t power;
+    static bool started = false;
+    if (!started) {
+        ms_power_init(&power);
+        started = true;
+    }
+    switch (ms_power_update(&power, external_power ? 1 : 0, charging ? 1 : 0)) {
+        case MS_PWR_PLUG: schedule_play(MS_SND_PLUG_IN, false); break;
+        case MS_PWR_UNPLUG: schedule_play(MS_SND_UNPLUG, false); break;
+        case MS_PWR_FULL: schedule_play(MS_SND_CHARGED, false); break;
+        default: break;
+    }
+}
+
+void maipai_sounds_link_event(int event)
+{
+    const uint32_t now = mono_ms();
+    switch (event) {
+        case MAIPAI_LINK_DOWN: {
+            std::lock_guard<std::mutex> lock(s_mutex);
+            ms_link_down(&s_link, now);
+            return;
+        }
+        case MAIPAI_LINK_HELLO_FAILED: {
+            std::lock_guard<std::mutex> lock(s_mutex);
+            ms_link_hello_failed(&s_link);
+            return;
+        }
+        case MAIPAI_LINK_OFFLINE: {
+            {
+                std::lock_guard<std::mutex> lock(s_mutex);
+                ms_link_mark_offline(&s_link);
+            }
+            schedule_play(MS_SND_OFFLINE, false);
+            return;
+        }
+        case MAIPAI_LINK_UP: {
+            ms_link_return_t back;
+            {
+                std::lock_guard<std::mutex> lock(s_mutex);
+                back                = ms_link_up(&s_link, now);
+                s_refused_announced = false;
+            }
+            if (back.back_online || back.back_clip) {
+                Application::GetInstance().Schedule([back]() { play_back(back.back_online != 0, back.back_clip != 0); });
+            }
+            return;
+        }
+        default: return;
+    }
+}
+
+void maipai_sounds_setup_needed()
+{
+    s_last_setup_ms = mono_ms();
+    schedule_play(MS_SND_NEEDS_YOU, true);
+}
+
+void maipai_sounds_tick()
+{
+    static uint32_t last_check_ms = 0;
+    const uint32_t now            = mono_ms();
+    if (now - last_check_ms < 1000) {
+        return;
+    }
+    last_check_ms = now;
+    // First setup: the cue again once a minute while the unit still waits for Wi-Fi details.
+    if (Application::GetInstance().GetDeviceState() == kDeviceStateWifiConfiguring &&
+        now - s_last_setup_ms >= kSetupRepeatMs) {
+        maipai_sounds_setup_needed();
+    }
+    // Refused: the cue once when Home turns the unit away, day only; it re-arms when the link returns.
+    bool announce = false;
+    {
+        std::lock_guard<std::mutex> lock(s_mutex);
+        ms_link_state_t state = ms_link_state(&s_link, now, wifi_up(), hal_bridge::hub_link_up());
+        if (state == MS_LINK_REFUSED && !s_refused_announced) {
+            s_refused_announced = true;
+            announce            = true;
+        }
+    }
+    if (announce) {
+        schedule_play(MS_SND_NEEDS_YOU, false);
+    }
+}
+
+void maipai_sounds_wake_offline()
+{
+    const uint32_t now = mono_ms();
+    ms_policy_t policy;
+    bool night = false;
+    snapshot(&policy, &night);
+    const bool is_muted = muted(policy);
+    ms_phrase_t pick;
+    ms_link_state_t state;
+    {
+        std::lock_guard<std::mutex> lock(s_mutex);
+        state = ms_link_state(&s_link, now, wifi_up(), hal_bridge::hub_link_up());
+        // Sounds switched off also means no spoken clips; the short tone still answers the person.
+        const bool tone_only = (night && !policy.night_ok) || !policy.enabled;
+        pick                 = ms_phrase_pick(&s_phrases, state, now, tone_only, is_muted, -1);
+    }
+    if (pick.kind == MS_PH_CLIP) {
+        char file[40];
+        if (ms_phrase_file(file, sizeof(file), pick.group, pick.variant) && play_asset(file)) {
+            std::lock_guard<std::mutex> lock(s_mutex);
+            s_clips_played++;
+            ESP_LOGI(TAG, "offline phrase %s (link state %d)", file, static_cast<int>(state));
+            return;
+        }
+        {
+            std::lock_guard<std::mutex> lock(s_mutex);
+            s_clips_missing++;
+        }
+        ESP_LOGW(TAG, "offline phrase missing from the assets: group %d variant %d", pick.group, pick.variant);
+        pick.kind = MS_PH_TONE;
+    }
+    if (pick.kind == MS_PH_NONE && !is_muted) {
+        pick.kind = MS_PH_TONE;  // the link reads as up (a race with the reconnect): the person still gets the tone
+    }
+    if (pick.kind == MS_PH_TONE) {
+        Application::GetInstance().PlaySound(Lang::Sounds::OGG_VIBRATION);
+    }
+}
+
+void maipai_sounds_goodbye()
+{
+    play_gated(MS_SND_GOODBYE, false, false, nullptr);
+}
+
+void maipai_sounds_register_tools()
+{
+    auto& mcp = McpServer::GetInstance();
+    mcp.AddTool("self.audio.play_sound",
+                "Play one of the unit's own sounds by name: needs_you, plug_in, charged, unplug, offline, goodbye, "
+                "shutter, success, popup, vibration, exclamation, low_battery. It follows the volume, is refused at "
+                "night (except shutter, goodbye, low_battery, exclamation, popup, vibration, and needs_you with "
+                "urgent) and when muted or switched off. Set test to skip the off switch and the night rule (never "
+                "the mute). Answers {\"ok\":true} or {\"ok\":false,\"error\":\"muted|night|disabled|unknown_sound\"}.",
+                PropertyList({Property("name", kPropertyTypeString, std::string("")),
+                              Property("urgent", kPropertyTypeBoolean, false),
+                              Property("test", kPropertyTypeBoolean, false)}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    auto name       = properties["name"].value<std::string>();
+                    const char* why = "";
+                    if (maipai_sound_play(name.c_str(), properties["urgent"].value<bool>(),
+                                          properties["test"].value<bool>(), &why)) {
+                        return std::string("{\"ok\":true}");
+                    }
+                    return std::string("{\"ok\":false,\"error\":\"") + why + "\"}";
+                });
+    mcp.AddTool("self.audio.set_sound_policy",
+                "Set when the unit's own sounds may play. enabled: sounds on. night_ok: sounds also at night. muted: "
+                "the hard mute. dark: the host says it is night now (the light sensor); the unit trusts it only while "
+                "Home is connected. quiet_from and quiet_to: quiet hours as minutes of the unit's local day (0 to "
+                "1439, -1 for none; a window may wrap midnight). Saved in flash except dark.",
+                PropertyList({Property("enabled", kPropertyTypeBoolean, true),
+                              Property("night_ok", kPropertyTypeBoolean, false),
+                              Property("muted", kPropertyTypeBoolean, false),
+                              Property("dark", kPropertyTypeBoolean, false),
+                              Property("quiet_from", kPropertyTypeInteger, -1, -1, 1439),
+                              Property("quiet_to", kPropertyTypeInteger, -1, -1, 1439)}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    std::lock_guard<std::mutex> lock(s_mutex);
+                    ms_policy_t next = s_policy;
+                    next.enabled     = properties["enabled"].value<bool>() ? 1 : 0;
+                    next.night_ok    = properties["night_ok"].value<bool>() ? 1 : 0;
+                    next.muted       = properties["muted"].value<bool>() ? 1 : 0;
+                    next.dark        = properties["dark"].value<bool>() ? 1 : 0;
+                    next.quiet_from  = static_cast<int16_t>(properties["quiet_from"].value<int>());
+                    next.quiet_to    = static_cast<int16_t>(properties["quiet_to"].value<int>());
+                    const bool changed = next.enabled != s_policy.enabled || next.night_ok != s_policy.night_ok ||
+                                         next.muted != s_policy.muted || next.quiet_from != s_policy.quiet_from ||
+                                         next.quiet_to != s_policy.quiet_to;
+                    s_policy = next;
+                    s_loaded = true;
+                    if (changed) {
+                        save_policy_locked();  // only a real change touches the flash
+                    }
+                    return std::string("{\"ok\":true,\"changed\":") + (changed ? "true" : "false") + "}";
+                });
+    mcp.AddTool("self.audio.sound_info",
+                "The sound policy now, whether it is night for sounds, the link state the offline clips follow, how "
+                "many of the sixteen offline clips are in the assets, and the play counts since boot.",
+                PropertyList(), [](const PropertyList&) -> ReturnValue {
+                    int present = 0;
+                    char file[40];
+                    for (int g = 0; g < MS_GRP_COUNT; g++) {
+                        for (int v = 0; v < MS_GROUP_SIZE[g]; v++) {
+                            void* ptr   = nullptr;
+                            size_t size = 0;
+                            if (ms_phrase_file(file, sizeof(file), g, v) &&
+                                Assets::GetInstance().GetAssetData(file, ptr, size)) {
+                                present++;
+                            }
+                        }
+                    }
+                    ms_policy_t policy;
+                    bool night = false;
+                    snapshot(&policy, &night);
+                    std::lock_guard<std::mutex> lock(s_mutex);
+                    ms_link_state_t state = ms_link_state(&s_link, mono_ms(), wifi_up(), hal_bridge::hub_link_up());
+                    char out[320];
+                    snprintf(out, sizeof(out),
+                             "{\"enabled\":%d,\"night_ok\":%d,\"muted\":%d,\"mute_hook\":%d,\"quiet_from\":%d,"
+                             "\"quiet_to\":%d,\"night\":%s,\"link\":%d,\"clips_present\":%d,\"clips_total\":16,"
+                             "\"played\":%u,\"refused\":%u,\"clips_played\":%u,\"clips_missing\":%u}",
+                             policy.enabled, policy.night_ok, policy.muted, maipai_mute_active() ? 1 : 0,
+                             policy.quiet_from, policy.quiet_to, night ? "true" : "false", static_cast<int>(state),
+                             present, static_cast<unsigned>(s_plays_ok), static_cast<unsigned>(s_plays_refused),
+                             static_cast<unsigned>(s_clips_played), static_cast<unsigned>(s_clips_missing));
+                    return std::string(out);
+                });
+}
