+// The room's music features (patch 100, hal_music.cpp): one small event about once a second while
+// the room is loud. Dropped when the queue is half full, so a feature never pushes a touch out.
+void device_events_push_music(const char* extra)
+{
+    std::lock_guard<std::mutex> lock(s_events_mutex);
+    if (s_events.size() >= 8) {
+        return;
+    }
+    s_events.push_back({"music_feat", static_cast<uint32_t>(esp_timer_get_time() / 1000), extra});
