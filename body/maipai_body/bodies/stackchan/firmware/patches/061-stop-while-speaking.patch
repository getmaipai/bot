+// Counters for the touch path report (device_events_touch_stats).
+static uint32_t s_polls = 0, s_poll_fail = 0, s_poll_gap_max_ms = 0, s_last_poll_ms = 0;
+static uint32_t s_reads = 0, s_read_gap_max_ms = 0, s_last_read_ms = 0;
+
+void device_events_touch_note_poll(bool ok)
+{
+    const uint32_t now = static_cast<uint32_t>(esp_timer_get_time() / 1000);
+    if (s_last_poll_ms != 0 && now - s_last_poll_ms > s_poll_gap_max_ms) {
+        s_poll_gap_max_ms = now - s_last_poll_ms;
+    }
+    s_last_poll_ms = now;
+    s_polls++;
+    if (!ok) {
+        s_poll_fail++;
+    }
+}
+
+void device_events_touch_note_read()
+{
+    const uint32_t now = static_cast<uint32_t>(esp_timer_get_time() / 1000);
+    if (s_last_read_ms != 0 && now - s_last_read_ms > s_read_gap_max_ms) {
+        s_read_gap_max_ms = now - s_last_read_ms;
+    }
+    s_last_read_ms = now;
+    s_reads++;
+}
+
+void device_events_touch_stats(char* out, size_t size)
+{
+    snprintf(out, size, "\"polls\":%u,\"poll_fail\":%u,\"poll_gap_max_ms\":%u,\"reads\":%u,\"read_gap_max_ms\":%u",
+             static_cast<unsigned>(s_polls), static_cast<unsigned>(s_poll_fail),
+             static_cast<unsigned>(s_poll_gap_max_ms), static_cast<unsigned>(s_reads),
+             static_cast<unsigned>(s_read_gap_max_ms));
+    s_polls = s_poll_fail = s_poll_gap_max_ms = s_reads = s_read_gap_max_ms = 0;
+}
+
 static void lvgl_read_cb(lv_indev_t* indev, lv_indev_data_t* data)
