# Intent: free internal RAM so the stop word can run (host log 2026-10-21: the model costs 10,752 bytes of internal RAM and turned itself off against a 6 KB limit; the lowest free internal RAM seen was 12.5 KB). The opus codec task's 24 KB stack, the largest single internal allocation, moves to PSRAM (it never touches flash). The stop word's budget is now explicit in afe_wake_word.cc: the model may cost at most 12 KB, at least 34 KB must stay free after it is created (the free amount at start-up falls about 22 KB more before steady state, so this keeps the 12.5 KB floor), and arming needs 20 KB free. A once-a-minute memory report (internal free, minimum, largest block, PSRAM free and minimum) and a stack report (least stack left, in bytes, for the audio, websocket, stackchan and detection tasks) go to the serial log and the host log so the numbers can be checked.
# Upstream: 78/xiaozhi-esp32 main/audio/audio_service.cc, main/audio/wake_words/afe_wake_word.cc (MIT); m5stack/StackChan firmware/main/hal/hal_head_touch.cpp. Applies after 050 with --unidiff-zero.
# Check after a flash: the host log shows "unit memory: heap_stats ..." with int_free about 24 KB higher than before the patch (53 KB at boot, 23 KB steady before), "unit stop word: ... state=ready cost=10752 free=N" instead of state=off, and the playback lines ("lateness p95", "behind 0 times") no worse than before, since the opus task now runs with its stack in PSRAM.
diff --git a/firmware/main/hal/hal_head_touch.cpp b/firmware/main/hal/hal_head_touch.cpp
index f051ebe..d479399 100644
--- a/firmware/main/hal/hal_head_touch.cpp
+++ b/firmware/main/hal/hal_head_touch.cpp
@@ -8,6 +8,7 @@
 #include "board/hal_bridge.h"
 #include "device_events.h"
 #include <cstdio>
+#include <esp_heap_caps.h>
 #include <mooncake_log.h>
 #include <freertos/FreeRTOS.h>
 #include <freertos/task.h>
@@ -208,6 +209,29 @@ static void _head_touch_update_task(void* param)
                      static_cast<unsigned>(recognizer.presses));
             mclog::tagInfo(_tag, "minute: {}", extra);
             device_events_push_diag("head_touch_stats", extra);
+
+            // Memory report, once a minute, so the internal RAM budget can be tuned from the host log.
+            char mem[128];
+            snprintf(mem, sizeof(mem),
+                     "\"int_free\":%u,\"int_min\":%u,\"int_big\":%u,\"psram_free\":%u,\"psram_min\":%u",
+                     static_cast<unsigned>(heap_caps_get_free_size(MALLOC_CAP_INTERNAL)),
+                     static_cast<unsigned>(heap_caps_get_minimum_free_size(MALLOC_CAP_INTERNAL)),
+                     static_cast<unsigned>(heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL)),
+                     static_cast<unsigned>(heap_caps_get_free_size(MALLOC_CAP_SPIRAM)),
+                     static_cast<unsigned>(heap_caps_get_minimum_free_size(MALLOC_CAP_SPIRAM)));
+            mclog::tagInfo(_tag, "memory: {}", mem);
+            device_events_push_diag("heap_stats", mem);
+            // The least stack ever left free in the big tasks (bytes), to size or move stacks.
+            const char* names[] = {"opus_codec", "audio_input", "audio_output", "ws_reconnect", "stackchan",
+                                   "audio_detection"};
+            char stacks[160];
+            int used = 0;
+            for (const char* name : names) {
+                TaskHandle_t task = xTaskGetHandle(name);
+                int hwm = task != nullptr ? static_cast<int>(uxTaskGetStackHighWaterMark(task)) : -1;
+                used += snprintf(stacks + used, sizeof(stacks) - used, "%s\"%s\":%d", used == 0 ? "" : ",", name, hwm);
+            }
+            device_events_push_diag("stack_stats", stacks);
             stats_samples = stats_touched = stats_max = 0;
             recognizer.blips = recognizer.presses = 0;
             stats_start_ms = now_ms;
