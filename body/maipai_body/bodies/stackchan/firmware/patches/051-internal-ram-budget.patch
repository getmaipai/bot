-// much of it, and arming is refused below this much free.
-constexpr size_t kMaxModelInternalCost = 6 * 1024;
-constexpr size_t kArmMinFreeInternal = 16 * 1024;
+// The internal RAM budget (measured on the unit: the model costs 10,752 bytes; before patch 051 the
