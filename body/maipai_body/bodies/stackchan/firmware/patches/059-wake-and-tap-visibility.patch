+// Counters for the once-a-minute wake report (device_events_wake_stats): how many audio chunks the
+// detection task fetched, how many wake words it heard, and whether detection is armed right now.
+static std::atomic<uint32_t> s_fetches{0};
+static std::atomic<uint32_t> s_fetch_errors{0};
+static std::atomic<uint32_t> s_detections{0};
+static std::atomic<uint32_t> s_last_fetch_ms{0};
+static EventGroupHandle_t s_wake_event_group = nullptr;
+
+void device_events_wake_stats(char* out, size_t size)
+{
+    const uint32_t now_ms = static_cast<uint32_t>(esp_timer_get_time() / 1000);
+    const uint32_t last   = s_last_fetch_ms.load();
+    const bool armed      = s_wake_event_group != nullptr && (xEventGroupGetBits(s_wake_event_group) & DETECTION_RUNNING_EVENT);
+    snprintf(out, size, "\"armed\":%d,\"fetches\":%u,\"fetch_errors\":%u,\"detections\":%u,\"ms_since_fetch\":%d",
+             armed ? 1 : 0, static_cast<unsigned>(s_fetches.exchange(0)),
+             static_cast<unsigned>(s_fetch_errors.exchange(0)), static_cast<unsigned>(s_detections.exchange(0)),
+             last == 0 ? -1 : static_cast<int>(now_ms - last));
+}
+
