 #include <hal/board/hal_bridge.h>
 #include <esp_timer.h>
 #include <esp_log.h>
@@ -940,8 +941,8 @@ void Application::HandleStopListeningEvent() {
 }
 
 void Application::HandleWakeWordDetectedEvent() {
-    if (!protocol_) {
-        return;
+    if (!protocol_ || maipai_mic_blocked()) {
+        return;  // a wake word that arrives after the mute is dropped (patch 107)
     }
 
     auto state = GetDeviceState();
@@ -1162,6 +1163,16 @@ void Application::AbortSpeaking(AbortReason reason) {
 }
 
 void Application::SetListeningMode(ListeningMode mode) {
+    if (maipai_mic_blocked()) {
+        // Muted or in full quiet (patch 107): every way into listening ends here. The unit goes back to idle
+        // (it may have been set to connecting on the way) and the host is told why nothing happened.
+        ESP_LOGW(TAG, "listening refused: muted or in full quiet");
+        device_events_push_diag("tap", "\"decision\":\"ignored\",\"why\":\"muted\"");
+        if (GetDeviceState() != kDeviceStateIdle) {
+            SetDeviceState(kDeviceStateIdle);
+        }
+        return;
+    }
     listening_mode_ = mode;
     SetDeviceState(kDeviceStateListening);
 }
