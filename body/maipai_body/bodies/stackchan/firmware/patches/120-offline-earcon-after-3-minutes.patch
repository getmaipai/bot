# Intent: the offline earcon and the "I'm back" chime are for a real outage, not for every Home restart (owner 2026-11-13: "omg this beeping is annoying" while other sessions installed a new Home every few minutes). The offline words and strip still show at 10 s (patch 112); the earcon waits for 3 minutes of the link being down, and the success chime on return only follows an earcon that sounded. A restart of 30 to 60 s is silent.
# Upstream: xiaozhi-esp32 main/protocols/websocket_protocol.cc (MIT). Applies after 119.
# Check after a flash: stop the hub for 30 s: the Offline strip, no sound at all, nothing on return; stop it for 4 minutes: the offline earcon at 3 minutes, the success chime on return.
diff --git a/firmware/xiaozhi-esp32/main/protocols/websocket_protocol.cc b/firmware/xiaozhi-esp32/main/protocols/websocket_protocol.cc
--- a/firmware/xiaozhi-esp32/main/protocols/websocket_protocol.cc
+++ b/firmware/xiaozhi-esp32/main/protocols/websocket_protocol.cc
@@ -340,6 +340,8 @@
     unsigned attempt = 0;
     int64_t down_since_us = esp_timer_get_time();
     bool offline_shown = false;
+    bool offline_sound_sent = false;  // the offline earcon is for a real outage, not a Home restart (patch 120)
+    constexpr int64_t kOfflineSoundAfterUs = 3LL * 60 * 1000 * 1000;
     maipai_sounds_link_event(MAIPAI_LINK_DOWN);  // booting: not connected until the first socket opens
     bool connecting_shown = false;
     bool refused_shown = false;
@@ -356,7 +358,8 @@
             const unsigned took_ms = static_cast<unsigned>((esp_timer_get_time() - started_us) / 1000);
             attempt = 0;
             hal_bridge::set_hub_link(true);
-            maipai_sounds_link_event(MAIPAI_LINK_UP);  // after an outage over 10 s: the success chime
+            maipai_sounds_link_event(MAIPAI_LINK_UP);  // after an outage that sounded: the success chime
+            offline_sound_sent = false;
             if (offline_shown || connecting_shown || refused_shown) {
                 offline_shown    = false;
                 connecting_shown = false;
@@ -424,13 +427,16 @@
         const int64_t down_us = esp_timer_get_time() - down_since_us;
         if (!offline_shown && down_us >= kOfflineIndicatorAfterUs) {
             offline_shown = true;
-            maipai_sounds_link_event(MAIPAI_LINK_OFFLINE);  // the offline earcon, once per outage
             hal_bridge::leds_offline(!refused_shown);
             hal_bridge::hub_link_set(true, true, refused_shown);
         } else if (!connecting_shown && !offline_shown && down_us >= kConnectingStripAfterUs) {
             connecting_shown = true;
             hal_bridge::hub_link_set(true, false, refused_shown);
         }
+        if (!offline_sound_sent && down_us >= kOfflineSoundAfterUs) {
+            offline_sound_sent = true;
+            maipai_sounds_link_event(MAIPAI_LINK_OFFLINE);  // the offline earcon, once per outage over 3 minutes
+        }
         uint32_t jitter_ms = esp_random() % (delay_ms / 4 + 1);
         uint32_t wait_ms = std::min(kMaximumDelayMs, delay_ms + jitter_ms);
         EventBits_t bits = xEventGroupWaitBits(self->event_group_handle_, WEBSOCKET_PROTOCOL_STOP_EVENT, pdTRUE, pdFALSE, pdMS_TO_TICKS(wait_ms));
