+void StackChanAvatarDisplay::ShowLinkStrip(LinkLook look)
+{
+    if (link_strip_ == nullptr) {
+        return;
+    }
+    LoadLinkIcons();
+    // A short note (a tap that found no Home) replaces the standing words for a moment.
+    std::string text = link_note_;
+    if (text.empty()) {
+        text = look == LinkLook::Offline ? "Offline" : (look == LinkLook::Approval ? "Waiting for Home to approve me" : "");
+    }
+    if (strcmp(lv_label_get_text(strip_label_), text.c_str()) != 0) {
+        lv_label_set_text(strip_label_, text.c_str());
+    }
+    if (text.empty()) {
+        lv_obj_add_flag(strip_label_, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_obj_remove_flag(strip_label_, LV_OBJ_FLAG_HIDDEN);
+    }
+    if (look == LinkLook::Approval) {
+        lv_obj_remove_flag(strip_key_, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_obj_add_flag(strip_key_, LV_OBJ_FLAG_HIDDEN);
+    }
+    if (strip_look_ != look) {
+        strip_look_ = look;
+        link_t0_    = GetHAL().millis();
+    }
+    SetLinkGlyph(strip_glyph_, look == LinkLook::Connecting, true);
+    lv_obj_remove_flag(link_strip_, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_move_foreground(link_strip_);
+}
