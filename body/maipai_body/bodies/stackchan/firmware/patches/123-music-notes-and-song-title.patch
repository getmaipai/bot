+void StackChanAvatarDisplay::EnsureMusicOverlays()
+{
+    if (music_overlays_ready_) return;
+    auto* mint = dynamic_cast<MintAvatar*>(&GetStackChan().avatar());
+    if (mint == nullptr || mint->getPanel() == nullptr) return;
+    music_overlays_ready_ = true;
+    auto* panel = mint->getPanel()->get();
+    static constexpr int anchors[8][2] = {{35, 42}, {145, 38}, {285, 48}, {35, 132},
+                                           {285, 132}, {40, 190}, {145, 194}, {280, 190}};
+    for (int i = 0; i < 3; ++i) {
+        if (music_notes_[i] != nullptr) continue;
+        music_notes_[i] = lv_obj_create(panel);
+        lv_obj_remove_style_all(music_notes_[i]);
+        lv_obj_remove_flag(music_notes_[i], static_cast<lv_obj_flag_t>(LV_OBJ_FLAG_SCROLLABLE | LV_OBJ_FLAG_CLICKABLE));
+        lv_obj_set_size(music_notes_[i], 12, 26);
+        lv_obj_set_pos(music_notes_[i], anchors[i][0], anchors[i][1]);
+        lv_obj_t* head = lv_obj_create(music_notes_[i]);
+        lv_obj_remove_style_all(head);
+        lv_obj_remove_flag(head, LV_OBJ_FLAG_SCROLLABLE);
+        lv_obj_remove_flag(head, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_set_size(head, 10, 8);
+        lv_obj_set_pos(head, 0, 18);
+        lv_obj_set_style_radius(head, LV_RADIUS_CIRCLE, 0);
+        lv_obj_set_style_bg_opa(head, LV_OPA_COVER, 0);
+        lv_obj_set_style_bg_color(head, MintAvatar::inkColor(), 0);
+        lv_obj_t* stem = lv_obj_create(music_notes_[i]);
+        lv_obj_remove_style_all(stem);
+        lv_obj_remove_flag(stem, static_cast<lv_obj_flag_t>(LV_OBJ_FLAG_SCROLLABLE | LV_OBJ_FLAG_CLICKABLE));
+        lv_obj_set_size(stem, 2, 20);
+        lv_obj_set_pos(stem, 8, 0);
+        lv_obj_set_style_bg_opa(stem, LV_OPA_COVER, 0);
+        lv_obj_set_style_bg_color(stem, MintAvatar::inkColor(), 0);
+        lv_obj_add_flag(music_notes_[i], LV_OBJ_FLAG_HIDDEN);
+    }
+    if (song_title_ == nullptr) {
+        song_title_ = lv_label_create(panel);
+        lv_obj_remove_style_all(song_title_);
+        lv_obj_remove_flag(song_title_, static_cast<lv_obj_flag_t>(LV_OBJ_FLAG_SCROLLABLE | LV_OBJ_FLAG_CLICKABLE));
+        lv_obj_set_width(song_title_, 240);
+        lv_obj_set_style_text_font(song_title_, &lv_font_montserrat_14, 0);
+        lv_obj_set_style_text_color(song_title_, MintAvatar::inkColor(), 0);
+        lv_obj_set_style_text_align(song_title_, LV_TEXT_ALIGN_CENTER, 0);
+        lv_label_set_long_mode(song_title_, LV_LABEL_LONG_DOT);
+        lv_obj_align(song_title_, LV_ALIGN_BOTTOM_MID, 0, -20);
+        lv_obj_add_flag(song_title_, LV_OBJ_FLAG_HIDDEN);
+    }
 }
 
+void StackChanAvatarDisplay::UpdateMusicOverlays()
+{
+    const bool suppressed = quiet_face_ || (privacy_bits_ & kPrivMute) != 0 ||
+                            link_look_ != LinkLook::None || strip_look_ != LinkLook::None;
+    for (int i = 0; i < 3; ++i) {
+        if (music_notes_[i] != nullptr) {
+            if (!suppressed && i < music_note_count_) lv_obj_remove_flag(music_notes_[i], LV_OBJ_FLAG_HIDDEN);
+            else lv_obj_add_flag(music_notes_[i], LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+    if (song_title_ != nullptr) {
+        if (!suppressed && song_title_deadline_ != 0) {
+            lv_obj_remove_flag(song_title_, LV_OBJ_FLAG_HIDDEN);
+            lv_obj_move_foreground(song_title_);
+        }
+        else lv_obj_add_flag(song_title_, LV_OBJ_FLAG_HIDDEN);
+    }
+}
+
+void StackChanAvatarDisplay::AdvanceMusicNotes()
+{
+    static constexpr int anchors[8][2] = {{35, 42}, {145, 38}, {285, 48}, {35, 132},
+                                           {285, 132}, {40, 190}, {145, 194}, {280, 190}};
+    for (int i = 0; i < music_note_count_; ++i) {
+        const int previous = music_anchor_[i];
+        int next = (previous + 1 + i * 2) % 8;
+        for (int tries = 0; tries < 8; ++tries) {
+            bool occupied = next == previous;
+            for (int j = 0; j < music_note_count_; ++j) {
+                if (j != i && music_anchor_[j] == next) occupied = true;
+            }
+            if (!occupied) break;
+            next = (next + 1) % 8;
+        }
+        music_anchor_[i] = next;
+        if (music_notes_[i] != nullptr) lv_obj_set_pos(music_notes_[i], anchors[next][0], anchors[next][1]);
+    }
+}
+
+void StackChanAvatarDisplay::SetMusicNotes(int count)
+{
+    DisplayLockGuard lock(this);
+    music_note_count_ = std::clamp(count, 0, 3);
+    if (music_note_count_ == 0) {
+        music_note_deadline_ = 0;
+        if (music_timer_ != nullptr) { lv_timer_delete(music_timer_); music_timer_ = nullptr; }
+        if (music_expiry_timer_ != nullptr) { lv_timer_delete(music_expiry_timer_); music_expiry_timer_ = nullptr; }
+    } else {
+        EnsureMusicOverlays();
+        AdvanceMusicNotes();
+        music_note_deadline_ = GetHAL().millis() + 30000;
+        if (music_timer_ == nullptr) music_timer_ = lv_timer_create([](lv_timer_t* timer) {
+            auto* display = static_cast<StackChanAvatarDisplay*>(lv_timer_get_user_data(timer));
+            display->AdvanceMusicNotes();
+            display->UpdateMusicOverlays();
+        }, 500, this);
+        if (music_expiry_timer_ != nullptr) {
+            lv_timer_delete(music_expiry_timer_);
+            music_expiry_timer_ = nullptr;
+        }
+        music_expiry_timer_ = lv_timer_create([](lv_timer_t* timer) {
+            auto* display = static_cast<StackChanAvatarDisplay*>(lv_timer_get_user_data(timer));
+            display->music_note_count_ = 0;
+            display->music_note_deadline_ = 0;
+            display->UpdateMusicOverlays();
+            display->music_expiry_timer_ = nullptr;
+            if (display->music_timer_ != nullptr) {
+                lv_timer_delete(display->music_timer_);
+                display->music_timer_ = nullptr;
+            }
+            lv_timer_delete(timer);
+        }, 30000, this);
+    }
+    UpdateMusicOverlays();
+}
+
+void StackChanAvatarDisplay::SetSongTitle(const char* text)
+{
+    DisplayLockGuard lock(this);
+    EnsureMusicOverlays();
+    if (song_title_ == nullptr) return;
+    const std::string title = text != nullptr ? text : "";
+    if (title.size() > 80) return;
+    if (title.empty()) {
+        lv_label_set_text(song_title_, "");
+        song_title_text_.clear();
+        song_title_deadline_ = 0;
+        if (song_title_timer_ != nullptr) { lv_timer_delete(song_title_timer_); song_title_timer_ = nullptr; }
+    } else {
+        std::string short_title = title.substr(0, 28);
+        if (title.size() > 28) short_title = title.substr(0, 25) + "...";
+        song_title_text_ = short_title;
+        lv_label_set_text(song_title_, short_title.c_str());
+        song_title_deadline_ = GetHAL().millis() + 60000;
+        if (song_title_timer_ != nullptr) {
+            lv_timer_delete(song_title_timer_);
+            song_title_timer_ = nullptr;
+        }
+        song_title_timer_ = lv_timer_create([](lv_timer_t* timer) {
+            auto* display = static_cast<StackChanAvatarDisplay*>(lv_timer_get_user_data(timer));
+            display->song_title_deadline_ = 0;
+            if (display->song_title_ != nullptr) lv_label_set_text(display->song_title_, "");
+            display->song_title_text_.clear();
+            display->UpdateMusicOverlays();
+            lv_timer_delete(timer);
+            display->song_title_timer_ = nullptr;
+        }, 60000, this);
+    }
+    UpdateMusicOverlays();
+}
