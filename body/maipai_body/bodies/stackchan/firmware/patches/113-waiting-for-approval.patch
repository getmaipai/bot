--- a/firmware/xiaozhi-esp32/main/protocols/websocket_protocol.cc
+++ b/firmware/xiaozhi-esp32/main/protocols/websocket_protocol.cc
@@ -288,13 +288,19 @@ bool WebsocketProtocol::ConnectAudioChannel() {
     }
 
     // Wait for server hello
-    EventBits_t bits = xEventGroupWaitBits(event_group_handle_, WEBSOCKET_PROTOCOL_SERVER_HELLO_EVENT, pdTRUE, pdFALSE, pdMS_TO_TICKS(10000));
+    EventBits_t bits = xEventGroupWaitBits(event_group_handle_, WEBSOCKET_PROTOCOL_SERVER_HELLO_EVENT | WEBSOCKET_PROTOCOL_DISCONNECTED_EVENT, pdTRUE, pdFALSE, pdMS_TO_TICKS(10000));
     if (!(bits & WEBSOCKET_PROTOCOL_SERVER_HELLO_EVENT)) {
-        ESP_LOGE(TAG, "Failed to receive server hello");
+        // Accepted, then closed before the hub's hello: how Home turns away a unit it has not approved (it
+        // closes with code 1008 and a reason; the websocket class does not hand the code to us). Two in a row
+        // read as "waiting for approval"; a hub that is just restarting does not accept the handshake at all.
+        refused_streak_ = (bits & WEBSOCKET_PROTOCOL_DISCONNECTED_EVENT) != 0 ? refused_streak_ + 1 : 0;
+        ESP_LOGE(TAG, "Failed to receive server hello (closed by the hub: %d, in a row: %d)",
+                 (bits & WEBSOCKET_PROTOCOL_DISCONNECTED_EVENT) != 0 ? 1 : 0, refused_streak_);
         SetError(Lang::Strings::SERVER_TIMEOUT);
         return false;
     }
 
+    refused_streak_ = 0;
 #if CONFIG_STACKCHAN_PERSISTENT_WEBSOCKET
     xEventGroupSetBits(event_group_handle_, WEBSOCKET_PROTOCOL_CONNECTED_EVENT);
 #else
@@ -329,6 +335,7 @@ void WebsocketProtocol::ReconnectTask(void* arg) {
     int64_t down_since_us = esp_timer_get_time();
     bool offline_shown = false;
     bool connecting_shown = false;
+    bool refused_shown = false;
     constexpr int64_t kConnectingStripAfterUs = 3LL * 1000 * 1000;  // reconnects are constant: a blip shows nothing
 
     while (!(xEventGroupGetBits(self->event_group_handle_) & WEBSOCKET_PROTOCOL_STOP_EVENT)) {
@@ -342,9 +349,10 @@ void WebsocketProtocol::ReconnectTask(void* arg) {
             const unsigned took_ms = static_cast<unsigned>((esp_timer_get_time() - started_us) / 1000);
             attempt = 0;
