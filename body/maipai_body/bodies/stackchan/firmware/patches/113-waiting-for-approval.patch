                 connecting_shown = false;
+                refused_shown    = false;
                 hal_bridge::leds_offline(false);
                 hal_bridge::hub_link_set(false, false, false);
             }
@@ -393,14 +401,24 @@ void WebsocketProtocol::ReconnectTask(void* arg) {
         if (xEventGroupGetBits(self->event_group_handle_) & WEBSOCKET_PROTOCOL_STOP_EVENT) {
