+        const bool refused = self->refused_streak_ >= 2;
+        if (refused != refused_shown) {
+            refused_shown = refused;
+            // Cyan blinks for approval, so the steady amber steps aside while it shows.
+            hal_bridge::leds_offline(offline_shown && !refused_shown);
+            hal_bridge::hub_link_set(connecting_shown || offline_shown, offline_shown, refused_shown);
+            if (refused_shown) {
+                push_link_event("ws_refused", attempt, self->last_connect_error_, 0, 0);
+            }
+        }
