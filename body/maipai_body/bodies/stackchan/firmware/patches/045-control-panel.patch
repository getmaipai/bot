@@ -0,0 +1,8 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+
+// The person moved the volume or brightness on the unit itself. Queues one level_changed event
+// for the host (a pending one is replaced, so a run of drags never fills the queue).
+void device_events_push_level(int volume, int brightness);
diff --git a/firmware/main/hal/hal_mcp.cpp b/firmware/main/hal/hal_mcp.cpp
index 362a01e..58fdf89 100644
--- a/firmware/main/hal/hal_mcp.cpp
+++ b/firmware/main/hal/hal_mcp.cpp
@@ -19,0 +20,2 @@
+#include "device_events.h"
+#include <string_view>
@@ -53,0 +56,2 @@ struct DeviceEvent {
+    int volume     = -1;  // level_changed only
+    int brightness = -1;
@@ -67,0 +72,15 @@ void push_event(const char* kind)
+void push_level_event(int volume, int brightness)
+{
+    std::lock_guard<std::mutex> lock(s_events_mutex);
+    for (auto it = s_events.begin(); it != s_events.end(); ++it) {
+        if (std::string_view(it->kind) == "level_changed") {
+            s_events.erase(it);
+            break;
+        }
+    }
+    if (s_events.size() >= 16) {
+        s_events.pop_front();
+    }
+    s_events.push_back({"level_changed", static_cast<uint32_t>(esp_timer_get_time() / 1000), volume, brightness});
+}
+
@@ -126,0 +146,5 @@ std::string json_escape(const std::string& input)
+void device_events_push_level(int volume, int brightness)
+{
+    push_level_event(volume, brightness);
+}
